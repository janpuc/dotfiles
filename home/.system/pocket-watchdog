#!/usr/bin/env python3
"""pocket-watchdog: keep Pi Pocket's sessions on aether working when a provider runs out of quota.

Pi Pocket waits for a provider's usage limit for up to six hours and then gives that run up
("Not waiting: it did not clear in 6 h"), which leaves the session failed. It has no model
fallback of its own, so a quota that ran out on Friday left three sessions dead until Monday.

This runs every fifteen minutes and, for each session it is configured for:
  - reads the state: idle, working or failed, the last error, a wait for a provider's limit, the
    last activity and the model the session runs on,
  - moves a session that ran out of quota (a failure with a limit error, or a wait for one that
    lasts over half an hour) to the next model of its chain, and tells the agent what happened,
  - moves a session that has been on a fallback for half a day back to its primary model,
  - pages Jan through Alertmanager when no model is left, when a session hangs, or when a session
    fails for another reason,
  - starts a new context for a background session that sits idle on a large one: every call
    re-reads the whole context, and in the week to 2026-11-04 two sessions spent over a billion
    tokens that way. The handoff note names the session's state file, which carries what it
    must remember,
  - keeps each background session's instructions as the repo's file has them, and
  - runs the scheduled passes of the background sessions in place of Pi Pocket's own schedules:
    at the configured hours it checks in plain code whether there is anything to do (open PRs that
    changed, new upstream commits, a Home Assistant config that moved, a Prometheus finding) and
    messages the session only then, with what changed.

It is plain code, with no model in it. The sessions and their chains are in the config file
(/etc/pocket-watchdog/config.json), not in this script. A run that cannot read Pi Pocket or the
config changes nothing and exits non-zero.
"""
import argparse
import datetime
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
import zoneinfo

DEFAULT_CONFIG = "/etc/pocket-watchdog/config.json"
DEFAULT_STATE = "/var/lib/pocket-watchdog/state.json"

MINUTE = 60_000
HOUR = 60 * MINUTE

# A wait for a provider's limit that lasts this long needs another model, not more patience,
# when Pi Pocket does not know when the limit resets.
LIMIT_WAIT = 30 * MINUTE
# A limit that resets sooner than this is waited out: the next model may be a metered API, and a
# 5-hour window that clears within the hour is not worth hours on it.
NEAR_RESET = 2 * HOUR
# A fallback is this old before an idle session goes back to its primary model.
FALLBACK_BACK = 12 * HOUR
# The limit failures that count as the chain being spent.
CHAIN_SPENT = 12 * HOUR
# A working session with no news for this long is stuck.
STUCK = 2 * HOUR
# A failure that is not a limit waits this long before it pages Jan.
FAILED = 30 * MINUTE
# How long an alert lives when no run posts it again.
ALERT_LIFE = 45 * MINUTE
# A context above this many tokens is started fresh once the session is idle (resetAboveTokens).
RESET_ABOVE = 30_000
# A session is idle this long before its context is reset, so a conversation with Jan keeps its
# thread; a dispatched pass resets at once (resetIdleMinutes).
RESET_IDLE = 30 * MINUTE
# A finding the cluster scan was told about is told again after a week, if it is still there.
FINDING_AGAIN = 7 * 24 * HOUR
# How long one check of a scheduled pass may take (pr-lane reads every open PR).
GATE_TIMEOUT = 300
ZONE = zoneinfo.ZoneInfo("Europe/Warsaw")

# The words Pi Pocket itself uses for a limit it waited on (src/server/limit-gate.ts): the gate's
# reason ("ChatGPT's usage limit") and its refusal ("Not waiting: it did not clear in 6 h.").
LIMIT_WORDS = re.compile(
    r"usage limit|usage_limit|monthly usage|weekly usage|quota|rate limit|rate_limit"
    r"|too many requests|overloaded|not waiting:",
    re.IGNORECASE,
)

# The names a phone reads best: the provider ids Pi Pocket uses, in words.
PROVIDER_NAMES = {
    "anthropic": "Claude",
    "openai": "OpenAI",
    "openai-codex": "ChatGPT",
    "opencode-go": "OpenCode Go",
    "minimax": "MiniMax",
    "m3pro": "the M3 Pro",
}

TIMEOUT = 20


class WatchdogError(Exception):
    """Something the watchdog cannot do: the run fails and no session is changed."""


class GateError(Exception):
    """A pass's check that could not run: the pass is sent whole, as the schedule would have."""

    def __init__(self, message, status=None):
        super().__init__(message)
        self.status = status


class Link:
    """One link of a session's chain: the model, and the thinking level it runs with."""

    def __init__(self, provider, model_id, thinking):
        self.provider = provider
        self.model_id = model_id
        self.thinking = thinking

    @property
    def key(self):
        return f"{self.provider}/{self.model_id}"

    def __str__(self):
        return f"{self.key}:{self.thinking}"


def parse_link(text):
    """A chain link, "provider/modelId:thinking". Pi Pocket splits the id at the first slash."""
    if not isinstance(text, str) or text.strip() == "":
        raise WatchdogError(f"a chain link is not text: {text!r}")

    raw = text.strip()
    body, _, thinking = raw.rpartition(":")
    if body == "":
        body, thinking = raw, "off"
    provider, slash, model_id = body.partition("/")
    if slash == "" or provider == "" or model_id == "":
        raise WatchdogError(f"the chain link {raw!r} is not provider/modelId:thinking")

    return Link(provider, model_id, thinking or "off")


def provider_name(provider):
    """The provider as a sentence reads it: "MiniMax", not "minimax"."""
    if provider is None:
        return "the provider"

    return PROVIDER_NAMES.get(provider, provider)


def is_limit_error(text):
    """Whether an error is a provider's limit, the words Pi Pocket's limit gate writes."""
    return bool(text) and LIMIT_WORDS.search(str(text)) is not None


class Pocket:
    """Pi Pocket's HTTP API: the owner's token, and never a word of it in a log."""

    def __init__(self, base_url, token, timeout=TIMEOUT):
        self.base = base_url.rstrip("/")
        self.token = token
        self.timeout = timeout

    def _request(self, method, path, body=None):
        headers = {"Authorization": f"Bearer {self.token}", "X-Pocket": "1"}
        data = None
        if body is not None:
            data = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        request = urllib.request.Request(f"{self.base}{path}", data=data, method=method, headers=headers)
        try:
            with urllib.request.urlopen(request, timeout=self.timeout) as response:
                text = response.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as error:
            detail = error.read().decode("utf-8", "replace").replace("\n", " ")[:200]
            raise WatchdogError(f"{method} {path}: Pi Pocket answered HTTP {error.code}: {detail}") from None
        except (urllib.error.URLError, OSError) as error:
            raise WatchdogError(f"{method} {path}: Pi Pocket is not reachable: {error}") from None
        try:
            return json.loads(text) if text.strip() != "" else {}
        except json.JSONDecodeError:
            raise WatchdogError(f"{method} {path}: Pi Pocket answered something that is not JSON") from None

    def get(self, path):
        return self._request("GET", path)

    def post(self, path, body):
        return self._request("POST", path, body)

    def models(self):
        """The models Pi Pocket knows and can run: the ones with a sign-in that works."""
        me = self.get("/api/me")
        models = me.get("models") if isinstance(me, dict) else None
        if not isinstance(models, list):
            raise WatchdogError("/api/me: Pi Pocket answered without a model list")
        known = set()
        for model in models:
            if isinstance(model, dict) and isinstance(model.get("provider"), str) and isinstance(model.get("id"), str):
                known.add(f"{model['provider']}/{model['id']}")
        return known

    def sessions(self):
        """Every session Pi Pocket knows, with its state."""
        sessions = self.get("/api/sessions")
        if not isinstance(sessions, list):
            raise WatchdogError("/api/sessions: Pi Pocket answered without a session list")
        return {int(s["id"]): s for s in sessions if isinstance(s, dict) and isinstance(s.get("id"), int)}

    def view(self, conversation_id):
        """One session's view: its model, its live run and the entries it shows."""
        poll = self.get(f"/api/poll?c={conversation_id}&p=5")
        events = poll.get("events") if isinstance(poll, dict) else None
        if not isinstance(events, list):
            raise WatchdogError(f"/api/poll?c={conversation_id}: Pi Pocket answered without events")
        view = None
        for event in events:
            if not isinstance(event, dict):
                continue
            if event.get("event") == "view" and isinstance(event.get("data"), dict) and event["data"].get("full"):
                view = event["data"]
        if view is None:
            raise WatchdogError(f"/api/poll?c={conversation_id}: Pi Pocket answered without a view")
        session = poll.get("session")
        if isinstance(session, str) and session != "":
            # The poller is closed again, so the session list does not keep a tab for it.
            try:
                self.get(f"/api/poll?session={urllib.parse.quote(session)}&close=1")
            except WatchdogError:
                pass
        return view


def load_config(path):
    """The config: where Pi Pocket is, where the alerts go, and the sessions to watch."""
    try:
        with open(path, encoding="utf-8") as handle:
            config = json.load(handle)
    except OSError as error:
        raise WatchdogError(f"the config {path} cannot be read: {error}") from None
    except json.JSONDecodeError as error:
        raise WatchdogError(f"the config {path} is not valid JSON: {error}") from None
    if not isinstance(config, dict):
        raise WatchdogError(f"the config {path} is not an object")

    pocket = config.get("pocket")
    if not isinstance(pocket, dict) or not isinstance(pocket.get("baseUrl"), str):
        raise WatchdogError(f"the config {path} has no pocket.baseUrl")
    if not isinstance(pocket.get("tokenFile"), str):
        raise WatchdogError(f"the config {path} has no pocket.tokenFile")

    alerts = config.get("alertmanager")
    if not isinstance(alerts, dict) or not isinstance(alerts.get("url"), str):
        raise WatchdogError(f"the config {path} has no alertmanager.url")

    sessions = config.get("sessions")
    if not isinstance(sessions, list) or sessions == []:
        raise WatchdogError(f"the config {path} has no sessions")
    for session in sessions:
        if not isinstance(session, dict):
            raise WatchdogError(f"the config {path} has a session that is not an object")
        if not isinstance(session.get("id"), int) or not isinstance(session.get("name"), str):
            raise WatchdogError(f"the config {path} has a session without an id and a name")
        if not isinstance(session.get("chain"), list) or session["chain"] == []:
            raise WatchdogError(f"the config {path} has no chain for {session.get('name')}")
        plan = session.get("dispatch")
        if plan is not None:
            if not isinstance(plan, dict) or plan.get("gate") not in GATES:
                raise WatchdogError(f"the config {path} has a dispatch for {session['name']} without a known gate")
            hours = plan.get("hours")
            if not isinstance(hours, list) or hours == [] or not all(isinstance(h, int) and 0 <= h <= 23 for h in hours):
                raise WatchdogError(f"the config {path} has dispatch hours for {session['name']} that are not 0-23")
            if not isinstance(session.get("stateFile"), str):
                raise WatchdogError(f"the config {path} has a dispatch for {session['name']} without a stateFile")

    return config


def read_token(config):
    """The owner's token, read from Pi Pocket's own config. It is never printed."""
    pocket = config["pocket"]
    key = pocket.get("tokenKey") or "ownerToken"
    try:
        with open(pocket["tokenFile"], encoding="utf-8") as handle:
            stored = json.load(handle)
    except OSError as error:
        raise WatchdogError(f"the Pi Pocket config {pocket['tokenFile']} cannot be read: {error}") from None
    except json.JSONDecodeError as error:
        raise WatchdogError(f"the Pi Pocket config {pocket['tokenFile']} is not valid JSON: {error}") from None
    token = stored.get(key) if isinstance(stored, dict) else None
    if not isinstance(token, str) or token.strip() == "":
        raise WatchdogError(f"the Pi Pocket config {pocket['tokenFile']} has no {key}")
    return token.strip()


def load_state(path):
    """What the watchdog remembers: the model of each session and its limit failures."""
    try:
        with open(path, encoding="utf-8") as handle:
            state = json.load(handle)
    except FileNotFoundError:
        return {"version": 1, "sessions": {}}
    except OSError as error:
        raise WatchdogError(f"the state {path} cannot be read: {error}") from None
    except json.JSONDecodeError:
        return {"version": 1, "sessions": {}}
    if not isinstance(state, dict) or not isinstance(state.get("sessions"), dict):
        return {"version": 1, "sessions": {}}
    return state


def save_state(path, state):
    """The state, written whole, so a run that stops halfway leaves the last one standing."""
    temporary = f"{path}.tmp"
    try:
        with open(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as handle:
            json.dump(state, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(temporary, path)
    except OSError as error:
        raise WatchdogError(f"the state {path} cannot be written: {error}") from None


def log(line):
    """One line in the journal."""
    print(f"pocket-watchdog: {line}", flush=True)


def session_state(meta, view, error_text):
    """The state of a session: idle, working, failed, or waiting for an approval.

    The order is the one Pi Pocket's own client uses: an approval first, then a run, then the
    error of the newest answer.
    """
    if meta.get("waiting") is True or (isinstance(view.get("approvals"), list) and view["approvals"]):
        return "waiting for approval"
    subagents = view.get("subagents") if isinstance(view.get("subagents"), list) else []
    live = view.get("live") if isinstance(view.get("live"), dict) else {}
    if meta.get("busy") is True or live.get("busy") is True or any(
        isinstance(agent, dict) and agent.get("busy") is True for agent in subagents
    ):
        return "working"
    if error_text:
        return "failed"
    return "idle"


def last_assistant(view):
    """The newest answer of a session, with its error: (entry, error text)."""
    entries = view.get("entries") if isinstance(view, dict) else None
    if not isinstance(entries, list):
        return None
    found = None
    # Entry ids grow with the transcript; the list itself is not promised in order.
    ordered = sorted(
        (entry for entry in entries if isinstance(entry, dict) and isinstance(entry.get("id"), int)),
        key=lambda entry: entry["id"],
    )
    for entry in ordered:
        if entry.get("kind") != "assistant":
            continue
        error = entry.get("error")
        if not isinstance(error, str) or error.strip() == "":
            if entry.get("stopReason") == "error":
                error = "the model ended the run with an error"
        else:
            error = error.strip()
        found = (entry, error)
    return found


def last_activity(meta, view):
    """When the session last did something: its newest entry, or the session's own clock."""
    entries = view.get("entries") if isinstance(view, dict) else None
    if isinstance(entries, list):
        times = [entry["at"] for entry in entries if isinstance(entry, dict) and isinstance(entry.get("at"), (int, float))]
        if times:
            return int(max(times))
    updated = meta.get("updatedAt")
    return int(updated) if isinstance(updated, (int, float)) else 0


def agent_model(view):
    """The model a session runs on: (provider, model id), or None."""
    agent = view.get("agent") if isinstance(view, dict) else None
    model = agent.get("model") if isinstance(agent, dict) else None
    if not isinstance(model, dict):
        return None
    provider = model.get("provider")
    model_id = model.get("id") or model.get("modelId")
    if not isinstance(provider, str) or not isinstance(model_id, str):
        return None
    return provider, model_id


def limit_wait(view):
    """The wait for a provider's limit a session is in, or None."""
    live = view.get("live") if isinstance(view, dict) else None
    wait = live.get("limit") if isinstance(live, dict) else None
    return wait if isinstance(wait, dict) else None


def usable_links(chain, known):
    """The links of a chain Pi Pocket can run: the ones whose model it knows."""
    usable = []
    for link in chain:
        if link.key in known:
            usable.append(link)
    return usable


def next_link(usable, position, failed_provider):
    """The next link of the chain, past the one that failed and past its provider."""
    for index in range(position + 1, len(usable)):
        if usable[index].provider != failed_provider:
            return usable[index]
    return None


def post_alert(url, alert):
    """One alert to Alertmanager. A failure here is a failure of the run."""
    data = json.dumps([alert]).encode("utf-8")
    request = urllib.request.Request(
        url, data=data, method="POST", headers={"Content-Type": "application/json"}
    )
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            response.read()
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", "replace").replace("\n", " ")[:200]
        raise WatchdogError(f"the alert was refused: HTTP {error.code}: {detail}") from None
    except (urllib.error.URLError, OSError) as error:
        raise WatchdogError(f"Alertmanager is not reachable: {error}") from None


def switch_model(pocket, session_id, link):
    """Put a session on another model: Pi Pocket's own configure route."""
    pocket.post(
        f"/api/c/{session_id}/configure",
        {
            "model": {"provider": link.provider, "modelId": link.model_id},
            "thinkingLevel": link.thinking,
        },
    )


def stop_run(pocket, session_id):
    """End a run that waits on a limit: Pi Pocket's abort route ends the wait and the run.

    src/server/commands.ts, `abort`: the conversation's abort withdraws what waits in the queue and
    ends the run; the wait at the limit gate ends with it.
    """
    pocket.post(f"/api/c/{session_id}/abort", {})


def send_message(pocket, session_id, text):
    """The one message that starts the session again, as the owner (src/server/scratch/owner-submit.py)."""
    pocket.post(f"/api/c/{session_id}/submit", {"text": text, "requestId": str(uuid.uuid4())})


def recovery_message(failed_provider, link):
    """What the agent is told, in plain words."""
    return (
        f"Your last run stopped because {provider_name(failed_provider)}'s usage limit ran out. "
        f"You now run on {link.model_id}. Finish the request you were working on; "
        f"if it was a scheduled pass, run it now."
    )


def iso(at):
    """A moment as Alertmanager wants it."""
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(at / 1000))


def closed_gates(config, now):
    """The providers Pi Pocket's limit gates hold shut now: {provider: until}, from its limits
    file (`limits`). None of it is required: no file, no gates."""
    path = config.get("limits")
    if not isinstance(path, str):
        return {}
    try:
        with open(path, encoding="utf-8") as handle:
            gates = json.load(handle).get("gates") or []
    except (OSError, ValueError, AttributeError):
        return {}
    shut = {}
    for gate in gates:
        until = gate.get("until") if isinstance(gate, dict) else None
        if gate.get("state") == "waiting" and isinstance(until, (int, float)) and until > now and isinstance(gate.get("provider"), str):
            shut[gate["provider"]] = until
    return shut


def handle_session(config, pocket, entry, meta, view, known, state, now, counts, shut=None):
    """One session: what it needs, and what the watchdog does about it."""
    name = entry["name"]
    session_id = entry["id"]
    chain = [parse_link(link) for link in entry["chain"]]
    usable = usable_links(chain, known)
    primary = usable[0].key if usable else None

    record = state["sessions"].setdefault(str(session_id), {})
    failures = record.setdefault("failures", {})
    current = agent_model(view)
    current_key = f"{current[0]}/{current[1]}" if current is not None else None

    # A model that changed outside the watchdog starts the fallback clock again.
    if record.get("model") != current_key:
        record["model"] = current_key
        record["fallbackSince"] = None if current_key == primary else now

    position = -1
    for index, link in enumerate(usable):
        if link.key == current_key:
            position = index
            break

    acted = False
    failure = last_assistant(view)
    error_text = (failure[1] if failure is not None else None) or ""
    failure_id = failure[0].get("id") if failure is not None and error_text else None
    status = session_state(meta, view, error_text)
    activity = last_activity(meta, view)
    wait = limit_wait(view)

    # A failure on a limit, or a wait for one that lasts too long: another model.
    limit_failure = status == "failed" and is_limit_error(error_text)
    # How long a wait has lasted is counted from the run that first saw it: the last entry can be
    # hours old when a scheduled run meets a closed gate at once. A reset that is far away needs
    # no waiting at all.
    if wait is None:
        record.pop("waitSince", None)
    else:
        record.setdefault("waitSince", now)
    # A reset the provider gave. A backoff's `until` is only Pi Pocket's next try, not a reset: the
    # limit may last days (MiniMax's week), so it counts as unknown.
    until = None
    if wait is not None:
        until = wait.get("resetAt")
        if until is None and wait.get("kind") != "backoff":
            until = wait.get("until")
    if not isinstance(until, (int, float)):
        until = None
    long_wait = wait is not None and (
        until - now > NEAR_RESET if until is not None else now - record["waitSince"] > LIMIT_WAIT
    )
    # A failure is acted on once. The error stays the newest answer until the session answers
    # again, so the same entry seen on a later run is not a new failure: the switch already
    # happened. If the session did not start again, that pages Jan below instead of walking the
    # rest of the chain.
    already_handled = limit_failure and failure_id is not None and failure_id == record.get("handledFailure")
    if already_handled:
        limit_failure = False
    failed_provider = None
    if limit_failure or long_wait:
        if current is not None:
            failed_provider = current[0]
        elif wait is not None:
            failed_provider = wait.get("provider")
        else:
            failed_provider = None
        if current_key is not None:
            failures[current_key] = now
        if failure_id is not None:
            record["handledFailure"] = failure_id
            record["handledAt"] = now
        record.pop("waitSince", None)
        # When the provider's limit resets, if Pi Pocket knows: the session goes back then.
        resets = record.setdefault("resets", {})
        if failed_provider is not None and until is not None:
            resets[failed_provider] = until
        link = next_link(usable, position, failed_provider)
        if link is not None:
            switch_model(pocket, session_id, link)
            counts["switched"] += 1
            log(f"switched {name} to {link.key} ({link.thinking}): {provider_name(failed_provider)}'s limit ran out")
            if status == "working":
                # The run waits on the old provider's limit: it ends here, so the new model runs.
                stop_run(pocket, session_id)
                counts["stopped"] += 1
                log(f"stopped the run of {name}, which waited on {provider_name(failed_provider)}'s limit")
            send_message(pocket, session_id, recovery_message(failed_provider, link))
            counts["messaged"] += 1
            acted = True
            log(f"told {name} to finish its work on {link.model_id}")
            record["model"] = link.key
            record["fallbackSince"] = None if link.key == primary else now
        else:
            log(f"{name} has no model left in its chain: every model it can use is spent")

    # A session on a model its chain does not name (a chain that changed, or a model picked by
    # hand) is moved onto the chain once it is idle: the first link whose provider is not known
    # to be out until later.
    if not limit_failure and not long_wait and status == "idle" and usable and current_key is not None and position == -1:
        out = {**(shut or {}), **{k: v for k, v in (record.get("resets") or {}).items() if isinstance(v, (int, float))}}
        onto = next((link for link in usable if not out.get(link.provider, 0) > now), usable[-1])
        switch_model(pocket, session_id, onto)
        counts["switched"] += 1
        log(f"moved {name} from {current_key}, which its chain does not name, to {onto.key} ({onto.thinking})")
        record["model"] = onto.key
        record["fallbackSince"] = None if onto.key == primary else now
        current_key = onto.key

    # An idle session goes back to its primary model once the primary's limit has reset, or,
    # when that time is not known, after half a day on a fallback.
    primary_reset = (record.get("resets") or {}).get(usable[0].provider) if usable else None
    due = isinstance(record.get("fallbackSince"), (int, float)) and (
        now >= primary_reset if isinstance(primary_reset, (int, float))
        else now - record["fallbackSince"] >= FALLBACK_BACK
    )
    if (
        not limit_failure
        and not long_wait
        and status == "idle"
        and usable
        and current_key is not None
        and current_key != primary
        and due
    ):
        primary_link = usable[0]
        switch_model(pocket, session_id, primary_link)
        counts["switched"] += 1
        log(f"moved {name} back to its primary model {primary_link.key} ({primary_link.thinking})")
        record["model"] = primary_link.key
        record["fallbackSince"] = None
        (record.get("resets") or {}).pop(primary_link.provider, None)

    # What pages Jan.
    reasons = []
    spent = [
        link
        for link in usable
        if isinstance(failures.get(link.key), (int, float)) and (now - failures[link.key]) <= CHAIN_SPENT
    ]
    # Spent only counts while the session is held up by a limit right now: once it runs again,
    # the old failures are history.
    held = (status == "failed" and is_limit_error(error_text)) or wait is not None
    if usable and held and len(spent) == len(usable):
        reasons.append(("chain", "every model it can use is out of quota"))
    # A wait for a limit is the fallback's business, not a hang.
    if status == "working" and wait is None and activity > 0 and (now - activity) > STUCK:
        reasons.append(("stuck", "it has been working for hours without a word"))
    if (
        already_handled
        and isinstance(record.get("handledAt"), (int, float))
        and now - record["handledAt"] > FAILED
    ):
        reasons.append(("restart", "it ran out of quota and did not start again on another model"))
    if status == "failed" and not is_limit_error(error_text):
        ended = meta.get("endedAt")
        since = int(ended) if isinstance(ended, (int, float)) and ended > 0 else activity
        if since > 0 and (now - since) > FAILED:
            reasons.append(("failed", "it failed with an error that is not a quota problem"))
    if reasons:
        alert(config, name, session_id, reasons, current_key, error_text, activity, now, failures, usable)
        counts["alerted"] += 1

    return {"status": status, "acted": acted, "limited": held}


def alert(config, name, session_id, reasons, current_key, error_text, activity, now, failures, usable):
    """One critical alert for a session, with a sentence a phone reads."""
    because = reasons[0][1]
    summary = f"The {name} agent on aether has stopped: {because}."
    lines = [summary]
    for _, each in reasons[1:]:
        lines.append(f"Also: {each}.")
    lines.append(f"Session {session_id} ({name}).")
    if current_key is not None:
        lines.append(f"It runs on {current_key}.")
    if error_text:
        lines.append(f"The last error: {error_text[:300]}")
    if activity > 0:
        lines.append(f"Last activity: {iso(activity)}.")
    if failures:
        spent = ", ".join(
            f"{key} at {iso(when)}" for key, when in sorted(failures.items()) if when >= now - CHAIN_SPENT
        )
        if spent:
            lines.append(f"Limit failures in the last 12 hours: {spent}.")
    if usable:
        lines.append("Chain: " + ", ".join(str(link) for link in usable) + ".")
    post_alert(
        config["alertmanager"]["url"],
        {
            "labels": {
                "alertname": "PocketSessionStuck",
                "severity": "critical",
                "session": name,
                "namespace": "pi-pocket",
            },
            "annotations": {"summary": summary, "description": "\n".join(lines)},
            "endsAt": iso(now + ALERT_LIFE),
        },
    )
    log(f"posted a PocketSessionStuck alert for {name}: {summary}")


# ---------------------------------------------------------------------------------------------
# Fresh contexts.


def context_tokens(view):
    """The tokens the session's context holds, as Pi Pocket measures it (the newest answer since
    the last reset or compaction: its prompt, cache reads and writes, and answer). None when no
    answer has measured it since, which is the case right after a reset."""
    stats = view.get("stats") if isinstance(view, dict) else None
    if not isinstance(stats, dict) or stats.get("contextEstimated") is True:
        return None
    tokens = stats.get("contextTokens")
    return int(tokens) if isinstance(tokens, (int, float)) else None


def newest_entry(view):
    """The id of the session's newest entry, or 0."""
    entries = view.get("entries") if isinstance(view, dict) else None
    ids = [entry["id"] for entry in entries or [] if isinstance(entry, dict) and isinstance(entry.get("id"), int)]
    return max(ids) if ids else 0


def state_path(entry):
    """The session's state file, as the agent names it."""
    return f"~/work/state/{entry['stateFile']}"


def handoff_note(entry, tokens):
    """What the fresh context starts with: where the session's memory is, and nothing to do."""
    return (
        f"pocket-watchdog started a new context: the old one held about {tokens // 1000}K tokens, "
        f"and every call re-read all of it. What this session must remember is in "
        f"{state_path(entry)}: read it first in every pass, and rewrite it, at most 50 lines, last. "
        f"Your instructions and skills still apply. Nothing to do until the next message."
    )


def maybe_reset(config, pocket, entry, meta, view, record, now, counts, status, force=False):
    """Start the session afresh when it is idle on a large context: once per idle period.

    `force` is a pass about to be sent: it starts afresh however recently the session spoke.
    """
    if not entry.get("reset"):
        return False
    tokens = context_tokens(view)
    limit = config.get("resetAboveTokens", RESET_ABOVE)
    if tokens is None or tokens <= limit or status != "idle":
        return False
    if isinstance(view.get("inbox"), list) and view["inbox"]:
        return False
    newest = newest_entry(view)
    if record.get("resetEntry") == newest:
        return False
    idle = config.get("resetIdleMinutes", RESET_IDLE // MINUTE) * MINUTE
    if not force and now - last_activity(meta, view) < idle:
        return False
    pocket.post(f"/api/c/{entry['id']}/reset", {"note": handoff_note(entry, tokens)})
    record["resetEntry"] = newest
    record["resetAt"] = now
    counts["reset"] += 1
    log(f"started a new context for {entry['name']}: it was idle on {tokens // 1000}K tokens")
    return True


# ---------------------------------------------------------------------------------------------
# Scheduled passes, sent only when there is something to do.


def due_slot(now, hours):
    """The newest of today's dispatch hours that has come (Europe/Warsaw), as "YYYY-MM-DDTHH"."""
    local = datetime.datetime.fromtimestamp(now / 1000, ZONE)
    past = [hour for hour in hours if hour <= local.hour]
    if not past:
        return None
    return f"{local.date().isoformat()}T{max(past):02d}"


def command_env():
    """The environment the checks run in: pocket's home, the broker's node and gh, no prompts."""
    env = {key: value for key, value in os.environ.items() if key in ("HOME", "LANG", "TZ")}
    env.setdefault("HOME", "/home/pocket")
    env["PATH"] = "/opt/pr-broker/bin:/usr/bin:/bin"
    env["GH_NO_UPDATE_NOTIFIER"] = "1"
    env["GH_PROMPT_DISABLED"] = "1"
    return env


def run_command(argv, what):
    """One check's command, its standard output, or a GateError that says what failed."""
    try:
        done = subprocess.run(
            argv, capture_output=True, text=True, timeout=GATE_TIMEOUT, env=command_env(), check=False
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise GateError(f"{what} did not run: {error}") from None
    if done.returncode != 0:
        detail = (done.stderr or done.stdout).strip().replace("\n", " ")[:200]
        raise GateError(f"{what} failed with exit {done.returncode}: {detail}")
    return done.stdout


def run_json(argv, what):
    try:
        return json.loads(run_command(argv, what))
    except json.JSONDecodeError:
        raise GateError(f"{what} printed something that is not JSON") from None


def command(config, name):
    commands = config.get("commands") or {}
    argv = commands.get(name)
    if not isinstance(argv, list) or not argv or not all(isinstance(arg, str) for arg in argv):
        raise GateError(f"the config has no command {name}")
    return list(argv)


def digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True).encode("utf-8")).hexdigest()[:16]


def http_get_json(url, headers=None):
    request = urllib.request.Request(url, headers={"User-Agent": "pocket-watchdog/1", **(headers or {})})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            return json.loads(response.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as error:
        raise GateError(f"{urllib.parse.urlsplit(url).netloc} answered HTTP {error.code}", error.code) from None
    except (urllib.error.URLError, OSError) as error:
        raise GateError(f"{urllib.parse.urlsplit(url).netloc} is not reachable: {error}") from None
    except json.JSONDecodeError:
        raise GateError(f"{urllib.parse.urlsplit(url).netloc} answered something that is not JSON") from None


def pr_lane(ctx):
    """`pr-lane --all --json`, once per run: the PRs and Upgrades checks share it."""
    if "prLane" not in ctx["cache"]:
        results = run_json(command(ctx["config"], "prLane"), "pr-lane")
        if not isinstance(results, list):
            raise GateError("pr-lane did not print a list")
        ctx["cache"]["prLane"] = results
    return ctx["cache"]["prLane"]


def upgrade_group(result):
    """"talos" or "kubernetes" for a PR pr-lane says names that group, else None."""
    for reason in result.get("reasons") or []:
        match = re.match(r"(talos|kubernetes) group named in ", str(reason))
        if match:
            return match.group(1)
    return None


def pr_parts(result):
    """What a PR's pass looks at, each part hashed, so a change says which part moved."""
    facts = result.get("facts") if isinstance(result.get("facts"), dict) else {}
    kritika = facts.get("kritika") if isinstance(facts.get("kritika"), dict) else {}
    konflate = facts.get("konflate") if isinstance(facts.get("konflate"), dict) else {}
    checks = sorted(
        (str(c.get("name")), str(c.get("status")), str(c.get("conclusion"))) for c in facts.get("checks") or [] if isinstance(c, dict)
    )
    statuses = sorted(
        (str(s.get("context")), str(s.get("state"))) for s in facts.get("statuses") or [] if isinstance(s, dict)
    )
    return {
        "head": str(result.get("head")),
        "lane": str(result.get("lane")),
        "kritika": digest([kritika.get(k) for k in ("state", "description", "reviewedHead", "confidence", "risk")]),
        "ci": digest([checks, [s for s in statuses if s[0] != "Kritika / Review"]]),
        "konflate": digest([konflate.get("head"), konflate.get("status")]),
    }


PART_WORDS = {"kritika": "kritika's review changed", "ci": "CI changed", "konflate": "konflate changed", "upstream": "upstream changed"}


def pr_changes(old, new):
    """The words for what moved between two looks at a PR."""
    if old is None:
        return "new"
    words = []
    if old.get("head") != new["head"]:
        words.append(f"new head {new['head'][:9]}")
    if old.get("lane") != new["lane"]:
        words.append(f"lane {old.get('lane')} -> {new['lane']}")
    for part, word in PART_WORDS.items():
        if part in new and old.get(part) != new[part]:
            words.append(word)
    return ", ".join(words)


def changed_prs(previous, current, skip_lane=None):
    """Lines for the PRs that are new, changed or gone since the last pass."""
    lines = []
    for number, parts in sorted(current.items(), key=lambda item: int(item[0])):
        old = previous.get(number)
        if parts["lane"] == skip_lane or old == parts:
            continue
        lines.append(f"- #{number} (lane {parts['lane']}): {pr_changes(old, parts)}")
    for number, old in sorted(previous.items(), key=lambda item: int(item[0])):
        if number not in current and old.get("lane") != skip_lane:
            lines.append(f"- #{number}: closed or merged")
    return lines


# A lane B PR waits for the PRs session to review it and ask the broker to merge it. A pass can end
# without doing that (it ran out of context or was stopped), and an unchanged PR is never listed
# again, so #1772 sat in lane B for days. An unchanged lane B PR is listed once more each day.
B_REMINDER_MS = 24 * HOUR


def gate_prs(ctx):
    """PRs: the open home-ops PRs whose head, kritika, CI or konflate moved, and lane B PRs left
    unchanged for a day. Lane A is the broker's, and the Talos and Kubernetes groups are the
    Upgrades session's."""
    current = {}
    for result in pr_lane(ctx):
        if isinstance(result, dict) and isinstance(result.get("pr"), int) and upgrade_group(result) is None:
            current[str(result["pr"])] = pr_parts(result)
    previous = ctx["state"].get("prs") or {}
    lines = changed_prs(previous, current, skip_lane="A")
    listed = {n: t for n, t in (ctx["state"].get("prsListed") or {}).items() if n in current}
    for number, parts in current.items():
        if previous.get(number) != parts:
            listed[number] = ctx["now"]
    for number, parts in sorted(current.items(), key=lambda item: int(item[0])):
        if parts["lane"] == "B" and previous.get(number) == parts and ctx["now"] - listed.get(number, 0) >= B_REMINDER_MS:
            lines.append(f"- #{number} (lane B): unchanged, still waiting for your review and merge request")
            listed[number] = ctx["now"]
    message = None
    if lines:
        message = "\n".join(
            ["Run one PR shepherd pass. pr-lane shows these changes since the last pass:", *lines[:20],
             *([f"- and {len(lines) - 20} more: run pr-lane --all --json yourself."] if len(lines) > 20 else []),
             "Every other open PR is as it was: leave it."]
        )
    return message, {"prs": current, "prsListed": listed}


def upgrade_version(ctx, number):
    """The version a Talos or Kubernetes PR moves to: the first `-> version` of its update table."""
    body = run_command(command(ctx["config"], "gh") + ["api", f"repos/janpuc/home-ops/pulls/{number}", "--jq", ".body"], "gh")
    match = re.search(r"(?:→|->)\s*`?v?([0-9][0-9A-Za-z.+-]*)", body)
    return match.group(1) if match else None


def gate_upgrades(ctx):
    """Upgrades: a Talos or Kubernetes PR that is new, moved, merged upstream, or closed."""
    current = {}
    for result in pr_lane(ctx):
        group = upgrade_group(result) if isinstance(result, dict) else None
        if group is None or not isinstance(result.get("pr"), int):
            continue
        parts = pr_parts(result)
        version = upgrade_version(ctx, result["pr"])
        upstream = None
        if version is not None:
            found = run_json(command(ctx["config"], "upstreamDiff") + ["--upgrade", group, version, "--window", "14", "--json"], "upstream-diff --upgrade")
            upstream = [bool(found.get("merged")), (found.get("upstream") or {}).get("sha")] if isinstance(found, dict) else None
        parts["upstream"] = digest([group, version, upstream])
        current[str(result["pr"])] = parts
    lines = changed_prs(ctx["state"].get("prs") or {}, current)
    message = None
    if lines:
        message = "\n".join(
            ["Run the daily upgrades pass. These Talos and Kubernetes PRs changed since the last pass:", *lines[:20]]
        )
    return message, {"prs": current}


def gate_upstream(ctx):
    """Upstream: non-bot upstream commits after the cursor that no pass was sent yet, and the
    Monday digest."""
    found = run_json(command(ctx["config"], "upstreamDiff") + ["--json"], "upstream-diff")
    commits = [c for c in (found.get("commits") if isinstance(found, dict) else None) or [] if isinstance(c, dict)]
    sent = set(ctx["state"].get("sent") or [])
    fresh = [c for c in commits if c.get("sha") not in sent]
    local = datetime.datetime.fromtimestamp(ctx["now"] / 1000, ZONE)
    monday = local.date().isoformat() if local.weekday() == 0 else None
    want_digest = monday is not None and ctx["state"].get("digest") != monday
    remember = {"sent": sorted(str(c.get("sha")) for c in commits), "digest": ctx["state"].get("digest")}
    if not fresh and not want_digest:
        return None, remember
    lines = []
    if fresh:
        relevant = sum(1 for c in commits if c.get("relevant"))
        lines.append(f"Run the daily upstream pass. upstream-diff shows {len(commits)} non-bot commits after the cursor ({relevant} relevant), {len(fresh)} new since the last pass:")
        for c in fresh[:15]:
            lines.append(f"- {str(c.get('sha'))[:9]} {'relevant' if c.get('relevant') else 'irrelevant'}: {str(c.get('subject'))[:100]}")
    else:
        lines.append("Run the daily upstream pass: there are no new upstream commits.")
    if want_digest:
        lines.append("It is Monday: post the weekly digest of the skipped commits.")
        remember["digest"] = monday
    return "\n".join(lines), remember


def read_env_value(path, key):
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                name, sep, value = line.strip().partition("=")
                if sep and name.strip() == key:
                    return value.strip().strip("'\"")
    except OSError as error:
        raise GateError(f"{path} cannot be read: {error}") from None
    raise GateError(f"{path} has no {key}")


def gate_home(ctx):
    """Home: the automations and scripts Home Assistant runs, compared with the last drift check.
    A UI edit, and a merge the Git pull add-on brought in, both change them."""
    settings = ctx["config"].get("homeAssistant") or {}
    if not isinstance(settings.get("url"), str) or not isinstance(settings.get("envFile"), str):
        raise GateError("the config has no homeAssistant url and envFile")
    base = settings["url"].rstrip("/")
    token = read_env_value(settings["envFile"], settings.get("tokenKey", "HA_TOKEN"))
    headers = {"Authorization": f"Bearer {token}"}
    states = http_get_json(f"{base}/api/states", headers)
    if not isinstance(states, list):
        raise GateError("Home Assistant's states are not a list")
    current = {}
    for state in states:
        entity = state.get("entity_id") if isinstance(state, dict) else None
        if not isinstance(entity, str):
            continue
        if entity.startswith("automation."):
            ident = (state.get("attributes") or {}).get("id")
            if ident is None:
                continue
            path = f"automation/config/{urllib.parse.quote(str(ident), safe='')}"
        elif entity.startswith("script."):
            path = f"script/config/{urllib.parse.quote(entity.split('.', 1)[1], safe='')}"
        else:
            continue
        try:
            current[entity] = digest(http_get_json(f"{base}/api/config/{path}", headers))
        except GateError as error:
            # An entity whose config Home Assistant does not keep in YAML (made by an
            # integration): nothing of it can drift from git.
            if error.status != 404:
                raise
            current[entity] = "not in the YAML"
    previous = ctx["state"].get("configs")
    days = ctx["plan"].get("atLeastEveryDays")
    stale = isinstance(days, int) and ctx["now"] - (ctx["state"].get("sentAt") or 0) > days * 24 * HOUR
    if previous == current and not stale:
        return None, {"configs": current}
    lines = ["Run the Home Assistant drift check."]
    if previous is None:
        lines.append("It is the first check pocket-watchdog sends.")
    else:
        moved = sorted(e for e in set(current) | set(previous) if current.get(e) != previous.get(e))
        if moved:
            lines.append(f"Home Assistant's automations or scripts changed since the last check: {', '.join(moved[:30])}.")
        else:
            lines.append(f"Nothing moved, but the last check was over {days} days ago.")
    return "\n".join(lines), {"configs": current}


FINDING_NOISE = {"__name__", "prometheus", "endpoint", "instance", "job", "service", "container", "uid"}


def gate_cluster(ctx):
    """Alerts' daily scan: the scan's checks as Prometheus queries; a pass only for findings the
    session was not told about this week."""
    url = ctx["config"].get("prometheus")
    checks = ctx["plan"].get("checks")
    if not isinstance(url, str) or not isinstance(checks, list) or not checks:
        raise GateError("the config has no prometheus URL or no checks")
    findings = {}
    for check in checks:
        query = urllib.parse.urlencode({"query": check["query"]})
        answer = http_get_json(f"{url.rstrip('/')}/api/v1/query?{query}")
        if not isinstance(answer, dict) or answer.get("status") != "success":
            raise GateError(f"Prometheus did not answer the {check['name']} check")
        for series in (answer.get("data") or {}).get("result") or []:
            labels = {k: v for k, v in (series.get("metric") or {}).items() if k not in FINDING_NOISE}
            key = check["name"] + (" " + ", ".join(f"{k}={v}" for k, v in sorted(labels.items())) if labels else "")
            findings[key] = True
    told = ctx["state"].get("findings") or {}
    now = ctx["now"]
    new = [key for key in sorted(findings) if not isinstance(told.get(key), (int, float)) or now - told[key] > FINDING_AGAIN]
    remember = {"findings": {key: (now if key in new else told[key]) for key in findings}}
    if not new:
        return None, remember
    lines = ["Run the daily cluster scan. pocket-watchdog ran the scan's checks in Prometheus; new since the last scan:"]
    lines += [f"- {key}" for key in new[:20]]
    known = [key for key in sorted(findings) if key not in new]
    if known:
        lines.append(f"Still there, already reported: {'; '.join(known[:10])}.")
    lines.append("Every other check is clean in Prometheus: look into the new findings only (steps 1-6).")
    return "\n".join(lines), remember


GATES = {"prs": gate_prs, "upgrades": gate_upgrades, "upstream": gate_upstream, "home": gate_home, "cluster": gate_cluster}


def apply_instructions(pocket, entry, view, record, counts):
    """The session's instructions, from the repo's file, set once each time the file changes. An
    edit Jan makes in the app stands until the file changes again."""
    path = entry.get("instructions")
    if not isinstance(path, str):
        return
    try:
        with open(path, encoding="utf-8") as handle:
            text = handle.read().strip()
    except OSError as error:
        raise WatchdogError(f"the instructions {path} cannot be read: {error}") from None
    wanted = digest(text)
    if record.get("instructions") == wanted:
        return
    agent = view.get("agent") if isinstance(view.get("agent"), dict) else {}
    if str(agent.get("instructions") or "").strip() != text:
        pocket.post(f"/api/c/{entry['id']}/instructions", {"text": text})
        counts["instructed"] += 1
        log(f"set {entry['name']}'s instructions from {path}")
    record["instructions"] = wanted


def read_pauses(config, now):
    """The sessions pocket-usage-report's breaker paused: {id: reason}, the ones still due."""
    path = config.get("breakerFile")
    if not isinstance(path, str):
        return {}
    try:
        with open(path, encoding="utf-8") as handle:
            paused = json.load(handle).get("paused") or {}
    except (OSError, ValueError, AttributeError):
        return {}
    return {
        int(sid): str(item.get("reason", "the breaker"))
        for sid, item in paused.items()
        if isinstance(item, dict) and isinstance(item.get("until"), (int, float)) and item["until"] > now and str(sid).isdigit()
    }


def cancel_schedules(pocket, entry, view, plan):
    """Pi Pocket's own schedule for the pass the watchdog now sends: cancelled, by its exact text.
    Other schedules (the reminders ask_jan sets) stay."""
    text = plan.get("replaces")
    if not isinstance(text, str):
        return 0
    cancelled = 0
    for schedule in view.get("schedules") or []:
        if isinstance(schedule, dict) and str(schedule.get("text", "")).strip() == text.strip() and schedule.get("id"):
            pocket.post(f"/api/c/{entry['id']}/schedules/{urllib.parse.quote(str(schedule['id']))}/cancel", {})
            cancelled += 1
            log(f"cancelled {entry['name']}'s Pi Pocket schedule \"{text}\" ({schedule.get('repeat', 'once')}): the watchdog sends it now")
    return cancelled


def maybe_dispatch(config, pocket, entry, meta, view, record, now, counts, outcome, pauses, cache):
    """A scheduled pass, sent once per dispatch hour when its check finds something to do."""
    plan = entry.get("dispatch")
    if not isinstance(plan, dict):
        return
    name = entry["name"]
    cancel_schedules(pocket, entry, view, plan)
    slot = due_slot(now, plan["hours"])
    gate_state = record.setdefault("dispatch", {})
    if slot is None or gate_state.get("slot") == slot:
        return
    if entry["id"] in pauses:
        gate_state["slot"] = slot
        log(f"the {plan['gate']} pass of {name} is paused until tomorrow: {pauses[entry['id']]}")
        return
    if outcome["acted"] or outcome["limited"] or outcome["status"] not in ("idle", "failed"):
        log(f"{name} is {outcome['status']}: its {plan['gate']} pass waits for the next run")
        return
    ctx = {"config": config, "plan": plan, "state": gate_state.get("gate") or {}, "now": now, "cache": cache}
    try:
        message, remember = GATES[plan["gate"]](ctx)
    except GateError as error:
        log(f"{name}: the {plan['gate']} check failed ({error}): sending the whole pass")
        message = f"{plan.get('replaces') or 'Run your scheduled pass.'} pocket-watchdog could not check first ({error}), so do the whole pass."
        remember = gate_state.get("gate") or {}
    gate_state["slot"] = slot
    if message is None:
        gate_state["gate"] = {**remember, "sentAt": (gate_state.get("gate") or {}).get("sentAt")}
        counts["quiet"] += 1
        log(f"{name}: nothing new for its {plan['gate']} pass")
        return
    maybe_reset(config, pocket, entry, meta, view, record, now, counts, outcome["status"], force=True)
    text = (
        f"[dispatch] {message}\n\nRead {state_path(entry)} first; rewrite it, at most 50 lines, at the end of the pass. "
        f"Then stop: the watchdog sends the next pass when there is something to do."
    )
    send_message(pocket, entry["id"], text)
    gate_state["gate"] = {**remember, "sentAt": now}
    counts["dispatched"] += 1
    log(f"sent {name} its {plan['gate']} pass")


def watchdog(config_path, state_path, now_ms=None):
    """One run: read everything, then change what needs changing."""
    config = load_config(config_path)
    token = read_token(config)
    pocket = Pocket(config["pocket"]["baseUrl"], token)

    known = pocket.models()
    sessions = pocket.sessions()

    chains = {}
    for entry in config["sessions"]:
        chains[entry["name"]] = [parse_link(link) for link in entry["chain"]]

    # A link Pi Pocket does not know is not a link: it is skipped, once per run.
    skipped = set()
    for chain in chains.values():
        for link in chain:
            if link.key not in known:
                skipped.add(link.key)
    for key in sorted(skipped):
        log(f"skipping {key}: Pi Pocket does not know that model")

    views = {}
    for entry in config["sessions"]:
        session_id = entry["id"]
        if session_id not in sessions:
            log(f"the session {entry['name']} ({session_id}) is not in Pi Pocket: skipping it")
            continue
        views[session_id] = pocket.view(session_id)

    # Everything is read: from here on the run changes sessions.
    now = now_ms if now_ms is not None else int(time.time() * 1000)
    state = load_state(state_path)
    counts = {"switched": 0, "stopped": 0, "messaged": 0, "alerted": 0, "reset": 0, "dispatched": 0, "quiet": 0, "instructed": 0}
    pauses = read_pauses(config, now)
    shut = closed_gates(config, now)
    cache = {}

    problems = []
    try:
        for entry in config["sessions"]:
            session_id = entry["id"]
            if session_id not in views:
                continue
            meta, view = sessions[session_id], views[session_id]
            try:
                outcome = handle_session(config, pocket, entry, meta, view, known, state, now, counts, shut)
                record = state["sessions"][str(session_id)]
                apply_instructions(pocket, entry, view, record, counts)
                # A session the chain just moved or messaged keeps its context: it has work to finish.
                if not outcome["acted"] and not outcome["limited"]:
                    if maybe_reset(config, pocket, entry, meta, view, record, now, counts, outcome["status"]):
                        # The view is the old context's: nothing is measured in the new one yet.
                        view = {**view, "stats": {"contextEstimated": True}}
                maybe_dispatch(config, pocket, entry, meta, view, record, now, counts, outcome, pauses, cache)
            except WatchdogError as error:
                problems.append(f"{entry['name']}: {error}")
                log(f"{entry['name']}: {error}")
    finally:
        save_state(state_path, state)
    log(
        f"{len(views)} sessions checked, {counts['switched']} model switches, "
        f"{counts['stopped']} runs stopped, {counts['messaged']} messages sent, {counts['alerted']} alerts posted, "
        f"{counts['reset']} contexts reset, {counts['dispatched']} passes sent, {counts['quiet']} passes with nothing to do, "
        f"{counts['instructed']} instructions set"
    )
    if problems:
        raise WatchdogError(f"{len(problems)} sessions could not be handled; see the lines above")


def main(argv=None):
    parser = argparse.ArgumentParser(description="Keep the Pi Pocket sessions working when a provider runs out of quota.")
    parser.add_argument(
        "--config",
        default=os.environ.get("POCKET_WATCHDOG_CONFIG", DEFAULT_CONFIG),
        help="the sessions and their chains (default: %(default)s)",
    )
    parser.add_argument(
        "--state",
        default=os.environ.get("POCKET_WATCHDOG_STATE", DEFAULT_STATE),
        help="what the watchdog remembers (default: %(default)s)",
    )
    parser.add_argument("--now", type=int, help=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    try:
        watchdog(args.config, args.state, args.now)
    except WatchdogError as error:
        print(f"pocket-watchdog: {error}", file=sys.stderr, flush=True)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
