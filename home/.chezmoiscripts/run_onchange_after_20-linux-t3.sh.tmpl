{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Run the T3 Code server as a user service that survives logout. Re-runs when the unit changes.
# {{ include "dot_config/systemd/user/t3code.service" | sha256sum }}
set -eu
sudo loginctl enable-linger "$(id -un)"
systemctl --user daemon-reload
systemctl --user enable t3code.service
systemctl --user restart t3code.service
{{- end }}
