{
  "$schema": "https://opencode.ai/config.json",
  // base_url is passed inline rather than relying on MEMINI_BASE_URL reaching
  // the plugin's Bun process — otherwise it silently falls back to
  // http://localhost:8080. MEMINI_API_KEY stays in the env: it is the one
  // option the plugin accepts by env only, because it is a secret.
  //
  // recall_budget_ms is raised from its 2000 default because this deployment
  // reranks with a cross-encoder and a recall measures 1.3-2.3s end to end; at
  // 2000 a large share of recalls would time out and be silently discarded.
  //
  // recall_min_score is deliberately left at 0: it floors the FUSED score, and
  // the fused score is miscalibrated against bge-m3 here. Gating is done
  // server-side by MEMINI_RERANK_MIN_SCORE on the cross-encoder instead.
  //
  // namespace is intentionally unset so the server handshake resolves it —
  // that is what lets pins and MEMINI_NAMESPACE_PREFIX (work/) apply.
  "plugin": [
    [
      "@eleboucher/opencode-memini",
      {
        "base_url": "https://memini.janpuc.com",
        "home": "personal/jan",
        "recall_limit": 5,
        "recall_budget_ms": 4000,
        "recall_max_tokens": 400
      }
    ]
  ],
  // koment is wired as an MCP server (read + write tools) but no plugin entry:
  // the project-scoped .opencode/plugins/koment.js policy gate is added per
  // repo via `koment agents install` and would deny edits at the user level.
  // command is a single argv array — opencode's MCP shape, not the
  // command+args split most other clients use.
  "mcp": {
    "koment": {
      "type": "local",
      "command": ["koment", "mcp", "--write"]
    }
  },
  // MiniMax M3 is the default: 1M context, and it is already the default plus
  // the universal fallback in the Hermes litellm config, so it is the most
  // proven model in this stack. Switch to opencode-go/kimi-k2.7-code for
  // code-specialised work, or opencode-go/glm-5.2 for a fast non-reasoning one.
  "model": "litellm/minimax/MiniMax-M3",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm.janpuc.com/v1"
      },
      // Mirrors the live catalogue at litellm.janpuc.com/v1/models.
      // bge-embedding-m3 and bge-reranker-v2-m3 are deliberately omitted —
      // they are embedding and rerank models, not chat models.
      "models": {
        "minimax/MiniMax-M3": {
          "name": "MiniMax M3 (1M ctx)"
        },
        "minimax/MiniMax-M3-anthropic": {
          "name": "MiniMax M3 (anthropic fmt)"
        },
        "minimax/MiniMax-M2-7": {
          "name": "MiniMax M2.7"
        },
        "minimax/MiniMax-M2-7-anthropic": {
          "name": "MiniMax M2.7 (anthropic fmt)"
        },
        "opencode-go/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        },
        "opencode-go/kimi-k2.6": {
          "name": "Kimi K2.6"
        },
        "opencode-go/kimi-k3": {
          "name": "Kimi K3"
        },
        "opencode-go/glm-5.2": {
          "name": "GLM 5.2 (no reasoning)"
        },
        "opencode-go/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "opencode-go/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "opencode-go/grok-4.5": {
          "name": "Grok 4.5"
        },
        "opencode-go/mimo-v2.5-pro": {
          "name": "MiMo V2.5 Pro"
        },
        "opencode-go/mimo-v2.5": {
          "name": "MiMo V2.5"
        },
        "opencode-go/qwen3.7-max": {
          "name": "Qwen 3.7 Max"
        },
        "opencode-go/qwen3.7-plus": {
          "name": "Qwen 3.7 Plus"
        },
        "opencode-go/qwen3.6-plus": {
          "name": "Qwen 3.6 Plus"
        },
        "opencode-go/minimax-m3": {
          "name": "MiniMax M3 (opencode-go)"
        },
        "opencode-go/minimax-m2.7": {
          "name": "MiniMax M2.7 (opencode-go)"
        }
      }
    }
  }
}
