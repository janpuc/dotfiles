{{- /*
  What each kind of machine manages. Paths are targets, relative to $HOME.

  Linux is the aether server: shell basics, internal DNS sync and keepalive. It takes an
  allowlist so files added for the laptop stay off the server until listed here.
  Pi is the same everywhere (~/.pi/agent, the pi function, ai-sync's cache); other AI runtimes
  and laptop-only configuration are not managed on aether. pi-sec stays on hermes.
*/ -}}
{{ if eq .chezmoi.os "linux" -}}
**
!.chezmoiscripts
!.chezmoiscripts/*-linux-apt.sh
!.chezmoiscripts/*-linux-system.sh
!.chezmoiscripts/*-linux-terminfo.sh
!.chezmoiscripts/*-linux-rex.sh
!.chezmoiscripts/*-linux-mise.sh
!.chezmoiscripts/*-linux-pi-pocket.sh
!.chezmoiscripts/*-linux-aether-backup.sh
!.config
!.config/git
!.config/git/**
!.config/mise
!.config/mise/**
!.config/fish
!.config/fish/config.fish
!.config/fish/themes
!.config/fish/themes/**
!.config/fish/functions
!.config/fish/functions/ai-sync.fish
!.config/fish/functions/pi.fish
!.config/fish/functions/__memini_namespace_prefix.fish
!.pi
!.pi/agent
!.pi/agent/**
!.config/starship.toml
!.config/atuin
!.config/atuin/**
!.config/bat
!.config/bat/**
!.config/eza
!.config/eza/**
!.editorconfig
{{- else -}}
.chezmoiscripts/*-linux-*.sh
.config/mise
.config/mise/**
{{- if ne .hostname "hermes" }}
# pi-sec needs hermes' security tools and ~/Security; every other machine gets the same Pi as aether.
.pi/security
.pi/security/**
.config/fish/functions/pi-sec.fish
{{- end }}
{{- end }}
