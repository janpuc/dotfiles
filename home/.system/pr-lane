    if (args.filter(a => a === '--json').length > 1 || targets.length !== 1 ||
        !(targets[0] === '--all' || /^[1-9]\d*$/.test(targets[0]))) throw Error('usage: pr-lane <N>|--all [--json] [--gh /path]');
    let entries = [];
    try { entries = await konflate('prs'); if (!Array.isArray(entries)) entries = []; }
    catch { /* Missing konflate yields wait for every PR, never an eligible result. */ }
    const prs = targets[0] === '--all'
        ? await api(`${ROOT}/pulls?state=open&sort=created&direction=asc&per_page=100`, true)
        : [await api(`${ROOT}/pulls/${targets[0]}`)];
    prs.sort((a, b) => a.created_at.localeCompare(b.created_at) || a.number - b.number);
    const results = [];
    // Small bounded batches for read-only evidence gathering.
    for (let i = 0; i < prs.length; i += 4) results.push(...await Promise.all(prs.slice(i, i + 4).map(p => inspect(p, entries))));
    const value = targets[0] === '--all' ? results : results[0];
    if (json) console.log(JSON.stringify(value, null, 2));
    else for (const result of results) console.log(`#${result.pr} ${result.head} lane ${result.lane}\n  ${result.reasons.join('\n  ')}`);
}
module.exports = { classify, parseReview, compareEvidence, actorEvidence, parseUpdateType };
if (require.main === module) main().catch(error => { console.error(`pr-lane: ${error.message}`); process.exitCode = 1; });
