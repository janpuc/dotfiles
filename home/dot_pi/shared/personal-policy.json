{
  "//": "Personal Pi tool policy (Claude Code rule syntax, read by extensions/profile/permissions.ts). Unlike Work, anything no rule covers runs. ask: Pi asks first (also in T3, so on the phone); 'allow for this session' covers the same command prefix until Pi exits. Headless runs (subagents, the advisor, pi -p) cannot ask, so an ask there is refused. deny: never runs. Bash rules match each simple command of a compound one; Read/Edit rules match paths.",
  "deny": [
    "Read(~/.local/state/ai/**)",
    "Read(~/.config/op/**)",
    "Read(~/.ssh/id_*)",
    "Read(~/.pi/agent/auth.json)",
    "Read(~/.pi/agent/claude/.credentials.json)",
    "Read(~/.claude/.credentials.json)",
    "Read(~/.codex/auth.json)",
    "Read(~/.config/gh/hosts.yml)",
    "Read(.env)",
    "Edit(~/.local/state/ai/**)",
    "Edit(~/.config/op/**)",
    "Edit(~/.ssh/**)",
    "Bash(*credentials.fish*)",
    "Bash(*/.config/op/*)",
    "Bash(*/.ssh/id_*)"
  ],
  "ask": [
    "Bash(git push:*)",
    "Bash(git reset --hard:*)",
    "Bash(git clean:*)",
    "Bash(gh pr merge:*)",
    "Bash(gh release create:*)",
    "Bash(gh repo delete:*)",
    "Bash(gh repo archive:*)",
    "Bash(kubectl apply:*)",
    "Bash(kubectl create:*)",
    "Bash(kubectl delete:*)",
    "Bash(kubectl patch:*)",
    "Bash(kubectl edit:*)",
    "Bash(kubectl replace:*)",
    "Bash(kubectl scale:*)",
    "Bash(kubectl rollout restart:*)",
    "Bash(kubectl drain:*)",
    "Bash(kubectl cordon:*)",
    "Bash(kubectl label:*)",
    "Bash(kubectl annotate:*)",
    "Bash(flux reconcile:*)",
    "Bash(flux suspend:*)",
    "Bash(flux resume:*)",
    "Bash(flux delete:*)",
    "Bash(talosctl apply-config:*)",
    "Bash(talosctl patch:*)",
    "Bash(talosctl upgrade:*)",
    "Bash(talosctl upgrade-k8s:*)",
    "Bash(talosctl reboot:*)",
    "Bash(talosctl reset:*)",
    "Bash(talosctl shutdown:*)",
    "Bash(helm install:*)",
    "Bash(helm upgrade:*)",
    "Bash(helm uninstall:*)",
    "Bash(helm rollback:*)",
    "Bash(terraform apply:*)",
    "Bash(terraform destroy:*)",
    "Bash(tofu apply:*)",
    "Bash(tofu destroy:*)",
    "Bash(chezmoi apply:*)",
    "Bash(chezmoi update:*)",
    "Bash(sudo:*)",
    "Bash(op:*)",
    "Bash(rm -rf:*)",
    "Bash(rm -fr:*)",
    "Edit(~/Development/janpuc/home-ops/**)"
  ]
}
