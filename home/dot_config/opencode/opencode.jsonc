{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@eleboucher/opencode-memini"],
  // MiniMax M3 is the default: 1M context, and it is already the default plus
  // the universal fallback in the Hermes litellm config, so it is the most
  // proven model in this stack. Switch to opencode-go/kimi-k2.7-code for
  // code-specialised work, or opencode-go/glm-5.2 for a fast non-reasoning one.
  "model": "litellm/minimax/MiniMax-M3",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm.janpuc.com/v1"
      },
      // Mirrors the live catalogue at litellm.janpuc.com/v1/models.
      // bge-embedding-m3 and bge-reranker-v2-m3 are deliberately omitted —
      // they are embedding and rerank models, not chat models.
      "models": {
        "minimax/MiniMax-M3": {
          "name": "MiniMax M3 (1M ctx)"
        },
        "minimax/MiniMax-M3-anthropic": {
          "name": "MiniMax M3 (anthropic fmt)"
        },
        "minimax/MiniMax-M2-7": {
          "name": "MiniMax M2.7"
        },
        "minimax/MiniMax-M2-7-anthropic": {
          "name": "MiniMax M2.7 (anthropic fmt)"
        },
        "opencode-go/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        },
        "opencode-go/kimi-k2.6": {
          "name": "Kimi K2.6"
        },
        "opencode-go/kimi-k3": {
          "name": "Kimi K3"
        },
        "opencode-go/glm-5.2": {
          "name": "GLM 5.2 (no reasoning)"
        },
        "opencode-go/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "opencode-go/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "opencode-go/grok-4.5": {
          "name": "Grok 4.5"
        },
        "opencode-go/mimo-v2.5-pro": {
          "name": "MiMo V2.5 Pro"
        },
        "opencode-go/mimo-v2.5": {
          "name": "MiMo V2.5"
        },
        "opencode-go/qwen3.7-max": {
          "name": "Qwen 3.7 Max"
        },
        "opencode-go/qwen3.7-plus": {
          "name": "Qwen 3.7 Plus"
        },
        "opencode-go/qwen3.6-plus": {
          "name": "Qwen 3.6 Plus"
        },
        "opencode-go/minimax-m3": {
          "name": "MiniMax M3 (opencode-go)"
        },
        "opencode-go/minimax-m2.7": {
          "name": "MiniMax M2.7 (opencode-go)"
        }
      }
    }
  }
}
