# T3 Code server, bound to this box's tailnet address so the desktop and phone apps reach it over
# Tailscale only. Runs the mise-managed `t3` (`mise up` updates it). Providers it starts (Pi) inherit
# this environment; Pi's launcher reads the ai-sync credential cache itself.
[Unit]
Description=T3 Code server
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Development
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=T3CODE_HOME=%h/.t3
Environment=TERM=xterm-256color
ExecStart=/bin/sh -c 'exec %h/.local/share/mise/shims/t3 serve --host "$(tailscale ip -4 | head -n1)" --port 3773 --no-browser'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
