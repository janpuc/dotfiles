+/**
+ * Repair the two mistakes models make when they write code inside JSON strings: a backslash before a character JSON
+ * cannot escape (`\d`, `\$`, `\'`), which can only mean a literal backslash, and a raw control character such as a real
+ * newline. Both make the text invalid JSON, so the repair is tried only after a failed parse and never changes the
+ * meaning of valid JSON.
+ */
+export function repairJsonStrings(text: string): string {
+	let out = "";
+	let inString = false;
+	for (let index = 0; index < text.length; index += 1) {
+		const char = text.charAt(index);
+		if (!inString) {
+			if (char === '"') inString = true;
+			out += char;
+			continue;
+		}
+		if (char === '"') {
+			inString = false;
+			out += char;
+			continue;
+		}
+		if (char === "\\") {
+			const next = text.charAt(index + 1);
+			if (next !== "" && '"\\/bfnrt'.includes(next)) {
+				out += char + next;
+				index += 1;
+			} else if (next === "u" && /^[0-9a-fA-F]{4}$/.test(text.slice(index + 2, index + 6))) {
+				out += text.slice(index, index + 6);
+				index += 5;
+			} else {
+				out += "\\\\";
+			}
+			continue;
+		}
+		const code = char.charCodeAt(0);
+		if (code < 0x20) {
+			if (char === "\n") out += "\\n";
+			else if (char === "\r") out += "\\r";
+			else if (char === "\t") out += "\\t";
+			else out += `\\u${code.toString(16).padStart(4, "0")}`;
+			continue;
+		}
+		out += char;
+	}
+	return out;
+}
