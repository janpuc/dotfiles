#!/bin/sh
# Pi with this machine's Pi environment, for every way Pi starts: the `pi` fish function, and the
# subagent children pi-subagents opens in Rex tabs (here or on another machine), which start Pi from
# the login shell's PATH and never see a fish function. config.fish puts this directory first on
# PATH and names this file in PI_SUBAGENT_PI_BINARY.
#
# Values a caller already set win, so each line only fills a gap:
# - pi-claude-bridge's Claude Code gets its own config dir and ai-sync's one-year token.
# - ai-sync caches the OpenCode Go, MiniMax and Alibaba keys under PI_ names; Pi's providers read
#   the plain names, which stay unset in every other tool.
# - git diff inside Pi prints a plain unified diff instead of the global difftastic one.
# - Copies also go to the terminal (OSC 52), so a Rex client on another Mac gets them.
# - pi-agy-bridge sends Pi's system prompt inline: Antigravity answers 429 to it through agy's
#   append hook, and on agy 1.5.13 the bridge's auto fallback never sees the refusal. Neon can
#   think silently for minutes, so the bridge waits 5 minutes before calling a turn stalled.
# - pi-antigravity-bridge (provider antigravity) lets agy run its own shell and file tools. Its
#   approval gate is forced on, so each of those calls first passes Pi's tool_call hooks as a
#   shadow bash, write or edit call, and agent-guard refuses the hard-deny list there. A caller
#   cannot turn the gate off, only make its fallback stricter. It runs agy over ACP, without the AskAntigravity tool or web tools.
set -euf
: "${CLAUDE_CONFIG_DIR:=$HOME/.pi/agent/claude}"
: "${GIT_EXTERNAL_DIFF:=$HOME/.pi/agent/local/git-plain-diff}"
: "${PI_CLIPBOARD_OSC52:=1}"
: "${PI_AGY_SYSTEM_PROMPT:=inline}"
: "${PI_AGY_SILENCE_SEC:=300}"
# Turn metadata and refused native tool calls go to the bridge trace.log, capped at 512 KiB.
: "${PI_AGY_TRACE:=1}"
export CLAUDE_CONFIG_DIR GIT_EXTERNAL_DIFF PI_CLIPBOARD_OSC52 PI_AGY_SYSTEM_PROMPT PI_AGY_SILENCE_SEC PI_AGY_TRACE
AGY_APPROVALS=shadow
: "${AGY_APPROVALS_MODE:=allow}"
: "${AGY_ENGINE:=acp}"
: "${AGY_ASK_TOOL:=off}"
: "${AGY_WEB_TOOLS:=off}"
export AGY_APPROVALS AGY_APPROVALS_MODE AGY_ENGINE AGY_ASK_TOOL AGY_WEB_TOOLS
[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] || [ -z "${PI_CLAUDE_CODE_OAUTH_TOKEN:-}" ] || export CLAUDE_CODE_OAUTH_TOKEN="$PI_CLAUDE_CODE_OAUTH_TOKEN"
[ -n "${OPENCODE_API_KEY:-}" ] || [ -z "${PI_OPENCODE_API_KEY:-}" ] || export OPENCODE_API_KEY="$PI_OPENCODE_API_KEY"
[ -n "${MINIMAX_API_KEY:-}" ] || [ -z "${PI_MINIMAX_API_KEY:-}" ] || export MINIMAX_API_KEY="$PI_MINIMAX_API_KEY"
[ -n "${ALIBABA_API_KEY:-}" ] || [ -z "${PI_ALIBABA_API_KEY:-}" ] || export ALIBABA_API_KEY="$PI_ALIBABA_API_KEY"

# A project runner keeps shims first for cwd-sensitive bash tools. Starting Pi through mise's
# own pi shim would let mise prepend real tool paths again, so run the package's launcher (a
# small sh script that leaves PATH alone and starts its bundle with node) directly.
if [ -n "${PI_PROJECT:-}" ]; then
	exec "$(mise which pi)" "$@"
fi

# Non-project starts use the same registry lookup as fish, never a cwd-derived name.
unset MEMINI_NAMESPACE_PREFIX
# A failed lookup stops Pi, it never falls back to a namespace that could be personal.
MEMINI_NAMESPACE=$("$HOME/.local/bin/agent" namespace) || { echo "pi: agent namespace failed" >&2; exit 1; }
export MEMINI_NAMESPACE

# The real Pi is the next `pi` on PATH after this directory.
here=$(cd "$(dirname "$0")" && pwd -P)
IFS=:
for dir in $PATH; do
	[ -n "$dir" ] && [ -x "$dir/pi" ] && [ ! -d "$dir/pi" ] || continue
	[ "$(cd "$dir" 2>/dev/null && pwd -P)" = "$here" ] && continue
	# The first real Pi replaces the wrapper, it never falls through to the error below.
	# shellcheck disable=SC2093
	exec "$dir/pi" "$@"
done
echo "pi: no Pi on PATH besides $here/pi" >&2
exit 127
