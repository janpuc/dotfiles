#!/usr/bin/env zsh
#
# Profile-aware launcher for Pi (https://pi.dev), installed as ~/.local/bin/pi
# ahead of the real binary on PATH. Same script, three names:
#
#   pi           Work under ~/Work (or a repo/worktree owned by it),
#                Personal everywhere else
#   piw          Work, from anywhere
#   pi-profile   print what `pi`/`piw` would do here, or run a profile's
#                one-time Claude login: `pi-profile [--work] [login|auth]`
#   pi-attach    reattach to an interactive Pi that kept running after its
#                terminal went away (Linux with dtach, i.e. the aether server)
#
# Where dtach is installed (aether), an interactive Pi runs under it, so an SSH
# drop or a closed laptop only ends the dtach client: the run carries on and
# `pi-attach` brings it back. PI_DETACH=off opts out; print/RPC modes and
# subcommands are never wrapped.
#
# Work override, when the enterprise seat runs short: `pi --personal-models`
# (or `piw --personal-models`, e.g. with `-c` to continue the same session)
# keeps everything Work about the session — its session store, work/* memory,
# Work markers for child processes — but runs on the Personal models
# (personal Claude and ChatGPT subscriptions, LiteLLM). It is explicit per
# launch and announced; nothing ever falls back from Work to personal models
# on its own.
#
# Every launch recomputes the profile from the canonical working directory
# rather than trusting what fish's PWD hooks last exported: those match the
# logical $PWD only, so a symlink, `cd ~/development/work` on case-insensitive
# APFS, or a linked worktree outside the tree would slip past them.
#
# Profiles mirror omp's: Personal keeps Pi's default agent dir (~/.pi/agent),
# Work lives in ~/.pi/profiles/work/agent. Each has its own auth.json, sessions,
# packages and Claude Code config dir for pi-claude-bridge. Shared extension
# code and the virtual-model map live in ~/.pi/shared.
#
# The final step is `exec`, so the real pi keeps this PID: arguments, exit
# status, signals and printed resume commands pass through untouched.
# Policy refusals exit 78 (EX_CONFIG) before anything is executed.

emulate -L zsh
setopt extended_glob no_unset pipe_fail

readonly self=${0:A}
readonly invoked=${0:t}

readonly work_root=$HOME/Work
readonly dev_root=$HOME/Development
readonly personal_dir=$HOME/.pi/agent
readonly work_dir=$HOME/.pi/profiles/work/agent

warn() { print -ru2 -- "pi: $*" }
refuse() { print -ru2 -- "pi: $*"; exit 78 }

# APFS is case-insensitive, so compare folded paths on macOS.
fold() { [[ $OSTYPE == darwin* ]] && print -r -- ${1:l} || print -r -- $1 }
inside() { # inside PATH ROOT
  local p=$(fold $1) r=$(fold $2)
  [[ -n $p && -n $r && ( $p == $r || $p == $r/* ) ]]
}

# --- profile resolution -------------------------------------------------------

typeset -g profile reason repo_top= repo_owner= memini_prefix= memini_namespace=
typeset -ga why=()
# Whose models (agent dir, auth store, Claude login) the session uses. Equal to
# $profile except under the Work override, where it is personal.
typeset -g models

resolve() { # resolve EXPLICIT_WORK
  local logical=${PWD:-$(pwd)} physical=$(pwd -P)
  local work_canon=${work_root:A} dev_canon=${dev_root:A}
  local -a git_out

  [[ $1 == 1 ]] && why+=(explicit)
  # Work is sticky down a process tree: a Work session that shells out to pi
  # (from any directory) must not hand Work context to personal providers.
  [[ ${AI_PROFILE-} == work ]] && why+=(parent)
  { inside $logical $work_root || inside $physical $work_canon } && why+=(cwd)

  git_out=("${(@f)$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR \
    git -C $physical rev-parse --path-format=absolute --show-toplevel --git-common-dir 2>/dev/null)}")
  if (( ${#git_out} == 2 )); then
    repo_top=${git_out[1]:A}
    local common=${git_out[2]:A}
    # A linked worktree's common dir is the owning repo's .git, wherever the
    # worktree itself was checked out.
    [[ ${common:t} == .git ]] && repo_owner=${common:h} || repo_owner=$common
    { inside "$repo_top" "$work_canon" || inside "$repo_owner" "$work_canon" } && why+=(repo)
  fi

  (( ${#why} )) && profile=work || profile=personal
  reason=${(j:,:)why:-default}

  # Memory identity, recomputed here rather than inherited from fish. Same rules
  # as __memini_namespace_prefix.fish, keyed on the effective profile so an
  # explicit `piw` outside the tree still gets Work semantics. A server-side pin
  # still wins over both variables; check_memini below vets the result.
  if [[ $profile == work ]]; then
    if [[ -n $repo_top ]] || inside $logical $work_root || inside $physical $work_canon; then
      memini_prefix=work
    else
      memini_namespace=work/scratch
    fi
  elif inside $logical $dev_root || inside $physical $dev_canon; then
    memini_prefix=homelab
  elif [[ -z $repo_top ]]; then
    memini_namespace=homelab/scratch
  fi
}

# --session/--fork/--session-dir naming a file inside a profile's agent dir pin
# the launch to that profile. A Work session opened from outside the tree goes
# to Work; Personal history is never loaded into Work.
check_session_args() {
  local i a val owner
  for (( i = 1; i <= $#; i++ )); do
    a=${argv[i]} val=
    case $a in
      --) break ;;
      --session|--fork|--session-dir) val=${argv[i+1]-} ;;
      --session=*|--fork=*|--session-dir=*) val=${a#*=} ;;
      *) continue ;;
    esac
    [[ -n $val && -e $val ]] || continue # a bare session id stays profile-local
    if inside ${val:A} ${work_dir:A}; then owner=work
    elif inside ${val:A} ${personal_dir:A}; then owner=personal
    else continue
    fi
    if [[ $owner == work && $profile == personal ]]; then
      warn "$val belongs to the Work profile; launching as Work"
      profile=work why+=(session) reason=${(j:,:)why}
      [[ -z $memini_prefix ]] && memini_namespace=work/scratch
      [[ -n $repo_top ]] && memini_prefix=work memini_namespace=
    elif [[ $owner == personal && $profile == work ]]; then
      refuse "$val is Personal history; refusing to load it into the Work profile ($reason)"
    fi
  done
}

# --- environment ----------------------------------------------------------------

# Credentials and endpoint overrides that would let Claude Code or Pi bill
# something other than the profile's subscriptions. Cleared for both profiles;
# Work additionally loses every personal provider key below.
readonly -a scrub_always=(
  ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_OAUTH_TOKEN ANTHROPIC_BASE_URL
  ANTHROPIC_CUSTOM_HEADERS ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL
  ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL
  ANTHROPIC_FEDERATION_RULE_ID ANTHROPIC_IDENTITY_TOKEN_FILE ANTHROPIC_ORGANIZATION_ID
  ANTHROPIC_SERVICE_ACCOUNT_ID ANTHROPIC_WORKSPACE_ID
  CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY
  CLAUDE_SECURESTORAGE_CONFIG_DIR
  OPENAI_API_KEY OPENAI_BASE_URL OPENAI_ORG_ID OPENAI_ORGANIZATION OPENAI_PROJECT
  PI_CODING_AGENT_SESSION_DIR
)
readonly -a scrub_work=(
  LITELLM_API_KEY LITELLM_BASE_URL LITELLM_MASTER_KEY PI_OPENCODE_API_KEY PI_MINIMAX_API_KEY PI_OPENAI_API_KEY
  AI_GATEWAY_API_KEY ANT_LING_API_KEY AZURE_OPENAI_API_KEY AZURE_OPENAI_BASE_URL
  AZURE_OPENAI_RESOURCE_NAME AWS_BEARER_TOKEN_BEDROCK BASETEN_API_KEY CEREBRAS_API_KEY
  CLOUDFLARE_API_KEY CODEX_API_KEY COPILOT_GITHUB_TOKEN DEEPSEEK_API_KEY FIREWORKS_API_KEY
  GEMINI_API_KEY GOOGLE_CLOUD_API_KEY GROQ_API_KEY HF_TOKEN KIMI_API_KEY META_API_KEY
  MINIMAX_API_KEY MINIMAX_CN_API_KEY MISTRAL_API_KEY MOONSHOT_API_KEY NVIDIA_API_KEY
  OPENCODE_API_KEY OPENROUTER_API_KEY QWEN_TOKEN_PLAN_API_KEY QWEN_TOKEN_PLAN_CN_API_KEY
  RADIUS_API_KEY TOGETHER_API_KEY TYPESAFE_API_KEY XAI_API_KEY XIAOMI_API_KEY
  XIAOMI_TOKEN_PLAN_AMS_API_KEY XIAOMI_TOKEN_PLAN_CN_API_KEY XIAOMI_TOKEN_PLAN_SGP_API_KEY
  ZAI_API_KEY ZAI_CODING_CN_API_KEY
)

# Launched from somewhere other than fish (cron, another shell), the ai-sync
# cache has not been sourced. Import only what this profile may use; never
# prompts, since the cache is the whole point of ai-sync.
import_cached_credentials() {
  local cache=${XDG_STATE_HOME:-$HOME/.local/state}/ai/credentials.fish name
  local -a names=(MEMINI_API_KEY) missing=() pairs
  [[ $models == personal ]] && names+=(LITELLM_API_KEY PI_OPENCODE_API_KEY PI_MINIMAX_API_KEY PI_OPENAI_API_KEY)
  for name in $names; do [[ -z ${(P)name-} ]] && missing+=($name); done
  local fish=${commands[fish]:-/opt/homebrew/bin/fish}
  (( ${#missing} )) && [[ -r $cache && -x $fish ]] || return 0
  pairs=("${(@0)$($fish --no-config -c 'source $argv[1]; for n in $argv[2..]; set -q $n; and printf "%s=%s\0" $n $$n; end' \
    $cache $missing 2>/dev/null)}")
  local kv
  for kv in $pairs; do [[ $kv == *=* ]] && export "${kv%%=*}=${kv#*=}"; done
}

apply_environment() {
  local agent_dir
  [[ $models == work ]] && agent_dir=$work_dir || agent_dir=$personal_dir
  if [[ -n ${PI_CODING_AGENT_DIR-} && ${PI_CODING_AGENT_DIR:A} != ${agent_dir:A} && -z ${AI_PROFILE-} ]]; then
    warn "ignoring PI_CODING_AGENT_DIR=$PI_CODING_AGENT_DIR; this launch is $profile ($reason)"
  fi

  local v
  for v in $scrub_always; do unset $v; done
  # Runtime markers of an enclosing Claude Code session would make the bridge's
  # Claude Code child behave as a nested session.
  for v in CLAUDECODE CLAUDE_PID ${(k)parameters[(I)CLAUDE_CODE_*]}; do unset $v; done
  [[ $models == work ]] && for v in $scrub_work; do unset $v; done
  if [[ $profile == work ]]; then
    if [[ $models == personal ]]; then
      # Override: Personal auth and models, but the exact per-cwd folder Work
      # sessions use, so `-c`/`--resume` see one history in both modes.
      local cwd=$(pwd -P)
      export PI_CODING_AGENT_SESSION_DIR=$work_dir/sessions/--${${cwd#/}//[\/:]/-}--
      mkdir -p $PI_CODING_AGENT_SESSION_DIR
    fi
    export OMP_PROFILE=work
    # Codex CLI keeps its ChatGPT login in ~/.codex; a Work child that runs
    # `codex` gets an empty home instead of the personal subscription.
    export CODEX_HOME=$work_dir/codex
    mkdir -p -m 700 $CODEX_HOME
  else
    unset OMP_PROFILE
  fi

  import_cached_credentials
  # Personal subscription keys ai-sync caches under PI_* names (see ai-sync.fish),
  # exposed under the names Pi's opencode-go and minimax providers read, for Pi only.
  if [[ $models == personal ]]; then
    [[ -n ${PI_OPENCODE_API_KEY-} ]] && export OPENCODE_API_KEY=$PI_OPENCODE_API_KEY
    [[ -n ${PI_MINIMAX_API_KEY-} ]] && export MINIMAX_API_KEY=$PI_MINIMAX_API_KEY
  fi

  export AI_PROFILE=$profile AI_PROFILE_MODELS=$models
  export PI_CODING_AGENT_DIR=$agent_dir
  # pi-claude-bridge runs Claude Code with Pi's environment, and Claude Code
  # keys both its config and its Keychain item on this directory.
  export CLAUDE_CONFIG_DIR=$agent_dir/claude
  mkdir -p -m 700 $agent_dir $CLAUDE_CONFIG_DIR

  export MEMINI_BASE_URL=${MEMINI_BASE_URL:-https://memini.janpuc.com}
  export MEMINI_HOME=${MEMINI_HOME:-personal/jan}
  unset MEMINI_NAMESPACE MEMINI_NAMESPACE_PREFIX
  [[ -n $memini_prefix ]] && export MEMINI_NAMESPACE_PREFIX=$memini_prefix
  [[ -n $memini_namespace ]] && export MEMINI_NAMESPACE=$memini_namespace
}

# --- memory scope gate ----------------------------------------------------------

# Ask memini which namespace and read set this session would get, with the same
# facts pi-memini sends, before Pi starts and anything is recalled or captured.
# Work must stay inside work/* (plus the personal home overlay, read-only by
# design); Personal must never see work/*. A conflicting pin or link stops the
# launch. Pins are never rewritten here.
typeset -g memini_state=unchecked memini_detail=

memory_off() { # memory_off REASON
  unset MEMINI_API_KEY
  # Unroutable endpoint: pi-memini degrades to no-ops and nothing leaves the host.
  export MEMINI_BASE_URL=http://127.0.0.1:9
  export MEMINI_RECALL=0 MEMINI_CAPTURE=0 MEMINI_CAPTURE_TURNS=0 MEMINI_SESSION_DIGEST=0 \
    MEMINI_AUTO_SAVE=0 MEMINI_INLINE_EXTRACT=0 MEMINI_INJECT_BRIEFING_PINNED=0 \
    MEMINI_INJECT_BRIEFING_FACTS=0 MEMINI_INJECT_BRIEFING_PROCEDURES=0 MEMINI_INJECT_BRIEFING_RECENT=0
  memini_state=off memini_detail=$1
}

check_memini() {
  if [[ ${PI_MEMINI-on} == off ]]; then memory_off "PI_MEMINI=off"; return; fi
  if [[ -z ${MEMINI_API_KEY-} ]]; then
    memini_state=degraded memini_detail="MEMINI_API_KEY unset (run ai-sync)"; return
  fi
  if ! (( $+commands[curl] && $+commands[jq] )); then
    memini_state=degraded memini_detail="curl/jq missing, scope not verified"; return
  fi

  local physical=$(pwd -P) remote= facts resp verdict
  [[ -n $repo_top ]] && remote=$(git -C $physical remote get-url origin 2>/dev/null)
  facts=$(jq -cn --arg cwd "${physical:t}" --arg remote "$remote" --arg top "$repo_top" \
    --arg ns "${MEMINI_NAMESPACE-}" --arg prefix "${MEMINI_NAMESPACE_PREFIX-}" --arg agent "${MEMINI_AGENT-}" '
    {project: ({cwd_basename: $cwd}
      + (if $remote != "" then {remote_url: $remote} else {} end)
      + (if $top != "" then {toplevel_path: $top, toplevel_basename: ($top | split("/") | last)} else {} end)
      + (if $agent != "" then {agent: $agent} else {} end)
      + (if $ns != "" then {env_namespace: $ns} else {} end)
      + (if $prefix != "" then {env_namespace_prefix: $prefix} else {} end)),
     client: {name: "pi-launcher"}}')
  # Header via stdin so the key never appears in the process list.
  resp=$(print -r -- "header = \"Authorization: Bearer $MEMINI_API_KEY\"" |
    curl -fsS -m 3 -K - -H "X-Memini-Home: $MEMINI_HOME" -H 'Content-Type: application/json' \
      --data-binary $facts "$MEMINI_BASE_URL/v1/handshake" 2>&1) || {
    memini_state=degraded memini_detail="handshake failed: ${resp:0:120}"; return
  }
  verdict=$(print -r -- $resp | jq -r --arg profile "$profile" --arg home "$MEMINI_HOME" '
    def work: . == "work" or startswith("work/");
    . as $h
    | [ (if $profile == "work" then
          (if ($h.namespace | work) then empty else "namespace \($h.namespace) is outside work/*" end),
          ($h.read_set[]? | select((.namespace | work | not) and .namespace != $home)
            | "read set includes \(.namespace) (\(.origin))")
        else
          (if ($h.namespace | work) then "namespace \($h.namespace) is a Work namespace" else empty end),
          ($h.read_set[]? | select(.namespace | work) | "read set includes \(.namespace) (\(.origin))")
        end) ] as $bad
    | if ($bad | length) == 0 then "ok\t\($h.namespace) (\($h.namespace_source))"
      else "conflict\t\($bad | join("; ")); source \($h.namespace_source)\(if $h.pin then ", pin \($h.pin.key)" else "" end)" end' 2>/dev/null)
  case ${verdict%%$'\t'*} in
    ok) memini_state=ok memini_detail=${verdict#*$'\t'} ;;
    conflict)
      memini_state=conflict memini_detail=${verdict#*$'\t'} ;;
    *) memini_state=degraded memini_detail="unparseable handshake reply" ;;
  esac
}

# --- Claude account and billing -------------------------------------------------------

# The bridge's Claude Code logs in per CLAUDE_CONFIG_DIR. Claude Code only enforces
# forceLoginOrgUUID from managed policy, so the launcher checks the stored login:
# Work must hold an organisation seat distinct from Personal's, Personal must not be
# the enterprise seat. A missing login is reported, not fatal (Pi still starts).
check_claude_account() {
  (( $+commands[jq] )) || return 0
  local -a mine other
  org_of() { jq -r '.oauthAccount // {} | [.organizationUuid // "", .organizationType // "", .organizationName // ""] | @tsv' $1 2>/dev/null }
  mine=("${(@ps:\t:)$(org_of $CLAUDE_CONFIG_DIR/.claude.json)}")
  if [[ -z ${mine[1]-} ]]; then
    warn "Claude (pi-claude-bridge) is not logged in for $models; run once: pi-profile${${models:#personal}:+ --work} login"
    return 0
  fi
  local other_dir; [[ $models == work ]] && other_dir=$personal_dir || other_dir=$work_dir
  other=("${(@ps:\t:)$(org_of $other_dir/claude/.claude.json)}")
  if [[ -n ${other[1]-} && ${other[1]} == ${mine[1]} ]]; then
    refuse "both profiles' Claude logins are the same organisation (${mine[3]-}); log the $models profile in again with the right account: pi-profile${${models:#personal}:+ --work} login"
  fi
  case $models:${mine[2]-} in
    work:claude_max|work:claude_pro|work:claude_free)
      refuse "the Work Claude login is a personal ${mine[2]} plan (${mine[3]-}); re-login with the enterprise seat: pi-profile --work login" ;;
    personal:claude_enterprise)
      refuse "the Personal Claude login is the enterprise seat (${mine[3]-}); re-login with the personal subscription: pi-profile login" ;;
  esac
}

# Project Claude settings apply to the bridge's Claude Code like any other session, and
# apiKeyHelper or ANTHROPIC_* there outrank the subscription login, silently switching
# to API billing or another endpoint. Refuse rather than run on someone else's meter.
check_project_claude_settings() {
  (( $+commands[jq] )) || return 0
  local dir f bad
  local -a dirs=("$(pwd -P)")
  [[ -n $repo_top ]] && dirs+=("$repo_top")
  for dir in ${(u)dirs}; do
    for f in $dir/.claude/settings.json $dir/.claude/settings.local.json; do
      [[ -f $f ]] || continue
      bad=$(jq -r '[ (if .apiKeyHelper then "apiKeyHelper" else empty end),
                     (.env // {} | keys[] | select(test("^(ANTHROPIC_|CLAUDE_CODE_USE_|CLAUDE_CODE_OAUTH_TOKEN$)"))) ] | join(", ")' $f 2>/dev/null)
      [[ -n $bad ]] && refuse "$f sets $bad, which would move pi-claude-bridge off the $profile subscription login"
    done
  done
  return 0
}

# --- real binary --------------------------------------------------------------------

find_real_pi() {
  local d f
  for d in $path; do
    f=$d/pi
    [[ -f $f && -x $f && ${f:A} != $self ]] && { print -r -- $f; return }
  done
  return 1
}


# --- detachable terminal Pi (aether) --------------------------------------------------

detach_dir() { print -r -- ${XDG_RUNTIME_DIR:-/tmp/pi-$UID}/pi }

# Whether these pi arguments start the interactive TUI (not print/RPC/JSON, help or a subcommand).
interactive_args() {
  case ${1-} in install|remove|uninstall|update|list|config|auth|mcp) return 1 ;; esac
  local a
  for a in "$@"; do
    case $a in
      --) return 0 ;;
      -p|--print|--mode|--mode=*|-h|--help|-v|--version|--export|--export=*|--list-models|--list-models=*) return 1 ;;
    esac
  done
  return 0
}

# exec the real pi under dtach when that makes sense; returns otherwise.
maybe_detach() {
  [[ ${PI_DETACH-} == off || -z ${commands[dtach]-} ]] && return 0
  [[ -t 0 && -t 1 ]] || return 0
  interactive_args "$@" || return 0
  # Already the child of a dtach master (a pi started from inside a detached one).
  [[ -n ${PI_DETACH_ID-} && $(ps -o comm= -p $PPID 2>/dev/null) == dtach ]] && return 0
  local dir=$(detach_dir) id=p${EPOCHSECONDS:-$(date +%s)}-$$
  mkdir -p -m 700 $dir 2>/dev/null && [[ -O $dir ]] || return 0
  export PI_DETACH_ID=$id PI_DETACH_DIR=$dir
  # -E: no detach key, so every key reaches Pi; -z: Ctrl+Z too. Closing the terminal detaches.
  exec dtach -c $dir/$id.sock -E -z -r winch $real "$@"
}

attach_main() {
  local dir=$(detach_dir) want= mode=attach meta id pid sock i=0
  case ${1-} in
    --list) mode=list ;;
    --summary) mode=summary ;;
    -h|--help) print "usage: pi-attach [<number>|<id>|--list]   reattach to a Pi that is still running"; return 0 ;;
    '') ;;
    *) want=$1 ;;
  esac
  local -a ids pids socks rows
  for sock in $dir/*.sock(N=); do
    id=${sock:t:r} meta=$dir/$id.json pid=
    [[ -r $meta ]] && pid=$(jq -r '.pid // empty' $meta 2>/dev/null)
    # Pi has exited, and dtach serves only that one program: nothing is left to attach.
    if [[ -n $pid ]] && ! kill -0 $pid 2>/dev/null; then rm -f $meta $sock; continue; fi
    (( ++i ))
    ids+=($id) pids+=(${pid:-0}) socks+=($sock)
    rows+=("[$i] $id  $( [[ -r $meta ]] && jq -r --arg home $HOME '"\(.cwd | sub("^" + $home; "~"))  \(.profile)\(if .name then "  " + .name else "" end)  since \(.started[11:16])"' $meta 2>/dev/null)")
  done
  case $mode in
    summary) (( i )) && print -r -- "$i Pi session(s) still running here: pi-attach to get back (pi-attach --list)."; return 0 ;;
    list) (( i )) && print -rl -- $rows || print "No running Pi sessions to attach."; return 0 ;;
  esac
  local pick=0
  if [[ -n $want ]]; then
    if [[ $want == <-> ]] && (( want >= 1 && want <= i )); then pick=$want
    else pick=${ids[(Ie)$want]}
    fi
    (( pick )) || { warn "no running Pi session '$want' (pi-attach --list)"; return 1 }
  elif (( i == 1 )); then pick=1
  elif (( i == 0 )); then print "No running Pi sessions to attach."; return 0
  else print -rl -- $rows "Pick one: pi-attach <number>"; return 0
  fi
  # Once attached, Pi replays its terminal setup and repaints the whole screen (SIGUSR2).
  (( pids[pick] )) && { sleep 0.4; kill -USR2 ${pids[pick]} 2>/dev/null } &!
  exec dtach -a ${socks[pick]} -E -z -r winch
}

# --- main ---------------------------------------------------------------------------

if [[ $invoked == pi-attach ]]; then
  attach_main "$@"
  exit
fi

explicit=0 override=0 sub=
case $invoked in
  piw) explicit=1 ;;
  pi-profile)
    while (( $# )); do
      case $1 in
        --work) explicit=1 ;;
        --personal-models) override=1 ;;
        login|auth) sub=$1 ;;
        -h|--help) print "usage: pi-profile [--work] [--personal-models] [login|auth]"; exit 0 ;;
        *) refuse "pi-profile: unknown argument $1" ;;
      esac
      shift
    done ;;
esac
if [[ $invoked != pi-profile ]]; then
  # --personal-models is the launcher's own flag; pi never sees it.
  typeset -a rest=()
  typeset passthrough=0 a
  for a in "$@"; do
    if (( ! passthrough )) && [[ $a == --personal-models ]]; then override=1; continue; fi
    [[ $a == -- ]] && passthrough=1
    rest+=("$a")
  done
  set -- "${rest[@]}"
fi

resolve $explicit
[[ $invoked == pi-profile ]] || check_session_args "$@"
models=$profile
# A pi started from inside an override session (a subagent, a nested launch) keeps it.
[[ $profile == work && ${AI_PROFILE-} == work && ${AI_PROFILE_MODELS-} == personal ]] && override=1
if (( override )); then
  if [[ $profile == work ]]; then
    models=personal
    warn "Work session on PERSONAL models (--personal-models): personal Claude/ChatGPT subscriptions and LiteLLM are used and billed; sessions and memory stay Work"
  else
    warn "--personal-models only changes Work sessions; this launch is already Personal"
  fi
fi
apply_environment

# Work runs under the managed settings (provider allowlist, tool policy). A machine that does not
# deploy them, such as the aether server, must not start a bare Pi in a Work tree instead.
if [[ $invoked != pi-profile && $models == work && ! -f $work_dir/settings.json ]]; then
  refuse "the Work profile is not set up on this machine ($work_dir/settings.json is missing), so Work sessions are not available here"
fi

if [[ $invoked == pi-profile ]]; then
  case $sub in
    login)
      # One-time, per profile: Claude subscription OAuth for pi-claude-bridge,
      # stored under this profile's CLAUDE_CONFIG_DIR and its own Keychain item.
      print -r -- "Logging Claude Code into the $models profile ($CLAUDE_CONFIG_DIR)."
      [[ $models == work ]] && print -r -- "Pick the ENTERPRISE organisation on the consent page." \
        || print -r -- "Pick the PERSONAL subscription on the consent page."
      exec claude auth login --claudeai ;;
    auth)
      print -r -- "== $models: Claude Code (pi-claude-bridge)"
      claude auth status --json 2>&1 | jq '{loggedIn, authMethod, orgName, subscriptionType, configDirectory}' 2>/dev/null
      if [[ $models == personal ]] && real=$(find_real_pi); then
        print -r -- "== $models: openai-codex"
        $real auth check --provider openai-codex 2>&1
      fi
      exit 0 ;;
  esac
  check_memini
  print -r -- "profile=$profile"
  print -r -- "reason=$reason"
  print -r -- "models=$models"
  print -r -- "agent_dir=$PI_CODING_AGENT_DIR"
  print -r -- "session_dir=${PI_CODING_AGENT_SESSION_DIR:-$PI_CODING_AGENT_DIR/sessions}"
  print -r -- "claude_config_dir=$CLAUDE_CONFIG_DIR"
  print -r -- "repo=${repo_top:-none}${repo_owner:+ (owner ${repo_owner})}"
  print -r -- "memini_namespace_prefix=${MEMINI_NAMESPACE_PREFIX-}"
  print -r -- "memini_namespace=${MEMINI_NAMESPACE-}"
  print -r -- "memini_home=$MEMINI_HOME"
  print -r -- "memini=$memini_state${memini_detail:+: $memini_detail}"
  [[ $memini_state == conflict ]] && exit 78
  exit 0
fi

# Subcommands and informational flags never read or capture memory.
case ${1-} in
  install|remove|uninstall|update|list|config|auth|mcp|-h|--help|-v|--version|--list-models|--list-models=*|--export) ;;
  *)
    check_memini
    case $memini_state in
      conflict)
        refuse "memini scope conflict for the $profile profile: $memini_detail.
  Nothing has been read or captured. Fix the pin for this project (in the right
  profile: /memini:namespace, or memini's pins API), or start without memory:
  PI_MEMINI=off $invoked ${(j: :)${(q-)@}}" ;;
      degraded) warn "memini degraded: $memini_detail — memory is not being recalled or saved" ;;
    esac
    check_claude_account
    check_project_claude_settings ;;
esac
export PI_MEMINI_STATE="$memini_state${memini_detail:+: $memini_detail}"

# A project .pi/claude-bridge.json is read by the bridge without project trust
# and can re-enable Claude Code MCP config, swap the Claude binary or turn on
# AskClaude (native tools, subagents). None of that is allowed in Work.
bridge_project_config="$(pwd -P)/.pi/claude-bridge.json"
if [[ $profile == work && -f $bridge_project_config ]]; then
  bad=$(jq -r '[ (if .provider.strictMcpConfig == false then "provider.strictMcpConfig=false" else empty end),
                 (if .provider.pathToClaudeCodeExecutable then "provider.pathToClaudeCodeExecutable" else empty end),
                 (if .askClaude.enabled then "askClaude.enabled" else empty end) ] | join(", ")' \
        $bridge_project_config 2>/dev/null || print unparseable)
  [[ -n $bad ]] && refuse "project .pi/claude-bridge.json sets $bad, which the Work profile does not allow"
fi

real=$(find_real_pi) || refuse "the pi binary is not on PATH
  macOS: brew install pi-coding-agent   elsewhere: npm install -g @earendil-works/pi-coding-agent"
maybe_detach "$@"
exec $real "$@"
