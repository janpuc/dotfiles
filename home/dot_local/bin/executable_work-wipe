#!/usr/bin/env python3
"""Explicit work-only deletion inventory. Dry run unless Jan supplies --really."""
import argparse
import ctypes
import hashlib
import stat
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import shutil
import socket
import sys


def work_sessions(home):
    """Pi session folders whose every header has a cwd inside ~/Work."""
    found = []
    sessions = home / ".pi/agent/sessions"
    if sessions.is_symlink():
        raise ValueError("Refusing symlinked Pi sessions")
    prefix = "--" + str(home / "Work").lstrip("/").replace("/", "-")
    if sessions.is_dir():
        for path in sorted(sessions.iterdir()):
            if path.name != prefix + "--" and not path.name.startswith(prefix + "-"):
                continue
            if path.is_symlink() or not path.is_dir():
                raise ValueError("Refusing an unverifiable Work session entry")
            # Pi's folder encoding is lossy: Work-foo can also mean Work/foo. Verify
            # actual session headers so a similarly named non-Work path is never wiped.
            files = list(path.iterdir())
            verified = bool(files)
            for file in files:
                try:
                    if file.is_symlink() or not file.is_file():
                        verified = False
                        break
                    with file.open() as stream:
                        header = json.loads(stream.readline(8192))
                    cwd = Path(header["cwd"])
                    if not cwd.is_relative_to(home / "Work") or ".." in cwd.parts:
                        verified = False
                        break
                except (OSError, ValueError, KeyError, TypeError):
                    verified = False
                    break
            if verified or not files and path.name == prefix + "--":
                found.append(path)
            else:
                print("Work session candidate skipped, no verified Work cwd in every header", file=sys.stderr)
    return found


def wipe_paths(home, host):
    if host not in ("hermes", "sisyphus"):
        raise ValueError("work-wipe is only for hermes and sisyphus")
    paths = [home / path for path in (
        "Work", ".aws", ".granted", ".saml2aws", ".aws-sso",
        ".local/state/ai/projects/work.env", ".config/op/sisyphus-work.env",
    )]
    # All generated Work kubeconfigs, including legacy direct files. The personal config and
    # its cache are deliberately excluded on both hosts. Never follow a kube directory symlink.
    kube = home / ".kube"
    if kube.is_symlink():
        raise ValueError("Refusing symlinked ~/.kube")
    if kube.is_dir():
        paths += [path for path in sorted(kube.iterdir()) if path.name not in ("config", "cache")]
    registry = home / ".config/agents/projects.json"
    if registry.exists():
        projects = json.loads(registry.read_text())["projects"]
        for name, project in projects.items():
            if any(ref.startswith("op://Work/") for ref in project.get("secrets", {}).values()):
                if not name or Path(name).name != name or name in (".", ".."):
                    raise ValueError("Invalid work project name")
                paths.append(home / f".local/state/ai/projects/{name}.env")
    paths += work_sessions(home)
    paths.append(home / ".local/share/agent-history/work")
    if host == "sisyphus":
        paths += [home / path for path in (
            ".local/state/agents", ".local/state/sisyphus-backup", ".cache/restic",
            ".config/sisyphus-backup", ".config/restic/sisyphus.password",
            ".ssh/sisyphus-backup", ".ssh/sisyphus-backup.pub",
            ".ssh/work-inbox", ".ssh/work-inbox.pub",
        )]
    return list(dict.fromkeys(paths))


def migrated_paths(home, host):
    """What moved to sisyphus and is left on the laptop: the contents of ~/Work and the Work Pi
    sessions. Credentials stay, the laptop still sends temporary AWS logins with work-creds."""
    if host != "hermes":
        raise ValueError("work-wipe --migrated is only for hermes")
    work = home / "Work"
    if work.is_symlink():
        raise ValueError("Refusing symlinked ~/Work")
    paths = sorted(work.iterdir()) if work.is_dir() else []
    return paths + work_sessions(home)


def migrated_units(home, paths):
    """The renameable units of a migrated cleanup: ~/Work, whose contents are the inventory, and each
    Work session folder, which is inventory with its contents."""
    work = home / "Work"
    units = [(work, work, False)] if work.is_dir() else []
    return units + [(path, path, True) for path in paths if not path.is_relative_to(work)]


def summary(units):
    """Entries, bytes, the newest change and an inventory hash of every unit, without following
    links. A unit is (where it is now, where it was reviewed, whether its own folder counts). Each
    entry is named by its reviewed path and identified by device, inode, type, size, mtime and
    ctime, so a replacement with the same size and times changes the hash. A unit folder's own
    ctime is left out, since moving it aside changes it, and its entries are checked one by one."""
    entries = size = 0
    newest = 0.0
    records = []
    for actual, shown, own in units:
        stack = [(actual, shown)]
        while stack:
            current, name = stack.pop()
            try:
                info = current.lstat()
            except OSError:
                continue
            root = current == actual
            if own or not root:
                entries += 1
                size += info.st_size
                newest = max(newest, info.st_mtime)
                ctime = "" if root else info.st_ctime_ns
                records.append(f"{name}\0{info.st_dev}\0{info.st_ino}\0{stat.S_IFMT(info.st_mode)}\0"
                               f"{info.st_size}\0{info.st_mtime_ns}\0{ctime}")
            if stat.S_ISDIR(info.st_mode):
                try:
                    stack.extend((child, name / child.name) for child in current.iterdir())
                except OSError:
                    records.append(f"{name}\0unreadable")
    digest = hashlib.sha256("\n".join(sorted(records)).encode("utf-8", "surrogateescape")).hexdigest()
    return entries, size, newest, digest


def rename_noreplace(source, target):
    """Rename that fails instead of replacing anything already at target: renamex_np with
    RENAME_EXCL on macOS, renameat2 with RENAME_NOREPLACE on Linux."""
    libc = ctypes.CDLL(None, use_errno=True)
    old, new = os.fsencode(source), os.fsencode(target)
    if sys.platform == "darwin":
        result = libc.renamex_np(old, new, ctypes.c_uint(0x4))
    else:
        result = libc.renameat2(-100, old, -100, new, ctypes.c_uint(0x1))
    if result != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error), str(target))


def move_aside(home, units, approved):
    """Move every unit into one private folder with one rename each, then check the moved tree
    against the reviewed inventory. Nothing is deleted here: a process that still has a folder open
    could write into it after any check, so Jan deletes the folder himself once he is sure. Any
    failure or mismatch moves everything back. Returns the folder."""
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    aside = home / f".work-wipe-{stamp}"
    aside.mkdir(mode=0o700)
    moved = []
    try:
        device = aside.lstat().st_dev
        if any(actual.lstat().st_dev != device for actual, _, _ in units):
            raise ValueError("An inventory path is on another volume")
        for index, (actual, shown, own) in enumerate(units):
            target = aside / str(index)
            mode = stat.S_IMODE(actual.lstat().st_mode)
            os.rename(actual, target)
            moved.append((target, shown, own))
            if not own:
                # ~/Work itself stays, empty.
                actual.mkdir(mode=mode)
        if summary(moved)[3] != approved:
            raise ValueError("The inventory changed while it was moved aside")
        (aside / "MOVED.txt").write_text("".join(f"{target.name}\t{shown}\n" for target, shown, _ in moved))
    except (OSError, ValueError) as error:
        kept = restore(aside, moved)
        raise ValueError(f"{error}. Nothing was deleted, " + (
            "and these stay where they are: " + ", ".join(kept) if kept else "everything is back in place")) from error
    return aside


def restore(aside, moved):
    """Move units back to their reviewed paths, never over anything that appeared there since.
    Returns those it could not, with both paths, and keeps the folder holding them."""
    kept = []
    for target, shown, own in reversed(moved):
        try:
            if not own:
                # The recreated empty ~/Work goes, rmdir fails if anything was written into it.
                shown.rmdir()
            rename_noreplace(target, shown)
        except OSError:
            kept.append(f"{target} (was {shown})")
    (aside / "MOVED.txt").unlink(missing_ok=True)
    if not kept:
        aside.rmdir()
    return kept


def wipe(home, host, really=False, migrated=False, inventory=None):
    paths = migrated_paths(home, host) if migrated else wipe_paths(home, host)
    # Check the complete inventory before deleting anything. A symlink leaf is unlinked, never
    # traversed. A symlink ancestor could escape the inventory and therefore fails closed.
    for path in paths:
        if not path.is_relative_to(home) or path.is_relative_to(home / "Development"):
            raise ValueError(f"Unsafe wipe path: {path}")
        if any(parent.is_symlink() for parent in path.parents if parent != home and parent.is_relative_to(home)):
            raise ValueError(f"Symlinked wipe ancestor: {path}")
    if migrated:
        units = migrated_units(home, paths)
        entries, size, newest, digest = summary(units)
        # Deletion is bound to the dry run Jan reviewed: anything added or changed since refuses.
        if really and inventory != digest:
            raise ValueError("The inventory changed since the reviewed dry run, or --inventory is missing. "
                             "Run the dry run again and review it")
    print(f"Host: {host}")
    if migrated:
        print("Moving the reviewed inventory aside" if really else "Dry run only, --really --inventory <hash> moves this aside")
    else:
        print("Deleting reviewed work inventory" if really else "Dry run only, deletion requires --really")
    for path in paths:
        print(path)
    if migrated:
        changed = datetime.fromtimestamp(newest, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") if newest else "none"
        print(f"Entries: {entries}, bytes: {size}, newest change: {changed}")
        print(f"Inventory: {digest}")
    if really and migrated:
        aside = move_aside(home, units, digest)
        print(f"Moved aside to {aside}, checked against the reviewed inventory. Nothing is deleted yet.")
        print(f"MOVED.txt there lists the original paths. Delete it yourself once sure: rm -rf '{aside}'")
        return
    if really:
        for path in paths:
            if path.is_symlink() or path.is_file():
                path.unlink()
            elif path.is_dir():
                shutil.rmtree(path)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true")
    mode.add_argument("--really", action="store_true")
    parser.add_argument("--migrated", action="store_true",
                        help="hermes only: just ~/Work contents and Work Pi sessions, which moved to sisyphus. "
                             "--really moves them aside into ~/.work-wipe-<time> and deletes nothing")
    parser.add_argument("--inventory", help="with --migrated --really: the Inventory hash of the reviewed dry run")
    args = parser.parse_args()
    if args.inventory and not args.migrated:
        parser.error("--inventory goes with --migrated")
    wipe(Path.home(), socket.gethostname().split(".")[0].lower(), args.really, args.migrated, args.inventory)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        print(f"work-wipe: {error}", file=sys.stderr)
        sys.exit(1)
