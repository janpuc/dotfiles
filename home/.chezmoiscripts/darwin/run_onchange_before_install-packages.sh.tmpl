{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env zsh

set -eufo pipefail

{{- $hostname := .hostname -}}
{{- $common := index .packages.common.darwin -}}
{{- $host := index .packages.hosts $hostname -}}
{{- $hostDarwin := dict -}}
{{- if $host -}}
{{-   $hostDarwin = $host.darwin | default dict -}}
{{- end }}

{{- /* Merge common and host-specific lists */ -}}
{{- $brews := $common.brews -}}
{{- if $hostDarwin.brews -}}
{{-   $brews = concat $brews $hostDarwin.brews -}}
{{- end }}

{{- $casks := $common.casks -}}
{{- if $hostDarwin.casks -}}
{{-   $casks = concat $casks $hostDarwin.casks -}}
{{- end }}

{{- $vscode := $common.vscode -}}
{{- if $hostDarwin.vscode -}}
{{-   $vscode = concat $vscode $hostDarwin.vscode -}}
{{- end }}

{{- /* A tap named in owner/tap/name must be in the Brewfile, or --force-cleanup tries to untap it. */ -}}
{{- $taps := list -}}
{{- range concat $brews $casks -}}
{{-   $parts := splitList "/" . -}}
{{-   if eq (len $parts) 3 -}}
{{-     $taps = append $taps (printf "%s/%s" (index $parts 0) (index $parts 1) | lower) -}}
{{-   end -}}
{{- end }}

brewfile=$(mktemp)
trap 'rm -f "$brewfile"' EXIT
cat >"$brewfile" <<EOF
{{ if eq .chezmoi.hostname "sisyphus" -}}
$(if [ ! -f "$HOME/.local/state/agents/model-wipe-approved" ]; then
    # Retain installed model packages until approval, never reinstall retired ones.
    if /opt/homebrew/bin/brew list --formula llama.cpp >/dev/null 2>&1; then printf '%s\n' 'brew "llama.cpp"'; fi
    if /opt/homebrew/bin/brew list --cask osaurus >/dev/null 2>&1; then printf '%s\n' 'cask "osaurus"'; fi
fi)
{{ end -}}
{{ range $taps | uniq -}}
tap {{ . | quote }}
{{ end -}}
{{ range $brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range $casks -}}
cask {{ . | quote }}
{{ end -}}
{{ range $vscode -}}
vscode {{ . | quote }}
{{ end -}}
EOF
# Install and upgrade first, remove what is not listed afterwards: the cleanup ends with
# brew cleanup, which fails on a keg it cannot delete.
/opt/homebrew/bin/brew bundle --file="$brewfile"
{{ if eq .chezmoi.hostname "sisyphus" -}}
# tailscaled runs as root (sudo brew services), so Homebrew makes the running keg's bin root-owned
# and brew cleanup cannot delete it after an upgrade. Restart the daemon on the new version, then
# remove the old root-owned kegs. Needs sudo, so it only completes in Jan's local chezmoi apply.
current=$(readlink /opt/homebrew/opt/tailscale 2>/dev/null || true)
stale=()
for keg in /opt/homebrew/Cellar/tailscale/*(N/); do
    [[ -n "$current" && "${keg:t}" != "${current:t}" ]] || continue
    if [[ -n "$(find "$keg" -user root -print -quit)" ]]; then stale+=("$keg"); fi
done
if (( ${#stale} )); then
    sudo /opt/homebrew/bin/brew services restart tailscale
    sudo rm -rf -- "${stale[@]}"
fi
{{ end -}}
/opt/homebrew/bin/brew bundle cleanup --file="$brewfile" --force
{{ end -}}
