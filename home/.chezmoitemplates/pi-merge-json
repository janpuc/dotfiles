# Shared body of the Pi modify_ scripts: merge the JSON in $managed into the
# file chezmoi pipes in on stdin and print the result. Keys Pi or the bridge
# write at runtime (lastChangelogVersion, startupNoticeShown, /settings choices,
# packages added with `pi install`) survive every apply; managed keys win.
# Resource lists (packages, extensions, prompts, skills, themes) are unions,
# managed entries first; a managed package replaces any other pinned version
# of the same package, an npm release and a git fork of it (same repo name) alike.
retired=${retired:-'[]'}
current=$(cat)
[[ -n ${current//[[:space:]]/} ]] || current='{}'
print -r -- $current | jq --argjson managed "$managed" --argjson retired "$retired" '
  def pkg: (if type == "object" then .source else . end) | tostring
    | if startswith("git:") then sub("^git:"; "") | split("@")[0] | split("/") | last | sub("\\.git$"; "")
      else sub("^npm:"; "")
        | if startswith("@") then (split("/") | .[0] + "/" + (.[1] | split("@")[0])) else split("@")[0] end end;
  . as $cur
  | ($cur * ($managed | del(.packages, .extensions, .prompts, .skills, .themes)))
  | if $managed.packages then
      .packages = $managed.packages + [($cur.packages // [])[]
        | select(pkg as $p | [$managed.packages[] | pkg] | index($p) | not)]
    else . end
  | if .packages then .packages |= map(select(pkg as $p | $retired | index($p) | not)) else . end
  | reduce ("extensions", "prompts", "skills", "themes") as $k (.;
      if $managed[$k] then
        .[$k] = $managed[$k] + [($cur[$k] // [])[] | select(. as $e | $managed[$k] | index($e) | not)]
      else . end)'
