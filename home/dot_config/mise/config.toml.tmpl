{{ if eq .chezmoi.hostname "sisyphus" -}}
# Host tools for the Work agent, including launchd's Python and backup binary.
[settings]
trusted_config_paths = ["~/Work"]

[tools]
node = "lts"
python = "latest"
restic = "latest"
"npm:@earendil-works/pi-coding-agent" = "latest"
{{ else -}}
# Global tools on the aether server (Linux only, see .chezmoiignore).
# Installed by `mise install` from the Linux script.
[settings]
trusted_config_paths = ["~/Development"]

[tools]
yq = "latest"
ripgrep = "latest"
uv = "latest"
"1password-cli" = "latest"                    # `op`, for ai-sync's GitHub login
chezmoi = "latest"
gh = "latest"                                 # git's credential helper
go = "latest"                                 # builds the agent command

# The shell, as on the laptop (config.fish, starship, atuin, bat, eza; difft for git).
starship = "latest"
atuin = "latest"
zoxide = "latest"
eza = "latest"
bat = "latest"
difftastic = "latest"

# Pi, set up as on the laptop (~/.pi/agent, the pi function, ai-sync's cache).
node = "lts"
"npm:@earendil-works/pi-coding-agent" = "latest"
# Model Studio's CLI: pi-usage reads the Alibaba Token Plan's monthly pool through its console
# login (`bl auth login --console --config token-plan --console-site international`, once).
"npm:bailian-cli" = "2.9.0"
# Codex CLI: pi-usage reads the ChatGPT Plus limits (Sol, Astra) through its app-server, after
# `codex login --device-auth` once. Pi's own ChatGPT token gets 401 on the usage endpoint.
"npm:@openai/codex" = "latest"
{{ end -}}
