#!/bin/sh
# work-op-pipe <op://Work/...> <command> [args...]: reads one Work vault field through the Work
# service account and hands it to <command> on stdin, so skills never parse the token themselves.
# The secret is never printed by this script or passed as an argument. Only op://Work/ references.
set -eu
[ $# -ge 2 ] || { echo "usage: work-op-pipe <op://Work/...> <command> [args...]" >&2; exit 2; }
ref=$1
shift
case "$ref" in
op://Work/*) ;;
*) echo "work-op-pipe: only op://Work/ references" >&2; exit 2 ;;
esac
token_file="$HOME/.config/op/sisyphus-work.env"
token=$(sed -n -E "s/^[[:space:]]*(export[[:space:]]+)?OP_SERVICE_ACCOUNT_TOKEN=//p" "$token_file" 2>/dev/null |
    head -n 1 | tr -d "\"'")
if [ -z "$token" ]; then
    echo "work-op-pipe: missing Work service account token in $token_file" >&2
    exit 1
fi
OP_SERVICE_ACCOUNT_TOKEN=$token
export OP_SERVICE_ACCOUNT_TOKEN
# Captured first so a failed read stops here instead of feeding an empty value to <command>.
value=$(op read "$ref" </dev/null)
unset token OP_SERVICE_ACCOUNT_TOKEN
[ -n "$value" ] || { echo "work-op-pipe: empty value" >&2; exit 1; }
printf '%s\n' "$value" | "$@"
