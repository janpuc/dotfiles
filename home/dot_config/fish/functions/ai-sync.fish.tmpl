function ai-sync --description "{{ if eq .chezmoi.os "linux" }}Log gh into GitHub and give Pi Pocket its model keys, from 1Password{{ else }}Fetch AI service credentials from 1Password into a local cache{{ end }}"
{{- if eq .chezmoi.os "linux" }}
    # The server reads 1Password through a read-only service account; its token lives in this
    # 0600 file, which is never managed or committed.
    if not set -q OP_SERVICE_ACCOUNT_TOKEN; and test -r "$HOME/.config/op/aether.env"
        # The file has comment lines; take the value of the one assignment. Function scope (-f):
        # a -l variable would end with this if block.
        set -fx OP_SERVICE_ACCOUNT_TOKEN (string match -rg '^\s*(?:export\s+)?OP_SERVICE_ACCOUNT_TOKEN=(.*)$' <"$HOME/.config/op/aether.env" | string trim -c '"\'')[1]
    end

    # git uses `gh auth git-credential`; gh stores its own token (0600).
    if op read "op://Kubernetes/aether/GH_TOKEN" 2>/dev/null | gh auth login --with-token 2>/dev/null
        echo "Logged gh into GitHub with the aether token."
    else
        echo "  ! could not log gh in with op://Kubernetes/aether/GH_TOKEN" >&2
        return 1
    end

    # Pi Pocket's model, memini, GitHub (aether's own token) and Home Assistant keys, for the pocket user only: a 0600 file its mise config loads into
    # the service. The 1Password token itself never reaches pocket.
    id pocket >/dev/null 2>&1; or return 0
    set -l NAMES OPENCODE_API_KEY MINIMAX_API_KEY ANTHROPIC_API_KEY MEMINI_API_KEY GH_TOKEN HA_TOKEN
    set -l PATHS op://Kubernetes/opencode/OPENCODE_GO_API_KEY op://Kubernetes/minimax/MINIMAX_API_KEY op://Kubernetes/claude/CLAUDE_API_KEY op://Kubernetes/memini/MEMINI_API_KEY_jan op://Kubernetes/aether/GH_TOKEN op://Kubernetes/hass-mcp/HASS_MCP_TOKEN
    set -l tmp (mktemp)
    chmod 600 $tmp
    for i in (seq (count $NAMES))
        set -l value (op read $PATHS[$i] 2>/dev/null)
        if test -z "$value"
            echo "  ! could not read $PATHS[$i]" >&2
            rm -f $tmp
            return 1
        end
        printf '%s=%s\n' $NAMES[$i] $value >>$tmp
    end
    sudo install -m 600 -o pocket -g pocket $tmp /home/pocket/.config/pi-pocket/secrets.env
    rm -f $tmp
    sudo systemctl try-restart pi-pocket.service
    echo "Gave Pi Pocket its model keys ($NAMES)."
{{- else }}
    set -q XDG_STATE_HOME; or set -l XDG_STATE_HOME "$HOME/.local/state"
    set -l CRED_FILE "$XDG_STATE_HOME/ai/credentials.fish"
    set -l tmp (mktemp)

    # label -> op reference. Read once here so no 1Password prompt fires on
    # every shell start / agent launch; re-run this after a key rotation.
    #
    # The OpenCode Go and MiniMax subscription keys are cached under PI_* names:
    # their standard names (OPENCODE_API_KEY, MINIMAX_API_KEY) would switch those
    # providers on in every tool that reads them. The pi launcher maps them to the
    # standard names for Personal Pi processes only. PI_OPENAI_API_KEY (scoped to
    # the Decisions API) is read by Pi's auto router only and never mapped.
    set -l NAMES MEMINI_API_KEY LITELLM_API_KEY PI_OPENCODE_API_KEY PI_MINIMAX_API_KEY PI_OPENAI_API_KEY
    set -l PATHS "op://Kubernetes/memini/MEMINI_API_KEY_jan" "op://Kubernetes/litellm/LITELLM_MASTER_KEY" "op://Kubernetes/opencode/OPENCODE_GO_API_KEY" "op://Kubernetes/minimax/MINIMAX_API_KEY" "op://Kubernetes/openai/OPENAI_API_KEY"

    echo "# Generated by ai-sync — do not edit, do not commit." >"$tmp"

    for i in (seq (count $NAMES))
        set -l name $NAMES[$i]
        set -l ref $PATHS[$i]
        echo "Fetching $name from 1Password..."
        set -l value (op read "$ref" 2>/dev/null)
        if test -z "$value"
            echo "  ! could not read $ref — skipping" >&2
            continue
        end
        printf 'set -gx %s %s\n' $name (string escape -- "$value") >>"$tmp"
        set -gx $name "$value"
    end

    if test (count (string match -r '^set ' <"$tmp")) -eq 0
        echo "Error: nothing fetched — is `op` signed in?" >&2
        rm -f "$tmp"
        return 1
    end

    mkdir -p (dirname "$CRED_FILE")
    mv "$tmp" "$CRED_FILE"
    chmod 600 "$CRED_FILE"
    echo "Wrote $CRED_FILE (0600) and exported into this shell."
{{- end }}
end
