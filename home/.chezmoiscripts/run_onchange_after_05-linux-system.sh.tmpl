{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Retires old system files on the aether server. Internal names (janpuc.com, internal) come from
# Tailscale split DNS to the UniFi gateway, so this removes the old /etc/hosts sync. The memory hold
# that kept Oracle from reclaiming the instance as idle is gone too: the project agents use well over
# 20% of RAM, which is the line Oracle checks. Re-runs when this file changes.
set -eu
if [ -e /etc/systemd/system/aether-hosts-sync.timer ]; then
  sudo systemctl disable --now aether-hosts-sync.timer
  sudo rm -f /etc/systemd/system/aether-hosts-sync.service /etc/systemd/system/aether-hosts-sync.timer /usr/local/sbin/aether-hosts-sync
  sudo rm -rf /var/lib/aether-hosts-sync
  sudo sed -i '/^# BEGIN aether-hosts-sync/,/^# END aether-hosts-sync/d' /etc/hosts
fi
if [ -e /etc/systemd/system/aether-keepalive.service ]; then
  sudo systemctl disable --now aether-keepalive.service
  sudo rm -f /etc/systemd/system/aether-keepalive.service /usr/local/sbin/aether-keepalive
  sudo systemctl daemon-reload
fi
{{- end }}
