#!/bin/sh
# Pi's settings. Pi writes the rest of settings.json itself (changelog, device id); those keys
# and any package added with `pi install` survive. A managed package replaces an installed one
# of the same name, whatever its version; retired packages are removed.
#
# Subagents (pi-subagents) pick their model per call; `subagents.modelScope` keeps them on the
# subscriptions meant for workers: no Opus, no OpenCode Zen. The agent defaults, used when a
# call names no model, are the cheapest that passed the eval; the advisor gets a fresh brief
# because a long session overflows Astra's 272K window when forked. Each agent's tool list
# decides what it can call.
#
# The usual agents open as a visible Pi in a background tab of the parent's Rex session
# (`machine: local`); `machine: sisyphus` or `aether` opens one in the `subagents` session there,
# over SSH (~/.ssh/config names both). A placed child cannot be handed local extension paths, so
# there is no `defaultExtensions`: every child loads its machine's packages, the bridge and
# pi-web-access among them, and agent-guard-child.ts turns the guard (no push, GitHub writes or
# cluster changes) on in children only.
# pi-subagents 0.84 checks a machine's cwd on the parent's disk as well (a bug), so each needs a
# path that exists on both ends: the shared home path on sisyphus, /tmp on aether.
set -eu
managed='{
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "enabledModels": ["claude-bridge/claude-opus-5-5", "claude-bridge/claude-sonnet-5-5"],
  "packages": [
    "npm:pi-claude-bridge@0.9.3",
    "npm:@eleboucher/pi-memini@0.7.38",
    "npm:pi-subagents@0.84.0",
    "npm:pi-web-access@0.46.0",
    "git:github.com/janpuc/pi-usage@v0.2.1",
    "git:github.com/janpuc/pi-title-spinner@v0.1.0",
    "git:github.com/janpuc/pi-footer@v0.1.0",
    "./local/pocket.ts",
    "./local/agent-guard-child.ts",
    "./local/rex-inspector.ts"
  ],
  "subagents": {
    "machines": {
      "sisyphus": { "rex": { "ssh": "sisyphus" }, "cwd": "/Users/jan.pucilowski" },
      "aether": { "rex": { "ssh": "aether" }, "cwd": "/tmp" }
    },
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "minimax/*",
        "opencode-go/*",
        "openai/gpt-6*",
        "openai/gpt-5.6-*",
        "claude-bridge/claude-sonnet-5-5",
        "claude-bridge/claude-fable-5-1",
        "litellm/m3pro*"
      ]
    },
    "agentOverrides": {
      "scout": {
        "model": "minimax/MiniMax-M3",
        "thinking": "medium",
        "machine": "local",
        "description": "Fast recon in a repo, a cluster, GitHub or the web (bash, gh, kubectl, web fetch); returns compressed context for handoff",
        "tools": ["read", "grep", "find", "ls", "bash", "write", "contact_supervisor", "web_search", "fetch_content", "get_search_content"]
      },
      "researcher": { "machine": "local", "model": "opencode-go/deepseek-v4.1-flash", "thinking": "medium" },
      "worker": { "machine": "local", "model": "opencode-go/deepseek-v4.1-flash", "thinking": "medium" },
      "reviewer": { "machine": "local", "model": "opencode-go/deepseek-v4.1-flash", "thinking": "high" },
      "oracle": { "machine": "local", "model": "openai/gpt-6-astra", "thinking": "high", "defaultContext": "fresh" },
      "delegate": { "disabled": true },
      "evidence-auditor": { "disabled": true },
      "claude-code": { "disabled": true },
      "claude-code-writer": { "disabled": true },
      "codex-exec": { "disabled": true },
      "codex-exec-writer": { "disabled": true },
      "cursor-agent": { "disabled": true },
      "cursor-agent-writer": { "disabled": true }
    }
  }
}'
retired='["pi-subagent-manager", "./local/claude-bridge-subagents.ts", "./local/agent-guard-placed.ts", "./local/bc250-quiet-hours.ts"]'
input=$(cat)
printf '%s' "${input:-"{}"}" | jq --argjson m "$managed" --argjson r "$retired" '
  def id: (if type == "object" then .source else . end) | sub("^(npm|git):"; "") | sub("@[^@/]*$"; "");
  ($m.packages | map(id)) as $ids
  | . * ($m | del(.packages))
  | del(.subagents.defaultExtensions)
  | .packages = $m.packages + [(.packages // [])[] | select(id as $i | ($ids + $r) | index($i) | not)]'
