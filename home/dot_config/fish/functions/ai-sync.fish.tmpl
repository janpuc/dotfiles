function ai-sync --description "Fetch AI credentials from 1Password into a local cache"
    # The servers (aether, sisyphus) read 1Password through a read-only service account; its token
    # lives in ~/.config/op/<host>.env (0600), which is never managed or committed. The laptop
    # has no such file and asks the 1Password app.
    set -l sa_env "$HOME/.config/op/{{ .hostname }}.env"
    if not set -q OP_SERVICE_ACCOUNT_TOKEN; and test -r "$sa_env"
        # The file has comment lines; take the value of the one assignment. Function scope (-f):
        # a -l variable would end with this if block.
        set -fx OP_SERVICE_ACCOUNT_TOKEN (string match -rg '^\s*(?:export\s+)?OP_SERVICE_ACCOUNT_TOKEN=(.*)$' <"$sa_env" | string trim -c '"\'')[1]
    end

    # gh logs in once with a token from 1Password and keeps it (the macOS keychain, or gh's own
    # 0600 file on Linux), so neither gh nor git's `gh auth git-credential` asks again; Pi's git
    # packages (pi-usage, pi-footer, pi-title-spinner) are private and clone through it. The
    # service account cannot read the Private vault, so the servers use the Kubernetes copy.
    # Like the keys below, re-run after a rotation.
    set -l gh_ref "op://Private/GitHub Personal Access Token/token"
    set -q OP_SERVICE_ACCOUNT_TOKEN; and set gh_ref "op://Kubernetes/aether/GH_TOKEN"
    if op read "$gh_ref" 2>/dev/null | command gh auth login --with-token 2>/dev/null
        echo "Logged gh into GitHub."
    else
        echo "  ! could not log gh in with $gh_ref; gh keeps its old token" >&2
    end

    set -q XDG_STATE_HOME; or set -l XDG_STATE_HOME "$HOME/.local/state"
    set -l CRED_FILE "$XDG_STATE_HOME/ai/credentials.fish"
    set -l tmp (mktemp)

    # label -> op reference. Read once here so no 1Password prompt fires on
    # every shell start / agent launch; re-run this after a key rotation.
    #
    # The OpenCode Go, MiniMax and Alibaba Token Plan subscription keys are cached under PI_*
    # names: their standard names (OPENCODE_API_KEY, MINIMAX_API_KEY, ALIBABA_API_KEY) would
    # switch those providers on in every tool that reads them. The Alibaba key is for interactive
    # agent use only (its terms forbid scripts and batch calls). The pi launcher maps them to the
    # standard names for Personal Pi processes only.
    # PI_OPENAI_API_KEY (scoped to the Decisions API) is read by Pi's auto router only and never
    # mapped.
    # LITELLM_API_KEY is Jan's own LiteLLM virtual key (jan-laptop, home-ops #1757), not the
    # master key, so the dashboard shows his use apart from the cluster's clients.
    # PI_CLAUDE_CODE_OAUTH_TOKEN is the one-year
    # `claude setup-token` login, which the pi function gives pi-claude-bridge's Claude Code only,
    # so no machine needs its own Claude login.
    set -l NAMES MEMINI_API_KEY LITELLM_API_KEY PI_OPENCODE_API_KEY PI_MINIMAX_API_KEY PI_ALIBABA_API_KEY PI_OPENAI_API_KEY PI_CLAUDE_CODE_OAUTH_TOKEN
    set -l PATHS "op://Kubernetes/memini/MEMINI_API_KEY_jan" "op://Kubernetes/litellm-jan-laptop/api_key" "op://Kubernetes/opencode/OPENCODE_GO_API_KEY" "op://Kubernetes/minimax/MINIMAX_API_KEY" "op://Kubernetes/alibaba/ALIBABA_API_KEY" "op://Kubernetes/openai/OPENAI_API_KEY" "op://Kubernetes/claude/CLAUDE_CODE_OAUTH_TOKEN"

    echo "# Generated by ai-sync — do not edit, do not commit." >"$tmp"

    for i in (seq (count $NAMES))
        set -l name $NAMES[$i]
        set -l ref $PATHS[$i]
        echo "Fetching $name from 1Password..."
        set -l value (op read "$ref" 2>/dev/null)
        if test -z "$value"
            echo "  ! could not read $ref — skipping" >&2
            continue
        end
        printf 'set -gx %s %s\n' $name (string escape -- "$value") >>"$tmp"
        set -gx $name "$value"
    end

    if test (count (string match -r '^set ' <"$tmp")) -eq 0
        echo "Error: nothing fetched — is `op` signed in?" >&2
        rm -f "$tmp"
        return 1
    end

    mkdir -p (dirname "$CRED_FILE")
    mv "$tmp" "$CRED_FILE"
    chmod 600 "$CRED_FILE"
    echo "Wrote $CRED_FILE (0600) and exported into this shell."
{{ if eq .chezmoi.os "linux" }}
    # Project dotenv files are separate from the shared credential cache above. Replace a
    # project's file only when every secret was fetched, keeping a previous good file on failure.
    set -l project_dir "$HOME/.local/state/ai/projects"
    mkdir -p "$project_dir"; or return 1
    chmod 700 "$project_dir"; or return 1
{{ range $project, $config := .projects }}
    set -l project_tmp (mktemp "$project_dir/.{{ $project }}.XXXXXX"); or return 1
    chmod 600 "$project_tmp"; or return 1
    set -l complete 1
{{ range $key, $ref := $config.secrets }}
    set -l value (op read --no-newline {{ $ref | quote }} 2>/dev/null | string collect --no-trim-newlines)
    if test -z "$value"; or string match -qr '[\r\n]' -- "$value"
        echo "Could not read single-line secret {{ $key }} for {{ $project }}, keeping its previous env file" >&2
        set complete 0
    else
        printf '%s' "$value" | python3 -c 'import json, sys; print(sys.argv[1] + "=" + json.dumps(sys.stdin.read(), ensure_ascii=False).replace("$", r"\$"))' {{ $key | quote }} >>"$project_tmp"
        or set complete 0
    end
{{ end }}
    if test "$complete" = 1
        mv "$project_tmp" "$project_dir/{{ $project }}.env"; or return 1
        echo "Wrote $project_dir/{{ $project }}.env (0600)."
    else
        rm -f "$project_tmp"
        return 1
    end
{{ end }}

    # The hourly restic backup and its alerts read their secrets from files by path, so no unit file
    # or environment holds one. Replace a file atomically only when every value was read: a failed
    # refresh keeps the previous good file and reports it. Neither file is managed or committed.
    set -l restic_dir "$HOME/.config/restic"
    set -l alert_dir "$HOME/.config/aether-backup"
    mkdir -p "$restic_dir" "$alert_dir"; or return 1
    chmod 700 "$restic_dir" "$alert_dir"; or return 1
    set -l restic_password (op read --no-newline op://Kubernetes/aether-backup/RESTIC_PASSWORD 2>/dev/null | string collect --no-trim-newlines)
    if test -z "$restic_password"; or string match -qr '[\r\n]' -- "$restic_password"
        echo "Could not read op://Kubernetes/aether-backup/RESTIC_PASSWORD, keeping the previous restic password" >&2
        return 1
    end
    set -l restic_tmp (mktemp "$restic_dir/.aether.password.XXXXXX"); or return 1
    chmod 600 "$restic_tmp"; or return 1
    printf '%s\n' "$restic_password" >"$restic_tmp"; or return 1
    mv "$restic_tmp" "$restic_dir/aether.password"; or return 1
    echo "Wrote $restic_dir/aether.password (0600)."

    set -l pushover_token (op read --no-newline op://Kubernetes/alertmanager/ALERTMANAGER_PUSHOVER_TOKEN 2>/dev/null | string collect --no-trim-newlines)
    set -l pushover_user (op read --no-newline op://Kubernetes/pushover/PUSHOVER_USER_KEY 2>/dev/null | string collect --no-trim-newlines)
    if test -z "$pushover_token"; or test -z "$pushover_user"; or string match -qr '[\r\n]' -- "$pushover_token$pushover_user"
        echo "Could not read the Pushover credentials, keeping the previous alert environment" >&2
        return 1
    end
    set -l pushover_tmp (mktemp "$alert_dir/.pushover.XXXXXX"); or return 1
    chmod 600 "$pushover_tmp"; or return 1
    printf 'PUSHOVER_TOKEN=%s\nPUSHOVER_USER_KEY=%s\n' "$pushover_token" "$pushover_user" >"$pushover_tmp"; or return 1
    mv "$pushover_tmp" "$alert_dir/pushover.env"; or return 1
    echo "Wrote $alert_dir/pushover.env (0600)."
{{ end }}
end
