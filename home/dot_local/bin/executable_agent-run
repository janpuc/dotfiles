#!/usr/bin/env python3
"""Project launcher and generation loop. Only Rex's pi tab runs the loop."""
import fcntl
import json
import os
from pathlib import Path
import re
import shlex
import socket
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone

HOME = Path.home()
ROOT = HOME / "Development"
CONFIG = HOME / ".config/agents/projects.json"
HOST = socket.gethostname().split(".")[0].lower()
HOST_CONFIG = {}
REGISTRY = {}
REMOTE_LIMIT = 32768

HELP = """agent: project agents on aether and sisyphus, dispatched over SSH from hermes

Projects
  ls                    List projects and status                 agent ls
  <project> | open       Open or start a project                  agent open home
  up                    Start every active project               agent up
  restart <project>|all Reload running agents on their sessions  agent restart all
  adopt <project>       Record an existing workspace             agent adopt home
  archive <project>     Stop a project and retain all files      agent archive home

Requests
  ask <project> <text>   Ask the system's owner                   agent ask dotfiles "Update the standards"
  reply <project> <id> <text>  Reply from the receiving project    agent reply home <id> "Verified"

Overview
  todo                  Open questions for Jan from every STATE.md   agent todo
  digest [hours]        Commits, pushes, merges, deploys, overrides  agent digest 48

Tasks
  task new [project] <TICKET|--slug slug> <brief>  Open a task      agent task new home --slug audit "Audit speakers"
  task ls [project]     List tasks and status                    agent task ls
  task ticket [project] <slug> <TICKET>  Attach a ticket            agent task ticket home audit HA-123
  task close [project] <id>    Request a result and knowledge fold agent task close home audit
  task restart [project] <id>  Resume the same task session        agent task restart home audit

Inside a project, task commands may omit the project. Close never deletes files.
Pi commands: /rotate checkpoints a project, /inbox lists requests, /reload reloads Pi.
Guide: docs/agents.md in janpuc/dotfiles.
"""


def project_host(config, project):
    return config["projects"][project].get("host", config["defaults"].get("host", "aether"))


def dispatch(config, args):
    """Hermes is a client only. Quote one remote command for the login shell."""
    if not args or args[0] != "--launch" or len(args) < 2:
        raise ValueError("The laptop only dispatches agent commands")
    command = args[1:]
    if command[:1] == ["open"] and len(command) == 2:
        command = command[1:]
    projects = config["projects"]
    sender = os.environ.get("PI_PROJECT")
    if not sender:
        try:
            root = "Work" if Path.cwd().resolve().is_relative_to(HOME / "Work") else "Development"
            candidate = Path.cwd().resolve().relative_to(HOME / root).parts[0]
            if candidate in projects:
                sender = candidate
        except (ValueError, IndexError):
            pass
    if sender and sender not in projects:
        raise ValueError(f"Unknown sender project: {sender}")
    if command[0] == "task" and len(command) >= 2 and command[1] != "ls":
        if len(command) < 3 or command[2] not in projects:
            if not sender:
                raise ValueError("Task commands need an explicit project outside a project")
            command.insert(2, sender)
    hosts = sorted({project_host(config, name) for name in projects}, key=lambda h: (h != "aether", h))
    if command in (["ls"], ["up"], ["restart", "all"], ["task", "ls"], ["todo"]) or command[0] == "digest":
        targets = hosts
    else:
        index = 2 if command[0] == "task" else 1 if command[0] in ("ask", "reply", "restart", "adopt", "archive") else 0
        if len(command) <= index or command[index] not in projects:
            raise ValueError("Use agent ls, <project>, ask, reply, restart all or task with a registered project")
        targets = [project_host(config, command[index])]
    for host in targets:
        if host not in config["hosts"] or not valid_name(host):
            raise ValueError(f"Unknown host: {host}")
        remote = ["env"]
        if sender:
            remote.append(f"PI_PROJECT={sender}")
        else:
            remote += ["-u", "PI_PROJECT"]
        remote += ["fish", "-lc", shlex.join(["python3", ".local/bin/agent-run"]) + " " +
                   shlex.join((["--client-jan"] if command[0] == "ask" and not sender else []) + ["--launch", *command])]
        if command in (["ls"], ["task", "ls"], ["todo"]) or command[0] == "digest":
            output = run("ssh", host, shlex.join(remote), stdout=subprocess.PIPE, text=True).stdout
            for line in output.splitlines():
                print(f"{host} {line}")
        else:
            run("ssh", host, shlex.join(remote))
    return 0


def run(*args, **kwargs):
    return subprocess.run([str(arg) for arg in args], check=True, **kwargs)


def rex(*args):
    return json.loads(run("rex", *args, stdout=subprocess.PIPE, text=True).stdout)


def unique(items, label):
    matches = [item for item in items if item.get("label") == label]
    if len(matches) > 1:
        raise ValueError(f"Multiple Rex resources labelled {label}, resolve them first")
    return matches[0] if matches else None


def generation(folder):
    path = folder / ".agent/generation"
    value = int(path.read_text().strip()) if path.exists() else 1
    if value < 1:
        raise ValueError(f"Invalid generation in {path}")
    return value


def atomic_write(path, text):
    temp = path.with_name(path.name + ".tmp")
    try:
        temp.write_text(text)
        temp.replace(path)
    finally:
        temp.unlink(missing_ok=True)


def consume_rotation(folder, recovering=False):
    state = folder / ".agent"
    requested = state / "rotate-requested"
    if not requested.exists():
        return False
    next_generation = int(requested.read_text().strip())
    current = generation(folder)
    if not (state / f"handoff-{next_generation}.md").is_file():
        raise ValueError("Rotation requested without a handoff")
    if next_generation == current and recovering:
        # The previous runner committed generation but stopped before removing the request.
        requested.unlink()
        return True
    if next_generation != current + 1:
        raise ValueError("Rotation request must name the next generation")
    atomic_write(state / "generation", f"{next_generation}\n")
    requested.unlink()
    return True


def task_state(folder, task):
    return folder / ".agent/tasks" / task


def running(folder, task=None):
    path = (task_state(folder, task) if task else folder / ".agent") / "run.lock"
    if not path.exists():
        return False
    with path.open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
    return False


def runner_pid(folder):
    path = folder / ".agent/run.lock"
    try:
        return int(path.read_text().strip())
    except (OSError, ValueError):
        return None


def pi_window(session, folder=None):
    windows = rex("session", "inspect", session, "--json")["windows"]
    if folder and (folder / ".agent/rex-window").is_file():
        wid = (folder / ".agent/rex-window").read_text().strip()
        matches = [window for window in windows if window.get("window_id") == wid]
        if matches:
            return matches[0]
    return unique(windows, "pi")


def valid_name(name):
    return isinstance(name, str) and re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9._-]*", name)


def platform_state():
    return HOME / ".local/state/agents"


def project_lock(name):
    path = platform_state() / "locks" / name
    path.parent.mkdir(parents=True, exist_ok=True)
    return path.open("a")


def initialization_path(name):
    return platform_state() / "initialized" / name


def record_initialization(name, origin, state="initialized"):
    path = initialization_path(name)
    path.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(path, json.dumps({"schemaVersion": 1, "project": name,
                                  "workspace": str(ROOT / name), "origin": origin,
                                  "state": state}, indent=2) + "\n")


def initialization(name):
    path = initialization_path(name)
    if not path.exists():
        return None
    try:
        record = json.loads(path.read_text())
    except ValueError as error:
        raise ValueError(f"{name}: invalid initialization record, restore needed: {path}") from error
    if (not isinstance(record, dict) or record.get("schemaVersion") != 1 or record.get("project") != name
            or record.get("workspace") != str(ROOT / name)
            or record.get("origin") not in ("bootstrap", "adopted")
            or record.get("state") not in ("initializing", "initialized")):
        raise ValueError(f"{name}: invalid initialization record, restore needed: {path}")
    return record


def lifecycle(name, project):
    path = platform_state() / "lifecycle" / name
    value = path.read_text().strip() if path.exists() else project.get("lifecycle", "active")
    if value not in ("active", "archived"):
        raise ValueError(f"{name}: invalid lifecycle {value}")
    return value


REQUEST_ID = re.compile(r"[0-9]{8}T[0-9]{6}-[0-9a-f]{6}")


def inbox(project):
    return ROOT / project / ".agent/inbox"


def request_id():
    return time.strftime("%Y%m%dT%H%M%S", time.gmtime()) + "-" + os.urandom(3).hex()


def request_time():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def request_target(projects, name):
    if name not in projects:
        raise ValueError(f"Unknown project: {name}")
    if lifecycle(name, projects[name]) == "archived":
        raise ValueError(f"{name}: archived, not taking requests")


def work_reply_queue():
    queue = platform_state() / "remote-inbox/work"
    if (not queue.resolve().is_relative_to(HOME.resolve())
            or queue.is_symlink() or any(parent.is_symlink() for parent in queue.parents
                                         if parent != HOME and parent.is_relative_to(HOME))):
        raise ValueError("Unsafe work reply queue")
    return queue


def write_request(target, item):
    # Replies wait on aether. Only work can fetch them, dotfiles never connects to sisyphus.
    folder = work_reply_queue() if target == "work" and HOST == "aether" else inbox(target)
    folder.mkdir(parents=True, exist_ok=True)
    atomic_write(folder / f"{item['id']}.json", json.dumps(item, ensure_ascii=False, indent=2) + "\n")


def ask(projects, target, text, client_jan=False):
    request_target(projects, target)
    sender = os.environ.get("PI_PROJECT", "")
    if client_jan:
        if sender:
            raise ValueError("A project session cannot send as jan")
        sender = "jan"
    if not sender:
        raise ValueError("agent ask must run inside a project agent, PI_PROJECT is unset")
    if sender != "jan" and sender not in projects:
        raise ValueError(f"Unknown sender project: {sender}")
    if sender == "jan" and not client_jan:
        raise ValueError("jan is reserved for the laptop client")
    if sender == target:
        raise ValueError("Cannot ask your own project, do the work yourself")
    remote = REGISTRY and project_host(REGISTRY, target) != HOST
    if remote and not (HOST == "sisyphus" and sender == "work"):
        raise ValueError("Only work may deliver remote requests to aether")
    if not remote and (not initialization(target) or not (ROOT / target).is_dir()):
        raise ValueError(f"{target}: workspace is not initialized yet")
    text = text.strip()
    if not text:
        raise ValueError("A request needs text")
    item = {"id": request_id(), "from": sender, "to": target, "text": text,
            "created": request_time(), "status": "new"}
    if remote:
        remote_call("deliver", item)
    else:
        write_request(target, item)
    log_action("a request", f"agent ask {target}: {text}")
    print(f"{target}: request {item['id']}")


def reply(projects, project, request, text):
    request_target(projects, project)
    sender = os.environ.get("PI_PROJECT", "")
    if sender != project:
        raise ValueError("agent reply must run in the project that received the request")
    if not REQUEST_ID.fullmatch(request):
        raise ValueError(f"Invalid request id: {request}")
    try:
        original = json.loads((inbox(project) / f"{request}.json").read_text())
    except (OSError, ValueError):
        raise ValueError(f"{project}: no request {request} in its inbox") from None
    if not isinstance(original, dict) or original.get("to") != project or original.get("id") != request:
        raise ValueError(f"{project}: no request {request} in its inbox")
    target = original.get("from")
    # Jan has no laptop inbox. His replies wait in the dotfiles project's ordinary inbox.
    target = "dotfiles" if target == "jan" else target
    request_target(REGISTRY["projects"] if REGISTRY else projects, target)
    text = text.strip()
    if not text:
        raise ValueError("A reply needs text")
    item = {"id": request_id(), "from": project, "to": target, "text": text,
            "created": request_time(), "status": "new", "inReplyTo": request}
    if len(json.dumps(item).encode()) > REMOTE_LIMIT - 1024:
        raise ValueError("Reply exceeds inbox payload limit")
    if HOST == "aether" and target == "work":
        write_request(target, item)
    elif REGISTRY and project_host(REGISTRY, target) != HOST:
        if HOST != "sisyphus" or project != "work":
            raise ValueError("Only work may deliver replies remotely")
        remote_call("deliver", item)
    else:
        write_request(target, item)
    log_action("a reply", f"agent reply {project} {request}: {text}")
    print(f"{target}: reply {item['id']} to request {request}")


def remote_call(operation, payload):
    if HOST != "sisyphus":
        raise ValueError("Only sisyphus uses the work inbox key")
    output = run("ssh", "-T", "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes",
                 "-o", "IdentityAgent=none", "-o", "ControlMaster=no", "-o", "ControlPath=none",
                 "-o", "StrictHostKeyChecking=yes", "-i", HOME / ".ssh/work-inbox", "aether", operation,
                 input=json.dumps(payload), stdout=subprocess.PIPE, text=True, timeout=15).stdout
    return json.loads(output)


MAIN_ENDPOINT = {"agent ls": ["--launch", "ls"], "agent restart all": ["--launch", "restart", "all"]}


def main_endpoint():
    """Forced SSH command for the dotfiles project's key (main-sisyphus) on sisyphus. Exactly three operations, no arguments."""
    operation = os.environ.get("SSH_ORIGINAL_COMMAND", "")
    if HOST != "sisyphus" or operation not in (*MAIN_ENDPOINT, "chezmoi update"):
        raise ValueError("main endpoint accepts only agent ls, agent restart all or chezmoi update on sisyphus")
    os.chdir(HOME)
    # No TTY: chezmoi scripts that need sudo fail and wait for Jan's local chezmoi apply.
    command = (["chezmoi", "--no-tty", "update"] if operation == "chezmoi update"
               else [sys.executable, str(Path(__file__).resolve()), *MAIN_ENDPOINT[operation]])
    return subprocess.run(command, stdin=subprocess.DEVNULL).returncode


def remote_inbox(config):
    """Forced SSH command. No shell, arbitrary paths or other operations are accepted."""
    operation = os.environ.get("SSH_ORIGINAL_COMMAND", "")
    if HOST != "aether" or operation not in ("deliver", "fetch"):
        raise ValueError("Remote inbox accepts only deliver or fetch on aether")
    raw = sys.stdin.read(REMOTE_LIMIT + 1)
    if len(raw.encode()) > REMOTE_LIMIT:
        raise ValueError("Remote inbox payload exceeds 32 KiB")
    payload = json.loads(raw)
    if not isinstance(payload, dict):
        raise ValueError("Remote inbox requires an object")
    if operation == "deliver":
        target = payload.get("to")
        if (payload.get("from") != "work" or not valid_name(target) or target not in config["projects"]
                or project_host(config, target) != "aether"
                or not isinstance(payload.get("id"), str) or not REQUEST_ID.fullmatch(payload["id"])
                or not isinstance(payload.get("text"), str) or not payload["text"].strip()
                or payload.get("status") != "new"):
            raise ValueError("Invalid work request")
        request_target(config["projects"], target)
        record = initialization(target)
        if not record or record["state"] != "initialized" or not (ROOT / target).is_dir():
            raise ValueError("Target workspace is not initialized")
        item = {key: payload[key] for key in ("id", "from", "to", "text", "status")}
        item["created"] = request_time()
        if "inReplyTo" in payload:
            if not isinstance(payload["inReplyTo"], str) or not REQUEST_ID.fullmatch(payload["inReplyTo"]):
                raise ValueError("Invalid reply id")
            item["inReplyTo"] = payload["inReplyTo"]
        path = inbox(target) / f"{item['id']}.json"
        if not path.exists():
            write_request(target, item)
        else:
            old = json.loads(path.read_text())
            if any(old.get(key) != item[key] for key in ("from", "to", "text")):
                raise ValueError("Request id already exists")
        print(json.dumps({"delivered": item["id"]}))
        return 0
    acknowledgements = payload.get("ack", [])
    if (set(payload) - {"ack"} or not isinstance(acknowledgements, list) or len(acknowledgements) > 128
            or any(not isinstance(item, str) or not REQUEST_ID.fullmatch(item) for item in acknowledgements)):
        raise ValueError("Invalid work reply acknowledgements")
    queue = work_reply_queue()
    for item in acknowledgements:
        (queue / f"{item}.json").unlink(missing_ok=True)
    items = []
    for path in sorted(queue.glob("*.json")):
        if path.is_symlink() or not path.is_file() or not REQUEST_ID.fullmatch(path.stem):
            raise ValueError("Invalid work reply queue entry")
        with path.open() as stream:
            raw = stream.read(REMOTE_LIMIT + 1)
        if len(raw.encode()) > REMOTE_LIMIT:
            raise ValueError("Work reply exceeds 32 KiB")
        item = json.loads(raw)
        if (not isinstance(item, dict) or item.get("to") != "work" or item.get("id") != path.stem
                or not isinstance(item.get("inReplyTo"), str) or not REQUEST_ID.fullmatch(item["inReplyTo"])):
            raise ValueError("Invalid work reply")
        if len(json.dumps(items + [item]).encode()) > REMOTE_LIMIT:
            break
        items.append(item)
    print(json.dumps(items))
    return 0


def fetch_replies():
    if HOST != "sisyphus" or os.environ.get("PI_PROJECT") != "work":
        raise ValueError("Only the work project may fetch replies")
    acknowledgements = platform_state() / "work-reply-acks.json"
    pending = json.loads(acknowledgements.read_text()) if acknowledgements.exists() else []
    items = remote_call("fetch", {"ack": pending})
    received = []
    for item in items:
        if (item.get("to") != "work" or not REQUEST_ID.fullmatch(item.get("id", ""))
                or not isinstance(item.get("text"), str)):
            raise ValueError("Invalid work reply")
        # Preserve a locally accepted or declined reply after an interrupted acknowledgement.
        if not (inbox("work") / f"{item['id']}.json").exists():
            write_request("work", item)
        received.append(item["id"])
    acknowledgements.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(acknowledgements, json.dumps(received) + "\n")
    return 0


def open_requests(name):
    folder = inbox(name)
    if not folder.is_dir():
        return []
    items = []
    for path in sorted(folder.glob("*.json")):
        try:
            item = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(item, dict) and item.get("status") == "new" and item.get("to") == name:
            items.append(item)
    return items


def restart(projects, action):
    if action == "all":
        targets = [name for name, project in projects.items()
                   if lifecycle(name, project) == "active" and running(ROOT / name)]
    else:
        request_target(projects, action)
        targets = [action]
    for name in targets:
        state = ROOT / name / ".agent"
        state.mkdir(parents=True, exist_ok=True)
        atomic_write(state / "restart-requested", f"{request_time()}\n")
    if action == "all":
        for name, project in projects.items():
            if lifecycle(name, project) != "active":
                continue
            for meta in task_records(ROOT / name):
                if meta["status"] != "closed" and running(ROOT / name, meta["id"]):
                    atomic_write(task_state(ROOT / name, meta["id"]) / "restart-requested", request_time() + "\n")
    print("restart requested: " + (", ".join(targets) if targets else "no running project agents"))


def git(folder, *args):
    return run("git", "-C", folder, *args, stdout=subprocess.PIPE, text=True).stdout.strip()


def require_git_root(folder):
    if folder.is_symlink() or not folder.is_dir():
        raise ValueError(f"Not a workspace directory: {folder}")
    if Path(git(folder, "rev-parse", "--show-toplevel")).resolve() != folder.resolve():
        raise ValueError(f"Not a Git root: {folder}")


def member_path(folder, name):
    if not valid_name(name) or name in ("notes", "plans", "scripts", "tasks"):
        raise ValueError(f"Invalid or reserved member name: {name}")
    target = folder / name
    if target.is_symlink() or target.resolve().parent != folder.resolve():
        raise ValueError(f"Member path escapes workspace: {target}")
    return target


def members(folder):
    path = folder / ".gitmodules"
    if path.is_symlink():
        raise ValueError(f"Symlinked membership file: {path}")
    if not path.exists():
        return []
    result = run("git", "config", "--null", "--file", path, "--list",
                 stdout=subprocess.PIPE, text=True).stdout
    entries = {}
    for entry in result.split("\0"):
        if not entry:
            continue
        key, _, value = entry.partition("\n")
        match = re.fullmatch(r"submodule\.(.+)\.(path|url|aether-local-only)", key)
        if not match:
            continue
        name, field = match.groups()
        values = entries.setdefault(name, {})
        if field in values:
            raise ValueError(f"Duplicate submodule field: {key}")
        values[field] = value
    paths = set()
    for name, entry in entries.items():
        if not valid_name(name) or "path" not in entry or not entry.get("url"):
            raise ValueError(f"Invalid submodule metadata: {name}")
        member_path(folder, entry["path"])
        if entry["path"] in paths:
            raise ValueError(f"Duplicate member path: {entry['path']}")
        paths.add(entry["path"])
        entry["name"] = name
        marker = entry.get("aether-local-only", "false")
        if marker not in ("true", "false"):
            raise ValueError(f"Invalid local-only marker: {name}")
        entry["localOnly"] = marker == "true"
        if entry["url"].startswith("local-only://") and not entry["localOnly"]:
            raise ValueError(f"Missing local-only marker: {name}")
    return list(entries.values())


def recorded_commit(folder, member):
    entry = git(folder, "ls-tree", "HEAD", "--", member["path"]).split()
    if len(entry) < 3 or entry[0] != "160000" or entry[1] != "commit":
        raise ValueError(f"{member['name']}: no committed gitlink, checkpoint the workspace first")
    return entry[2]


def restore_member(folder, member):
    target = member_path(folder, member["path"])
    if target.exists():
        require_git_root(target)
        return
    if member["localOnly"]:
        raise ValueError(f"{member['name']}: local-only member missing, restore needed from backup")
    commit = recorded_commit(folder, member)
    with tempfile.TemporaryDirectory(prefix=".agent-restore-", dir=folder.parent) as temp:
        checkout = Path(temp) / "repo"
        git(folder, "clone", "--no-checkout", "--", member["url"], checkout)
        available = subprocess.run(["git", "-C", str(checkout), "cat-file", "-e", f"{commit}^{{commit}}"],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if available.returncode:
            git(checkout, "fetch", "origin", commit)
        # This is a disposable clone, including if its default branch has this name.
        git(checkout, "checkout", "-B", "agent-restored", commit)
        if target.exists() or target.is_symlink():
            raise ValueError(f"Member appeared during recovery, leaving it alone: {target}")
        checkout.rename(target)


def register_repository(folder, project, name, url=None):
    """Register and stage membership. The caller explicitly commits the workspace checkpoint."""
    require_git_root(folder)
    target = member_path(folder, name)
    if any(m["name"] == name or m["path"] == name for m in members(folder)):
        raise ValueError(f"Member already registered: {name}")
    if not target.exists():
        with tempfile.TemporaryDirectory(prefix=".agent-register-", dir=folder.parent) as temp:
            checkout = Path(temp) / "repo"
            if url:
                git(folder, "clone", "--", url, checkout)
            else:
                git(folder, "init", "--initial-branch=main", checkout)
                git(checkout, "commit", "--allow-empty", "-m", "Initialize local repository")
            if target.exists() or target.is_symlink():
                raise ValueError(f"Member appeared during registration: {target}")
            checkout.rename(target)
    require_git_root(target)
    git(target, "rev-parse", "--verify", "HEAD^{commit}")
    path = folder / ".gitmodules"
    git(folder, "config", "--file", path, f"submodule.{name}.path", name)
    git(folder, "config", "--file", path, f"submodule.{name}.url",
        url or f"local-only://{project}/{name}")
    if not url:
        git(folder, "config", "--file", path, f"submodule.{name}.aether-local-only", "true")
    git(folder, "-c", "advice.addEmbeddedRepo=false", "add", "--", ".gitmodules", name)
    git(folder, "submodule", "init", "--", name)


def bootstrap(name, project):
    """Called under the external project lock, before Rex reconciliation."""
    ROOT.mkdir(parents=True, exist_ok=True)
    folder = ROOT / name
    record = initialization(name)
    if record:
        if record["state"] != "initialized" or not folder.is_dir():
            raise ValueError(f"{name}: restore needed, previously initialized workspace is missing or incomplete")
        require_git_root(folder)
        return folder
    if folder.exists() or folder.is_symlink():
        raise ValueError(f"{name}: adoption required: run agent adopt {name}")
    seeds = project.get("repos", [])
    names = [repo["name"] for repo in seeds]
    if len(names) != len(set(names)):
        raise ValueError(f"{name}: duplicate seed repository")
    for repo in seeds:
        member_path(folder, repo["name"])
    record_initialization(name, "bootstrap", "initializing")
    try:
        with tempfile.TemporaryDirectory(prefix=f".agent-init-{name}-", dir=ROOT) as temp:
            checkout = Path(temp) / name
            git(ROOT, "init", "--initial-branch=main", checkout)
            for path in ("notes/knowledge", "plans", "scripts", ".agent", ".worktrees"):
                (checkout / path).mkdir(parents=True, exist_ok=True)
            (checkout / ".gitignore").write_text(".agent/\n.worktrees/\n")
            (checkout / "notes/PROJECT.md").write_text(
                f"# {name}\n\n## Facts\n\n## Operating constraints\n\n## Systems\n\n## Knowledge index\n")
            (checkout / "notes/STATE.md").write_text(
                "# State\n\n## Current work\n\n## Verified state\n\n## Open threads\n\n## Pending approvals\n\n## Next actions\n")
            (checkout / "mise.toml").write_text(
                f'[env]\n_.file = "{HOME}/.local/state/ai/projects/{name}.env"\n'
                if project.get("secrets") else "# Project tools, tasks and non-secret environment\n")
            git(checkout, "add", "--", ".gitignore", "notes/PROJECT.md", "notes/STATE.md", "mise.toml")
            for repo in seeds:
                register_repository(checkout, name, repo["name"], repo.get("url"))
            git(checkout, "commit", "-m", "Initialize project workspace")
            if folder.exists() or folder.is_symlink():
                raise ValueError(f"{name}: workspace appeared during initialization")
            checkout.rename(folder)
        record_initialization(name, "bootstrap")
    except Exception:
        # If installation completed, keep the initializing record and require recovery.
        if not folder.exists():
            initialization_path(name).unlink(missing_ok=True)
        raise
    return folder


def repository_status(folder):
    result = []
    registered = members(folder)
    # Inspection also exposes ignored legacy repositories without registering them.
    known_paths = {member["path"] for member in registered}
    discovered = [{"name": path.name, "path": path.name, "unregistered": True}
                  for path in sorted(folder.iterdir())
                  if valid_name(path.name) and not path.is_symlink() and path.is_dir()
                  and path.name not in known_paths and (path / ".git").exists()]
    for member in registered + discovered:
        target = member_path(folder, member["path"])
        if not target.exists():
            result.append(f"{member['name']}:missing{'-local-only' if member['localOnly'] else ''}")
            continue
        require_git_root(target)
        dirty = bool(git(target, "status", "--porcelain"))
        head = subprocess.run(["git", "-C", str(target), "symbolic-ref", "-q", "--short", "HEAD"],
                              stdout=subprocess.PIPE, text=True)
        branch = head.stdout.strip() if head.returncode == 0 else "detached"
        upstream = subprocess.run(["git", "-C", str(target), "rev-parse", "--verify", "@{upstream}"],
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        ahead = git(target, "rev-list", "--count", "@{upstream}..HEAD") if upstream.returncode == 0 else "unknown"
        label = f"{member['name']}:" + ("unregistered," if member.get("unregistered") else "")
        result.append(f"{label}branch={branch},dirty={'yes' if dirty else 'no'},ahead={ahead}")
    return result


def adopt(name):
    with project_lock(name) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if initialization(name):
            raise ValueError(f"{name}: already has an initialization record")
        folder = ROOT / name
        require_git_root(folder)
        print(f"{name}: workspace dirty={'yes' if git(folder, 'status', '--porcelain') else 'no'}")
        for status in repository_status(folder):
            print(status)
        # Adoption deliberately does not migrate ignored legacy members or consume seeds.
        record_initialization(name, "adopted")


def require_agent_capacity():
    limit = HOST_CONFIG.get("maxAgents")
    if limit is None:
        return
    count = 0
    for name, project in REGISTRY.get("projects", {}).items():
        if project_host(REGISTRY, name) == HOST:
            count += int(running(ROOT / name))
            count += sum(running(ROOT / name, meta["id"]) for meta in task_records(ROOT / name))
    if count >= limit:
        raise ValueError(f"{HOST}: maxAgents={limit}, stop an agent first")


def ensure(name, project):
    with project_lock(name) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if lifecycle(name, project) == "archived":
            raise ValueError(f"{name}: archived, not starting")
        folder = bootstrap(name, project)
        if not running(folder):
            require_agent_capacity()
        for member in members(folder):
            restore_member(folder, member)
        state = folder / ".agent"
        state.mkdir(exist_ok=True)
        session = unique(rex("ls", "--json")["sessions"], name)
        command = ["--shell=none", "--keep-open", "--", "fish", "-lc",
                   f"exec python3 {shlex.quote(str(HOME / '.local/bin/agent-run'))} {shlex.quote(name)}"]
        if not session:
            terminal = {"block": {"flavor": "com.superlogical.terminal.shell", "options": {
                "cwd": str(folder), "shell": "none", "command": command[3:],
                "exit": {"on_completion": False}}}}
            created = rex("api", "call", "session.create", json.dumps({
                "label": name, "initial_windows": [
                    {"layout": terminal},
                    {"window_label": "shell", "layout": {"block": {
                        "flavor": "com.superlogical.terminal.shell", "options": {"cwd": str(folder)}}}}]}))
            sid = created["session_id"]
            atomic_write(state / "rex-window", created["initial_windows"][0]["window_id"] + "\n")
        else:
            sid = session["session_id"]
            window = pi_window(sid, folder)
            if not window:
                created = rex("window", "new", "-s", sid, "pi", "-c", folder, "--json", *command)
                atomic_write(state / "rex-window", created["window_id"] + "\n")
                rex("api", "call", "session.set_window_label", json.dumps({
                    "session_id": sid, "window_id": created["window_id"], "label": ""}))
            else:
                atomic_write(state / "rex-window", window["window_id"] + "\n")
                if window.get("label") == "pi":
                    rex("api", "call", "session.set_window_label", json.dumps({
                        "session_id": sid, "window_id": window["window_id"], "label": ""}))
            if window and not running(folder):
                blocks = [block for layer in window["layers"] for block in layer.get("blocks", [])]
                if len(blocks) != 1:
                    raise ValueError(f"{name}: pi tab has multiple blocks, leaving it alone")
                block = blocks[0]["block_id"]
                process = rex("block", "call", "-s", sid, "-b", block, "process")
                child = process.get("child")
                foreground = process.get("foreground")
                if child and not (child.get("name") in ("fish", "bash", "sh", "zsh")
                                  and (foreground or {}).get("pid") == child.get("pid")):
                    raise ValueError(f"{name}: pi tab has a live unmanaged process, leaving it alone")
                # Rex has no restart method. Replace only the stopped/idle terminal in the
                # existing window, not the window itself, so the pi tab is never duplicated.
                rex("run", "-s", sid, "-b", block, "--split=right", "-c", folder,
                    "--json", *command)
                run("rex", "block", "close", "-s", sid, block)
        windows = rex("session", "inspect", sid, "--json")["windows"]
        if not unique(windows, "shell"):
            rex("window", "new", "-s", sid, "shell", "-c", folder, "--focus=false", "--json")
    sessions = sorted(rex("ls", "--json")["sessions"], key=lambda s: (s.get("label") != "dotfiles", s.get("label", "")))
    for before, after in zip(reversed(sessions[:-1]), reversed(sessions[1:])):
        rex("api", "call", "session.move", json.dumps({
            "session_id": before["session_id"], "before_session_id": after["session_id"]}))
    clients = [c for c in rex("client", "ls", "--json")["clients"]
               if c.get("info", {}).get("kind") == "app" and c.get("connection_state") == "connected"]
    if len(clients) == 1:
        run("rex", "-C", clients[0]["client_id"], "do", "session.select", f"session_id={sid}",
            f"window_id={(folder / '.agent/rex-window').read_text().strip()}")
    elif clients:
        print(f"{name}: several Rex apps connected, not choosing one", file=sys.stderr)


def loop(name, project, defaults, task=None):
    folder = ROOT / name
    if task:
        read_task(folder, task)
    os.chdir(folder)
    state = task_state(folder, task) if task else folder / ".agent"
    state.mkdir(exist_ok=True)
    with (state / "run.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError(f"{name}: agent-run is already running")
        # Archive must prove the Rex block belongs to this runner before closing it.
        lock.seek(0)
        lock.truncate()
        lock.write(f"{os.getpid()}\n")
        lock.flush()
        env = dict(os.environ)
        # Load workspace plain env too (HA_URL is in mise.toml), then retain shims first.
        env.update(json.loads(run("mise", "env", "--json", stdout=subprocess.PIPE, text=True).stdout))
        env.update(PI_PROJECT=name, PI_PROJECT_DIR=str(folder), PI_PROJECT_ROOT=str(ROOT),
                   PI_GUARD_PROFILE=HOST_CONFIG.get("guard", "personal"),
                   MEMINI_NAMESPACE=project.get("meminiNamespace", f"{HOST_CONFIG.get('meminiPrefix', 'homelab')}/{name}"),
                   MEMINI_HOME=HOST_CONFIG.get("meminiHome", "personal/jan"))
        for key in ("MEMINI_NAMESPACE_PREFIX", "PI_TASK", "PI_TASK_DIR", "PI_TASK_STATE_DIR",
                    "OP_SERVICE_ACCOUNT_TOKEN"):
            env.pop(key, None)
        if env["MEMINI_HOME"] == "none":
            env.pop("MEMINI_HOME")
        cwd = folder
        if task:
            meta = read_task(folder, task)
            if meta["status"] == "closed":
                raise ValueError(f"{task}: closed")
            cwd = task_folder(folder, task)
            env.update(PI_TASK=task, PI_TASK_DIR=str(cwd), PI_TASK_STATE_DIR=str(state))
            os.chdir(cwd)
        secrets = HOME / f".local/state/ai/projects/{name}.env"
        if project.get("secrets"):
            # ai-sync writes JSON-quoted dotenv values with dollars escaped against expansion.
            loaded = set()
            for line in secrets.read_text().splitlines():
                key, value = line.split("=", 1)
                if key not in project["secrets"]:
                    raise ValueError(f"Unexpected secret key {key} in {secrets}")
                env[key] = json.loads(value.replace(r"\$", "$"))
                loaded.add(key)
            if any(key not in loaded for key in project["secrets"]):
                raise ValueError(f"Missing project secrets, run ai-sync: {secrets}")
        policies = [HOST_CONFIG.get("providers", "all"), project.get("providers", defaults.get("providers", "all"))]
        provider_keys = {
            "claude-bridge": ("PI_CLAUDE_CODE_OAUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY"),
            "openai": ("PI_OPENAI_API_KEY", "OPENAI_API_KEY"),
            "opencode-go": ("PI_OPENCODE_API_KEY", "OPENCODE_API_KEY"),
            "minimax": ("PI_MINIMAX_API_KEY", "MINIMAX_API_KEY"),
            "alibaba": ("PI_ALIBABA_API_KEY", "ALIBABA_API_KEY"),
            "litellm": ("LITELLM_API_KEY",),
        }
        for providers in policies:
            if providers == "all":
                continue
            if not isinstance(providers, list) or any(provider not in provider_keys for provider in providers):
                raise ValueError("Invalid providers policy")
            for provider, keys in provider_keys.items():
                if provider not in providers:
                    for key in keys:
                        env.pop(key, None)
        # Equivalent to `mise activate bash --shims`. Unlike real tool bin paths, a shim
        # resolves tools and [env] from each bash command's cwd, including nested repos.
        shims = Path(env.get("MISE_DATA_DIR", HOME / ".local/share/mise")) / "shims"
        env["PATH"] = f"{shims}:{env['PATH']}"
        model = project.get("model", defaults["model"])
        thinking = project.get("thinking", defaults["thinking"])
        # Recover either side of the generation commit after a runner crash or reboot.
        if not task:
            consume_rotation(folder, recovering=True)
        while True:
            if task and (state / "closed").exists():
                return 0
            # A restart marker left before this launch is stale. The extension or the CLI
            # writes one during a run, and the check after Pi exits relaunches it.
            (state / "restart-requested").unlink(missing_ok=True)
            n = 1 if task else generation(folder)
            if not task and not (state / "generation").exists():
                atomic_write(state / "generation", f"{n}\n")
            sid = f"{name}-task-{task}" if task else f"{name}-{n}"
            # Pi escapes cwd as --home-ubuntu-Development-home-- in its sessions tree.
            session_dir = HOME / ".pi/agent/sessions" / ("--" + re.sub(r"[/\\:]", "-", str(cwd).lstrip("/\\")) + "--")
            handoff = state / f"handoff-{n}.md"
            args = [HOME / ".pi/agent/local/bin/pi", "--session-id", sid, "--model", f"{model}:{thinking}"]
            if not list(session_dir.glob(f"*_{sid}.jsonl")):
                if task:
                    args.append(f"Work on task {task}. Read BRIEF.md and STATE.md. Follow tasks.md. "
                                f"Use branch task/{task} and .worktrees/<repo>/{task} only for repositories you need.")
                elif handoff.exists():
                    args.append(handoff.read_text())
            result = subprocess.run([str(arg) for arg in args], env=env)
            if not task and consume_rotation(folder):
                continue
            # A restart keeps the generation and session so the conversation resumes.
            if (state / "restart-requested").exists():
                continue
            return result.returncode


def archive(name):
    with project_lock(name) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if any(meta["status"] != "closed" for meta in task_records(ROOT / name)):
            raise ValueError(f"{name}: close open tasks before archiving")
        session = unique(rex("ls", "--json")["sessions"], name)
        if session:
            window = pi_window(session["session_id"], ROOT / name)
            if window:
                blocks = [b for layer in window["layers"] for b in layer.get("blocks", [])]
                if len(blocks) > 1:
                    raise ValueError(f"{name}: ambiguous pi tab, not archiving")
                if blocks:
                    block = blocks[0]["block_id"]
                    process = rex("block", "call", "-s", session["session_id"], "-b", block, "process")
                    child, foreground = process.get("child"), process.get("foreground")
                    idle_shell = (child and child.get("name") in ("fish", "bash", "sh", "zsh")
                                  and (foreground or {}).get("pid") == child.get("pid"))
                    managed = (child and running(ROOT / name)
                               and child.get("pid") == runner_pid(ROOT / name))
                    if child and not idle_shell and not managed:
                        raise ValueError(f"{name}: live unmanaged process or unknown runner PID, not archiving")
                    if child and not idle_shell:
                        # Keep an exited terminal in this window so closing its runner
                        # cannot remove the pi tab. A later launch can replace it.
                        rex("run", "-s", session["session_id"], "-b", block, "--split=right",
                            "-c", ROOT / name, "--json", "--shell=none", "--keep-open", "--", "true")
                        run("rex", "block", "close", "-s", session["session_id"], block)
        deadline = time.monotonic() + 5
        while running(ROOT / name):
            if time.monotonic() >= deadline:
                raise ValueError(f"{name}: runner did not stop, lifecycle unchanged")
            time.sleep(0.1)
        path = platform_state() / "lifecycle" / name
        path.parent.mkdir(parents=True, exist_ok=True)
        atomic_write(path, "archived\n")


TICKET = re.compile(r"[A-Z][A-Z0-9]{1,9}-[0-9]{1,7}")
SLUG = re.compile(r"[a-z0-9][a-z0-9-]{1,39}")
STATE_PAGE = "# State\n\n## Current work\n\n## Verified state\n\n## Open threads\n\n## Pending approvals\n\n## Next actions\n"


def task_folder(folder, task):
    if not isinstance(task, str) or not (TICKET.fullmatch(task) or SLUG.fullmatch(task)):
        raise ValueError(f"Invalid task identity: {task}")
    path = folder / "tasks" / task
    if path.is_symlink() or path.resolve().parent != folder.resolve() / "tasks" or (folder / "tasks").is_symlink():
        raise ValueError(f"Task path escapes workspace: {path}")
    state = task_state(folder, task)
    if state.is_symlink() or state.resolve().parent != folder.resolve() / ".agent/tasks":
        raise ValueError(f"Task state escapes workspace: {state}")
    return path


def read_task(folder, task):
    path = task_folder(folder, task)
    meta = json.loads((task_state(folder, task) / "meta.json").read_text())
    if not isinstance(meta, dict) or meta.get("id") != task or meta.get("status") not in ("open", "closing", "closed") or not path.is_dir():
        raise ValueError(f"{task}: invalid task state, restore needed")
    return meta


def task_records(folder):
    state = folder / ".agent/tasks"
    if not state.exists():
        return []
    return [read_task(folder, path.name) for path in sorted(state.iterdir()) if path.is_dir()]


def save_task(folder, meta):
    atomic_write(task_state(folder, meta["id"]) / "meta.json", json.dumps(meta, indent=2) + "\n")


def update_brief(folder, meta):
    path = task_folder(folder, meta["id"]) / "BRIEF.md"
    text = path.read_text()
    if not text.startswith("---\n") or "\n---\n" not in text[4:]:
        raise ValueError(f"{path}: missing task front matter")
    _, body = text[4:].split("\n---\n", 1)
    atomic_write(path, "---\n" + "\n".join(f"{key}: {meta.get(key) or 'none'}" for key in
                 ("id", "ticket", "opened", "status")) + "\n---\n" + body)


def start_task(name, task):
    folder = ROOT / name
    meta = read_task(folder, task)
    if meta["status"] == "closed":
        raise ValueError(f"{task}: closed")
    if running(folder, task):
        return
    require_agent_capacity()
    session = unique(rex("ls", "--json")["sessions"], name)
    if not session:
        raise ValueError(f"{name}: start the project first")
    sid = session["session_id"]
    window = unique(rex("session", "inspect", sid, "--json")["windows"], f"task:{task}")
    command = ["--shell=none", "--keep-open", "--", "fish", "-lc",
               "exec " + shlex.join(["python3", str(HOME / ".local/bin/agent-run"), "--task-run", name, task])]
    if not window:
        rex("window", "new", "-s", sid, f"task:{task}", "-c", task_folder(folder, task), "--focus=false", "--json", *command)
        return
    blocks = [block for layer in window["layers"] for block in layer.get("blocks", [])]
    if len(blocks) != 1:
        raise ValueError(f"{task}: ambiguous tab, leaving it alone")
    block = blocks[0]["block_id"]
    process = rex("block", "call", "-s", sid, "-b", block, "process")
    child, foreground = process.get("child"), process.get("foreground")
    if child and not (child.get("name") in ("fish", "bash", "sh", "zsh")
                      and (foreground or {}).get("pid") == child.get("pid")):
        raise ValueError(f"{task}: unmanaged process, leaving it alone")
    rex("run", "-s", sid, "-b", block, "--split=right", "-c", task_folder(folder, task), "--json", *command)
    run("rex", "block", "close", "-s", sid, block)


def finalize_task(name, task):
    """Idempotent close commit. No task, worktree or session data is ever deleted."""
    folder = ROOT / name
    meta = read_task(folder, task)
    state = task_state(folder, task)
    result = task_folder(folder, task) / "RESULT.md"
    if meta["status"] == "open" or not (state / "close-requested").exists():
        raise ValueError("Close was not requested")
    text = result.read_text()
    if any(not re.search(rf"^## {heading}\s*$", text, re.M) for heading in
           ("Outcome", "Changes", "Verification", "Learned", "Open")):
        raise ValueError("RESULT.md needs Outcome, Changes, Verification, Learned and Open headings")
    item = {"id": meta["foldRequest"], "from": name, "to": name, "kind": "fold", "task": task,
            "text": f"Fold task {task} from {result} into notes/PROJECT.md and notes/STATE.md. "
                    "Reconcile learned facts and open threads. Do not assume pending approvals were granted.",
            "created": request_time(), "status": "new"}
    if not (inbox(name) / f"{item['id']}.json").exists():
        write_request(name, item)
    meta["status"] = "closed"
    save_task(folder, meta)
    update_brief(folder, meta)
    atomic_write(state / "closed", request_time() + "\n")


def task_command(projects, defaults, args):
    if not args:
        raise ValueError("Usage: agent task new|ls|ticket|close|restart [project] ...")
    action, *rest = args
    if action == "ls" and not rest:
        for name in projects:
            for meta in task_records(ROOT / name):
                print(f"{name} {meta['id']} status={meta['status']} ticket={meta.get('ticket') or 'none'} "
                      f"pi={'yes' if running(ROOT / name, meta['id']) else 'no'} host={HOST}")
        return 0
    if rest and rest[0] in projects:
        name = rest.pop(0)
    else:
        name = os.environ.get("PI_PROJECT", "")
    request_target(projects, name)
    if action == "ls":
        if rest:
            raise ValueError("Usage: agent task ls [project]")
        return task_command({name: projects[name]}, defaults, ["ls"])
    if action == "new":
        ticket = None
        if len(rest) == 3 and rest[0] == "--slug" and SLUG.fullmatch(rest[1]):
            task, brief = rest[1:]
        elif len(rest) == 2 and TICKET.fullmatch(rest[0]):
            task, brief = rest
            ticket = task
        else:
            raise ValueError("Usage: agent task new [project] <TICKET-ID|--slug slug> <brief>")
        if not brief.strip():
            raise ValueError("A task needs a brief")
        ensure(name, projects[name])
        folder = ROOT / name
        with project_lock(name) as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            target = task_folder(folder, task)
            if target.exists() or task_state(folder, task).exists():
                raise ValueError(f"{task}: task identity already used, folders are never reused")
            limit = projects[name].get("tasks", {}).get("maxOpen", defaults.get("tasks", {}).get("maxOpen", 4))
            if sum(meta["status"] != "closed" for meta in task_records(folder)) >= limit:
                raise ValueError(f"{name}: maxOpen={limit}, close an existing task first")
            target.mkdir(parents=True)
            task_state(folder, task).mkdir(parents=True)
            meta = {"id": task, "ticket": ticket, "opened": request_time(), "status": "open"}
            (target / "BRIEF.md").write_text("---\nid: " + task + "\n---\n\n" + brief.strip() + "\n")
            (target / "STATE.md").write_text(STATE_PAGE)
            save_task(folder, meta)
            update_brief(folder, meta)
            start_task(name, task)
        print(f"{name}: task {task} opened")
        return 0
    if action not in ("ticket", "close", "restart", "finalize") or len(rest) != (2 if action == "ticket" else 1):
        raise ValueError("Usage: agent task ticket|close|restart [project] <id> [TICKET]")
    task = rest[0]
    folder = ROOT / name
    if action in ("close", "restart") and read_task(folder, task)["status"] != "closed":
        ensure(name, projects[name])
    with project_lock(name) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        meta = read_task(folder, task)
        state = task_state(folder, task)
        if action == "finalize":
            if os.environ.get("PI_PROJECT") != name or os.environ.get("PI_TASK") != task:
                raise ValueError("Only the task session may finalize its close")
            finalize_task(name, task)
        elif meta["status"] == "closed":
            if action != "close":
                raise ValueError(f"{task}: closed")
            finalize_task(name, task)
        elif action == "ticket":
            if not TICKET.fullmatch(rest[1]):
                raise ValueError("Invalid ticket identity")
            if meta.get("ticket") and meta["ticket"] != rest[1]:
                raise ValueError("A ticket is already attached")
            meta["ticket"] = rest[1]
            save_task(folder, meta)
            update_brief(folder, meta)
        elif action == "close":
            meta["status"] = "closing"
            meta.setdefault("foldRequest", request_id())
            save_task(folder, meta)
            update_brief(folder, meta)
            atomic_write(state / "close-requested", request_id() + "\n")
            start_task(name, task)
        elif action == "restart":
            if running(folder, task):
                atomic_write(state / "restart-requested", request_time() + "\n")
            else:
                start_task(name, task)
    print(f"{name}: task {task} {action}, folder retained")
    return 0


def action_log():
    return HOME / ".local/state/agents/actions.jsonl"


def log_action(what, detail):
    """Append to the action log the guard also writes. A log failure never stops the command."""
    try:
        path = action_log()
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600), "a") as log:
            log.write(json.dumps({"ts": datetime.now(timezone.utc).isoformat(timespec="seconds"), "host": HOST,
                                  "project": os.environ.get("PI_PROJECT"), "kind": "action", "what": what,
                                  "command": detail[:300]}) + "\n")
    except OSError:
        pass


def pending_questions(folder):
    """The bullets under STATE.md's Pending approvals heading, one string each."""
    try:
        lines = (folder / "notes/STATE.md").read_text().splitlines()
    except OSError:
        return []
    questions, inside = [], False
    for line in lines:
        if line.startswith("## "):
            inside = line[3:].strip().lower() == "pending approvals"
        elif inside and line.startswith("- "):
            questions.append(line[2:].strip())
        elif inside and line.startswith("  ") and questions:
            questions[-1] += " " + line.strip()
    return questions


def todo(projects):
    for name, project in projects.items():
        if lifecycle(name, project) != "active":
            continue
        for question in pending_questions(ROOT / name):
            print(f"{name}: {question}")


def digest(projects, hours=24):
    since = datetime.now(timezone.utc) - timedelta(hours=hours)
    actions = {}
    try:
        for line in action_log().read_text().splitlines():
            try:
                entry = json.loads(line)
                if not isinstance(entry, dict) or not isinstance(entry.get("ts"), str) or not entry.get("what"):
                    continue
                stamp = datetime.fromisoformat(entry["ts"].replace("Z", "+00:00"))
                if stamp.tzinfo is None:
                    stamp = stamp.replace(tzinfo=timezone.utc)
                if stamp >= since:
                    actions.setdefault(str(entry.get("project") or "-"), []).append(entry)
            except (ValueError, KeyError, TypeError, AttributeError):
                continue
    except OSError:
        pass
    out = [f"# {HOST} digest, last {hours} hours to {datetime.now().astimezone():%Y-%m-%d %H:%M %Z}", ""]
    for name in [*projects, *sorted(set(actions) - set(projects))]:
        folder, block = ROOT / name, []
        repos = [(name, folder)]
        if (folder / ".git").exists():
            try:
                repos += [(f"{name}/{m['path']}", folder / m["path"]) for m in members(folder)]
            except ValueError:
                pass
        for label, path in repos:
            if not (path / ".git").exists():
                continue
            log = subprocess.run(["git", "-C", str(path), "log", "--branches", f"--since={since.isoformat()}",
                                  "--format=%h %s", "-n", "30"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True).stdout
            block += [f"- commit {label} {line}" for line in log.splitlines()]
        for entry in actions.get(name, []):
            reason = f" (reason: {entry['reason']})" if entry.get("reason") else ""
            failed = " FAILED" if entry.get("ok") is False else ""
            block.append(f"- {entry.get('kind', 'action')} {entry.get('what')}{failed}{reason}: {entry.get('command', '')}")
        if block:
            out += [f"## {name}", *block, ""]
    if len(out) == 2:
        out.append("Nothing committed, pushed or overridden.")
    return "\n".join(out).rstrip() + "\n"


def list_projects(projects):
    sessions = rex("ls", "--json")["sessions"]
    for name, project in projects.items():
        folder = ROOT / name
        providers = project.get("providers", [])
        provider_status = ','.join(providers) if isinstance(providers, list) else str(providers)
        record = initialization(name)
        init = (record["state"] if folder.is_dir() else "restore-needed") if record else (
            "needs-adopt" if folder.exists() else "new")
        session = unique(sessions, name)
        restart_marker = " restart=pending" if (folder / ".agent/restart-requested").exists() else ""
        print(f"{name} lifecycle={lifecycle(name, project)} init={init} "
              f"folder={'yes' if folder.is_dir() else 'no'} "
              f"rex={session['session_id'] if session else 'no'} "
              f"pi={'yes' if running(folder) else 'no'} generation={generation(folder)} "
              f"requests={len(open_requests(name))}{restart_marker} "
              f"host={HOST} providers={provider_status} "
              f"tasks={sum(meta['status'] != 'closed' for meta in task_records(folder))}")
        if folder.is_dir():
            for status in repository_status(folder):
                print(f"  {status}")
    if ROOT.exists():
        for folder in sorted(ROOT.iterdir()):
            if folder.is_dir() and folder.name not in projects:
                print(f"{folder.name} unregistered path={folder}")


def main():
    global ROOT, HOST_CONFIG, REGISTRY
    args = sys.argv[1:]
    if not args or args in (["--launch"], ["--launch", "help"], ["--launch", "-h"], ["--launch", "--help"],
                            ["--launch", "task"], ["--launch", "task", "-h"], ["--launch", "task", "--help"],
                            ["-h"], ["--help"], ["help"]):
        print(HELP)
        return 0
    if args[:2] == ["--launch", "open"]:
        if len(args) != 3:
            print(HELP)
            return 2
        sys.argv[2:] = [args[2]]
    if sys.platform == "darwin" and HOST == "sisyphus":
        os.environ["PATH"] = os.pathsep.join([
            str(HOME / ".local/share/mise/shims"), "/opt/homebrew/bin",
            "/Applications/Rex Beta.app/Contents/Helpers/Rex Server.rex/Contents/MacOS",
            os.environ.get("PATH", "/usr/bin:/bin")])
    # Before the registry read, so a broken registry can still be repaired by chezmoi update.
    if sys.argv[1:] == ["--main-endpoint"]:
        return main_endpoint()
    config = json.loads(CONFIG.read_text())
    REGISTRY = config
    if sys.platform == "darwin" and HOST == "hermes":
        return dispatch(config, sys.argv[1:])
    if HOST not in config["hosts"]:
        raise ValueError(f"Host {HOST} is not registered as an execution host")
    HOST_CONFIG = config["hosts"][HOST]
    ROOT = Path(HOST_CONFIG["root"]).expanduser().resolve()
    projects = {name: project for name, project in config["projects"].items()
                if project_host(config, name) == HOST}
    if sys.argv[1:] == ["--remote-inbox"]:
        return remote_inbox(config)
    if sys.argv[1:] == ["--fetch-replies"]:
        return fetch_replies()
    if sys.argv[1:] == ["--digest-daily"]:
        digests = HOME / ".local/state/agents/digest"
        digests.mkdir(parents=True, exist_ok=True)
        path = digests / f"{datetime.now():%Y-%m-%d}.md"
        atomic_write(path, digest(projects))
        print(path)
        return 0
    client_jan = len(sys.argv) > 1 and sys.argv[1] == "--client-jan"
    if client_jan:
        sys.argv.pop(1)
        if sys.argv[1:3] != ["--launch", "ask"]:
            raise ValueError("--client-jan is only for laptop requests")
    reserved = ("up", "ls", "archive", "adopt", "ask", "reply", "restart", "task", "jan", "open", "help", "todo", "digest")
    if any(not valid_name(name) or name in reserved for name in projects):
        raise ValueError("Project names must be single path components and not reserved command names or jan")
    for name, project in projects.items():
        lifecycle(name, project)
    if len(sys.argv) >= 3 and sys.argv[1] == "--launch":
        action = sys.argv[2]
        if action == "task":
            return task_command(projects, config["defaults"], sys.argv[3:])
        if action in ("archive", "adopt"):
            if len(sys.argv) != 4 or sys.argv[3] not in projects:
                raise ValueError(f"Usage: agent {action} <registered-project>")
            (archive if action == "archive" else adopt)(sys.argv[3])
            return 0
        if action == "ask":
            if len(sys.argv) < 5:
                raise ValueError("Usage: agent ask <project> <text>")
            ask(config["projects"], sys.argv[3], " ".join(sys.argv[4:]), client_jan=client_jan)
            return 0
        if action == "reply":
            if len(sys.argv) < 6:
                raise ValueError("Usage: agent reply <project> <id> <text>")
            if sys.argv[3] not in projects:
                raise ValueError("Replies must originate on this project's host")
            reply(config["projects"], sys.argv[3], sys.argv[4], " ".join(sys.argv[5:]))
            return 0
        if action == "todo" and len(sys.argv) == 3:
            todo(projects)
            return 0
        if action == "digest" and len(sys.argv) in (3, 4):
            if len(sys.argv) == 4 and not sys.argv[3].isdigit():
                raise ValueError("Usage: agent digest [hours]")
            print(digest(projects, int(sys.argv[3]) if len(sys.argv) == 4 else 24), end="")
            return 0
        if action == "restart":
            if len(sys.argv) != 4:
                raise ValueError("Usage: agent restart <project>|all")
            restart(projects, sys.argv[3])
            return 0
        if len(sys.argv) != 3:
            raise ValueError("Usage: agent <project>|up|ls|archive <project>|adopt <project>|restart <project>|all")
        if action == "ls":
            list_projects(projects)
            return 0
        names = [name for name, project in projects.items() if lifecycle(name, project) == "active"] if action == "up" else [action]
        for name in names:
            if name not in projects:
                raise ValueError(f"Unknown project: {name}")
            ensure(name, projects[name])
        return 0
    if len(sys.argv) in (4, 5) and sys.argv[1] == "--register":
        name, member = sys.argv[2:4]
        if name not in projects:
            raise ValueError(f"Unknown project: {name}")
        with project_lock(name) as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            record = initialization(name)
            if not record or record["state"] != "initialized" or not (ROOT / name).is_dir():
                raise ValueError(f"{name}: initialization or restore needed")
            register_repository(ROOT / name, name, member, sys.argv[4] if len(sys.argv) == 5 else None)
        return 0
    if len(sys.argv) == 4 and sys.argv[1] == "--task-run":
        name, task = sys.argv[2:]
        request_target(projects, name)
        return loop(name, projects[name], config["defaults"], task=task)
    if len(sys.argv) != 2 or sys.argv[1] not in projects:
        raise ValueError("Usage: agent-run <registered-project>")
    name = sys.argv[1]
    if lifecycle(name, projects[name]) == "archived":
        raise ValueError(f"{name}: archived, not starting")
    record = initialization(name)
    if not record or record["state"] != "initialized" or not (ROOT / name).is_dir():
        raise ValueError(f"{name}: initialization or restore needed, use agent {name}")
    return loop(name, projects[name], config["defaults"])


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"agent: {error}", file=sys.stderr)
        if isinstance(error, ValueError):
            print(HELP, file=sys.stderr)
        sys.exit(1)
