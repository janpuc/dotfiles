diff -ruN a/src/trailing-user.ts b/src/trailing-user.ts
--- a/src/trailing-user.ts	1970-01-01 01:00:00.000000000 +0100
+++ b/src/trailing-user.ts	2026-11-22 19:06:15.790199814 +0100
@@ -0,0 +1,37 @@
+// Local patch (janpuc/dotfiles): pi appends extension messages from before_agent_start after the
+// user's prompt, and they reach the provider as user messages too. agy gets one prompt per turn, so
+// the prompt is every user message after the last assistant or tool result, in order. Reading only
+// the last one sent agy the extension's block and left the user's own words to the digest.
+// floor is the first index the run may use, so a compaction summary stays with the digest.
+
+type Block = { type: string; text?: string; data?: string; mimeType?: string };
+type Message = { role: string; content: string | Block[] };
+
+/** Index of the first message in the run of user messages that ends the transcript. */
+export function trailingUserStart(messages: readonly Message[], floor = 0): number {
+	let start = messages.length;
+	while (start > floor && messages[start - 1]?.role === "user") start--;
+	return start;
+}
+
+/** The trailing user messages flattened to one prompt, or null when there is no text. */
+export function trailingUserText(messages: readonly Message[], floor = 0): string | null {
+	const parts: string[] = [];
+	for (const m of messages.slice(trailingUserStart(messages, floor))) {
+		const text = typeof m.content === "string"
+			? m.content
+			: m.content.filter((b) => b.type === "text").map((b) => b.text ?? "").join("\n");
+		if (text.trim()) parts.push(text.trim());
+	}
+	return parts.length ? parts.join("\n\n") : null;
+}
+
+/** Image blocks of the trailing user messages. */
+export function trailingUserImages(messages: readonly Message[], floor = 0): Array<{ data: string; mimeType: string }> {
+	const images: Array<{ data: string; mimeType: string }> = [];
+	for (const m of messages.slice(trailingUserStart(messages, floor))) {
+		if (typeof m.content === "string") continue;
+		for (const b of m.content) if (b.type === "image") images.push({ data: b.data ?? "", mimeType: b.mimeType ?? "" });
+	}
+	return images;
+}
