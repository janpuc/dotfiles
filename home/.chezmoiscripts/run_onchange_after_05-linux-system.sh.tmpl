{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# System files for the aether server: the memory hold that keeps Oracle from reclaiming the
# instance as idle. Internal names (janpuc.com, internal) come from Tailscale split DNS to the
# UniFi gateway, so this also retires the old /etc/hosts sync if it is still installed.
# Re-runs when they change.
#   keepalive {{ include ".system/aether-keepalive" | sha256sum }} {{ include ".system/aether-keepalive.service" | sha256sum }}
set -eu
src={{ joinPath .chezmoi.sourceDir ".system" | quote }}
if [ -e /etc/systemd/system/aether-hosts-sync.timer ]; then
  sudo systemctl disable --now aether-hosts-sync.timer
  sudo rm -f /etc/systemd/system/aether-hosts-sync.service /etc/systemd/system/aether-hosts-sync.timer /usr/local/sbin/aether-hosts-sync
  sudo rm -rf /var/lib/aether-hosts-sync
  sudo sed -i '/^# BEGIN aether-hosts-sync/,/^# END aether-hosts-sync/d' /etc/hosts
fi
sudo install -m 755 "$src/aether-keepalive" /usr/local/sbin/
sudo install -m 644 "$src/aether-keepalive.service" /etc/systemd/system/
sudo systemctl daemon-reload
sudo systemctl enable aether-keepalive.service
sudo systemctl restart aether-keepalive.service
{{- end }}
