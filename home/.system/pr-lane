#!/usr/bin/env node
// Deterministic, uncached home-ops PR policy. All evidence is bound to the current head.
'use strict';
const { execFileSync } = require('node:child_process');
const REPO = 'janpuc/home-ops';
const ROOT = `repos/${REPO}`;
const PROTECTED = ['kube-system', 'flux-system', 'network', 'security', 'cnpg-system',
    'miroir-system', 'kopiur-system', 'external-secrets', 'cert-manager'];
function api(path, pages = false) {
    const args = ['api', path];
    if (pages) args.push('--paginate', '--slurp');
    const value = JSON.parse(execFileSync('gh', args, { encoding: 'utf8', timeout: 20000,
        maxBuffer: 32 * 1024 * 1024, stdio: ['ignore', 'pipe', 'pipe'] }));
    return pages ? value.flat() : value;
}
async function konflate(path) {
    const response = await fetch(`https://konflate.janpuc.com/api/${path}`, { signal: AbortSignal.timeout(20000) });
    if (!response.ok) throw Error(`konflate HTTP ${response.status}`);
    return response.json();
}
function parseReview(pr, status, comments) {
    const comment = comments.filter(c => c.user?.login === 'bot-atlas[bot]' &&
        c.body?.includes(`<!-- kritika:pr-${pr.number} -->`))
        .sort((a, b) => b.updated_at.localeCompare(a.updated_at))[0];
    const body = comment?.body || '';
    const reviewed = body.match(/Last reviewed commit:[^\n]*\/commit\/([a-f0-9]{40})\)/i)?.[1];
    const line = body.match(/\*\*Confidence ([1-5])\/5\*\*\s*·\s*(low|medium|high) risk\b/i);
    const confidence = Number(status?.description?.match(/confidence ([1-5])\/5/i)?.[1]);
    const findings = body.match(/^\*\*(No findings|\d+ findings?)\*\*/im);
    let p1 = null, findingsError = null;
    if (findings) {
        const total = /^No findings$/i.test(findings[1]) ? 0 : Number.parseInt(findings[1], 10);
        // Counts can wrap onto subsequent lines; never read counts from the review details.
        const summary = body.slice(findings.index + findings[0].length)
            .split(/\*\*Confidence\b|\n(?=\*\*|Last reviewed commit:|<!--)/i)[0].trim();
        const counts = [...summary.matchAll(/\b(\d+) P(\d)\b/g)];
        const remainder = summary.replace(/\b\d+ P\d\b/g, '').replace(/[\s·]/g, '');
        if (total === 0) p1 = 0; // Explicit zero, not a default for an unreadable summary.
        else if (!Number.isSafeInteger(total) || !counts.length || remainder ||
            counts.some(c => !Number.isSafeInteger(Number(c[1]))) ||
            new Set(counts.map(c => c[2])).size !== counts.length ||
            counts.reduce((sum, c) => sum + Number(c[1]), 0) !== total)
            findingsError = 'kritika severity counts missing, unparseable or do not sum to findings total';
        // Only a complete, validated distribution can prove that there are no P1 findings.
        else p1 = Number(counts.find(c => c[2] === '1')?.[1] ?? 0);
    }
    return { state: status?.state ?? null, description: status?.description ?? null,
        reviewedHead: reviewed ?? null, confidence: confidence || null,
        risk: line?.[2]?.toLowerCase() ?? null, p1, findingsError,
        parsed: Boolean(line && findings && !findingsError && confidence && confidence === Number(line[1])),
        commentUrl: comment?.html_url ?? null };
}
function classify({ pr, files, statuses, checks, comments, entry, rendered, errors = [] }) {
    const waiting = [...errors], caution = [], automatic = [], notes = [];
    const labels = pr.labels.map(l => typeof l === 'string' ? l : l.name);
    const kritikaStatus = statuses.find(s => s.context === 'Kritika / Review');
    const kritika = parseReview(pr, kritikaStatus, comments);
    const signals = entry?.signals, rawImpact = rendered?.diff?.impact;
    const namespacesNormalizedFromNull = rawImpact?.namespaces === null && rawImpact.resources === 0;
    const impact = namespacesNormalizedFromNull ? { ...rawImpact, namespaces: [] } : rawImpact;
    if (namespacesNormalizedFromNull) notes.push('konflate zero-resource namespaces:null treated as empty');
    if (pr.state !== 'open') waiting.push('PR is not open');
    if (pr.draft) waiting.push('draft PR');
    if (statuses.some(s => s.state === 'pending') || checks.some(c => c.status !== 'completed'))
        waiting.push('check or status pending');
    if (!kritikaStatus) waiting.push('kritika missing for head');
    else if (kritika.state === 'pending') waiting.push('kritika pending for head');
    else if (kritika.state !== 'success') caution.push(kritika.state === 'error'
        ? 'kritika review incomplete' : `kritika state is ${kritika.state}, not success`);
    if (kritika.findingsError) waiting.push(kritika.findingsError);
    if (kritika.state === 'success') {
        if (kritika.reviewedHead !== pr.head.sha) waiting.push('kritika comment missing or stale for head');
        if (!kritika.parsed) waiting.push('kritika confidence/risk/findings unparseable or missing');
    }
    if (!entry) waiting.push('konflate missing');
    else {
        if (entry.status !== 'ready' || rendered?.status !== 'ready') waiting.push('konflate not ready');
        if (entry.headSha !== pr.head.sha || rendered?.diff?.headSha !== pr.head.sha || rendered?.pr?.headSha !== pr.head.sha)
            waiting.push('konflate stale for head');
    }
    const count = n => Number.isInteger(n) && n >= 0;
    if (!signals || !['resources', 'caution', 'blocking', 'images', 'failures'].every(k => count(signals[k])) ||
        typeof signals.routine !== 'boolean' || !impact ||
        !['resources', 'parents', 'crds'].every(k => count(impact[k])) ||
        !Array.isArray(impact.namespaces) || !impact.namespaces.every(n => typeof n === 'string') ||
        !(rendered?.diff?.warnings === null || Array.isArray(rendered?.diff?.warnings)))
        waiting.push('konflate schema incomplete');
    if (pr.user.login !== 'bot-atlas[bot]') caution.push('author is not bot-atlas');
    for (const group of ['talos', 'kubernetes']) {
        if (new RegExp(`\\b${group}(?:[\\s/_-]+group)?\\b`, 'i').test([pr.title, ...labels].join(' ')))
            caution.push(`${group} group named in title or labels`);
    }
    if (impact?.crds > 0) caution.push('konflate impact.crds > 0');
    for (const key of ['blocking', 'failures']) if (signals?.[key] > 0) caution.push(`konflate ${key} > 0`);
    if (kritika.risk === 'high') caution.push('kritika high risk');
    if (kritika.p1 > 0) caution.push('kritika P1 finding');
    if (kritika.confidence !== null && kritika.confidence < 3) caution.push('kritika confidence < 3');
    for (const ns of PROTECTED) {
        if (files.some(p => p.startsWith(`kubernetes/apps/${ns}/`))) caution.push(`protected namespace path: ${ns}`);
        if (impact?.namespaces?.includes(ns)) caution.push(`protected impact namespace: ${ns}`);
    }
    if (files.some(p => p.startsWith('kubernetes/apps/ai/litellm'))) caution.push('protected litellm path');
    for (const prefix of ['talos/', 'bootstrap/', '.github/', 'kubernetes/flux/', 'kubernetes/components/'])
        if (files.some(p => p.startsWith(prefix))) caution.push(`protected path: ${prefix}`);
    if (labels.includes('type/major') && files.some(p => p === '.renovaterc.json5' || p.startsWith('.mise')))
        caution.push('major Renovate or mise configuration change');
    for (const status of statuses.filter(s => s.context !== 'Kritika / Review' && ['error', 'failure'].includes(s.state)))
        caution.push(`failed status: ${status.context} (${status.state})`);
    for (const check of checks.filter(c => c.status === 'completed' && !['success', 'skipped', 'neutral'].includes(c.conclusion)))
        caution.push(`failed check: ${check.name} (${check.conclusion})`);
    if (labels.some(l => ['type/digest', 'type/patch'].includes(l))) automatic.push('digest/patch label');
    if (signals?.routine === true && signals.caution === 0) automatic.push('konflate routine with caution=0');
    if (kritika.confidence >= 4 && kritika.risk === 'low' && kritika.p1 === 0)
        automatic.push('kritika confidence >= 4, low risk, no P1');
    const lane = waiting.length ? 'wait' : caution.length ? 'C' : automatic.length === 3 ? 'A' : 'B';
    return { pr: pr.number, head: pr.head.sha, lane,
        reasons: [...waiting, ...caution, ...automatic, ...notes, ...(lane === 'B' ? ['otherwise lane B: not all A conditions met'] : [])],
        facts: { title: pr.title, author: pr.user.login, createdAt: pr.created_at, labels, files,
            kritika, checks: checks.map(c => ({ name: c.name, status: c.status, conclusion: c.conclusion })),
            statuses: statuses.map(s => ({ context: s.context, state: s.state })),
            konflate: { head: entry?.headSha ?? null, status: entry?.status ?? null,
                signals: signals ?? null, impact: impact ?? null, namespacesNormalizedFromNull,
                warnings: rendered?.diff?.warnings ?? null } } };
}
async function inspect(pr, entries) {
    const errors = [];
    let files = [], fileCount = 0, statuses = [], checks = [], comments = [], rendered;
    try {
        const changed = api(`${ROOT}/pulls/${pr.number}/files?per_page=100`, true);
        fileCount = changed.length;
        files = changed.flatMap(f => f.previous_filename ? [f.filename, f.previous_filename] : [f.filename]);
        const statusPages = api(`${ROOT}/commits/${pr.head.sha}/status?per_page=100`, true);
        statuses = statusPages.flatMap(p => p.statuses);
        const checkPages = api(`${ROOT}/commits/${pr.head.sha}/check-runs?filter=latest&per_page=100`, true);
        checks = checkPages.flatMap(p => p.check_runs);
        comments = api(`${ROOT}/issues/${pr.number}/comments?per_page=100`, true);
    } catch (error) { errors.push(`GitHub evidence unavailable: ${error.message}`); }
    const entry = entries.find(p => p.number === pr.number);
    if (entry) {
        try { rendered = await konflate(`prs/${pr.number}/diff`); }
        catch (error) { errors.push(error.message); }
    }
    // Avoid returning an eligible result for a head that moved while evidence was gathered.
    try {
        const current = api(`${ROOT}/pulls/${pr.number}`);
        if (current.head.sha !== pr.head.sha || current.state !== 'open' || current.draft !== pr.draft ||
            current.title !== pr.title || current.user.login !== pr.user.login ||
            JSON.stringify(current.labels.map(l => l.name).sort()) !== JSON.stringify(pr.labels.map(l => l.name).sort()))
            errors.push('PR head/state/metadata changed during classification');
        if (!Number.isInteger(current.changed_files) || fileCount !== current.changed_files)
            errors.push('GitHub files incomplete');
    } catch (error) { errors.push(`cannot recheck current head: ${error.message}`); }
    return classify({ pr, files, statuses, checks, comments, entry, rendered, errors });
}
async function main() {
    const args = process.argv.slice(2), json = args.includes('--json');
    const targets = args.filter(a => a !== '--json');
    if (args.filter(a => a === '--json').length > 1 || targets.length !== 1 ||
        !(targets[0] === '--all' || /^[1-9]\d*$/.test(targets[0]))) throw Error('usage: pr-lane <N>|--all [--json]');
    let entries = [];
    try { entries = await konflate('prs'); if (!Array.isArray(entries)) entries = []; }
    catch { /* Missing konflate yields wait for every PR, never an eligible result. */ }
    const prs = targets[0] === '--all'
        ? api(`${ROOT}/pulls?state=open&sort=created&direction=asc&per_page=100`, true)
        : [api(`${ROOT}/pulls/${targets[0]}`)];
    prs.sort((a, b) => a.created_at.localeCompare(b.created_at) || a.number - b.number);
    const results = [];
    // Small bounded batches for read-only evidence gathering.
    for (let i = 0; i < prs.length; i += 4) results.push(...await Promise.all(prs.slice(i, i + 4).map(p => inspect(p, entries))));
    const value = targets[0] === '--all' ? results : results[0];
    if (json) console.log(JSON.stringify(value, null, 2));
    else for (const result of results) console.log(`#${result.pr} ${result.head} lane ${result.lane}\n  ${result.reasons.join('\n  ')}`);
}
module.exports = { classify, parseReview };
if (require.main === module) main().catch(error => { console.error(`pr-lane: ${error.message}`); process.exitCode = 1; });
