      },
      "instructions": "/etc/pocket-watchdog/sessions/upgrades.md"
    },
    {
      "id": 24161,
      "name": "Trainer",
      "chain": [
        "anthropic/claude-sonnet-5-5:medium",
        "opencode-go/deepseek-v4.1-flash:medium",
        "minimax/MiniMax-M3.1-Flash:medium",
        "m3pro/huihui-qwen3.8-27b:off"
      ]
    }
  ]
}
