{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Pi Pocket, Jan's assistant: a pocket user without sudo, Pi Pocket at a pinned release, its
# service, and tailscale serve publishing it over HTTPS on the tailnet only (phone push needs
# HTTPS), and the memini extension (switched on in Pi Pocket's config while the service is
# stopped). Model and memini keys come from ai-sync. Re-runs when any of it changes.
#   service {{ include ".system/pi-pocket.service" | sha256sum }}
#   mise    {{ include ".system/pi-pocket-mise.toml" | sha256sum }}
#   memini  {{ include ".system/pi-pocket-extensions/memini.ts" | sha256sum }}
set -eu
version=v0.11.0
commit=f93f2e4c772ff9fc8e615f167ea8390ad59ae948
src={{ joinPath .chezmoi.sourceDir ".system" | quote }}
home=/home/pocket
as_pocket() { sudo -u pocket -H "$@"; }

id pocket >/dev/null 2>&1 || sudo useradd --create-home --home-dir "$home" --shell /bin/bash pocket
sudo install -d -o pocket -g pocket -m 700 "$home/.config" "$home/.config/mise" "$home/.config/pi-pocket" "$home/work"
sudo install -m 644 -o pocket -g pocket "$src/pi-pocket-mise.toml" "$home/.config/mise/config.toml"
sudo test -e "$home/.config/pi-pocket/secrets.env" || sudo install -m 600 -o pocket -g pocket /dev/null "$home/.config/pi-pocket/secrets.env"

# The release, checked against its commit.
if ! sudo test -d "$home/pi-pocket/.git"; then
    as_pocket git clone --quiet https://github.com/TannerMidd/pi-pocket "$home/pi-pocket"
fi
as_pocket git -C "$home/pi-pocket" fetch --quiet --tags origin
as_pocket git -C "$home/pi-pocket" checkout --quiet --detach "$version"
test "$(as_pocket git -C "$home/pi-pocket" rev-parse HEAD)" = "$commit" || { echo "pi-pocket $version is not $commit" >&2; exit 1; }
as_pocket sh -c "cd '$home' && mise install --yes && cd pi-pocket && mise exec -- npm ci --ignore-scripts --no-audit --no-fund"

sudo install -m 644 "$src/pi-pocket.service" /etc/systemd/system/
sudo systemctl daemon-reload
sudo systemctl enable pi-pocket.service

# Drop-in extensions are off until the owner turns them on; config.json exists after the first start.
sudo systemctl stop pi-pocket.service
sudo install -d -o pocket -g pocket -m 700 "$home/.pi-pocket" "$home/.pi-pocket/extensions"
sudo install -m 644 -o pocket -g pocket "$src/pi-pocket-extensions/memini.ts" "$home/.pi-pocket/extensions/"
if sudo test -e "$home/.pi-pocket/config.json"; then
    as_pocket python3 -c '
import json, os, sys
path = sys.argv[1]
config = json.load(open(path))
on = config.setdefault("enabledExtensions", [])
if "memini.ts" not in on:
    on.append("memini.ts")
    tmp = path + ".tmp"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(config, f, indent=2)
    os.replace(tmp, path)
' "$home/.pi-pocket/config.json"
fi
sudo systemctl start pi-pocket.service
sudo tailscale serve --bg --https=443 http://127.0.0.1:8787
{{- end }}
