#!/bin/bash

set -eufo pipefail

{{ $brews := list
     "awscli"
     "aws-sso-cli"
     "eksctl"
     "fish"
     "granted"
     "saml2aws"
     "starship" -}}
{{ $casks := list
     "discord"
     "obsidian" -}}

brew bundle --file=/dev/stdin <<EOF
{{ range ($brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end -}}
{{ range ($casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end -}}
EOF
