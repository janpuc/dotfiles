{
  "toolActivation": "eager",
  "toolDescriptionMode": "compact",
  "disabledFeatures": [
    "agent-management",
    "watchdog",
    "missions",
    "lane-management",
    "spawn-budget-grants",
    "preflight",
    "lane-metadata",
    "gates",
    "usage-budgets",
    "tool-budgets",
    "control-overrides",
    "extension-bindings",
    "workflow-scripts"
  ],
  "missions": {
    "enabled": false
  },
  "timeoutMs": 7200000,
  "maxSubagentDepth": 1,
  "maxActiveAsyncRunsPerSession": 2,
  "globalConcurrencyLimit": 2,
  "parallel": {
    "maxTasks": 4,
    "concurrency": 2
  }
}
