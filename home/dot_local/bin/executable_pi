#!/usr/bin/env zsh
#
# Launcher for Pi (https://pi.dev): one agent dir, models, sessions and tools.
# Canonical cwd/repo resolution chooses only the memini memory scope: Work
# projects use work/*, elsewhere Personal never reads Work memory. Handshake
# conflicts refuse before Pi starts; PI_MEMINI=off disables memory.
# pi-profile reports the launch or handles the Personal Claude login/auth.
# The final exec preserves arguments, exit status and signals. Refusals exit 78.

emulate -L zsh
setopt extended_glob no_unset pipe_fail

readonly self=${0:A}
readonly invoked=${0:t}

readonly work_root=$HOME/Work
readonly dev_root=$HOME/Development
readonly personal_dir=$HOME/.pi/agent

warn() { print -ru2 -- "pi: $*" }
refuse() { print -ru2 -- "pi: $*"; exit 78 }

# APFS is case-insensitive, so compare folded paths on macOS.
fold() { [[ $OSTYPE == darwin* ]] && print -r -- ${1:l} || print -r -- $1 }
inside() { # inside PATH ROOT
  local p=$(fold $1) r=$(fold $2)
  [[ -n $p && -n $r && ( $p == $r || $p == $r/* ) ]]
}

# --- profile resolution -------------------------------------------------------

typeset -g profile reason repo_top= repo_owner= memini_prefix= memini_namespace=
typeset -ga why=()
resolve() {
  local logical=${PWD:-$(pwd)} physical=$(pwd -P)
  local work_canon=${work_root:A} dev_canon=${dev_root:A}
  local -a git_out

  # Work is sticky down a process tree: a Work session that shells out to pi
  # (from any directory) must not hand Work context to personal memory.
  [[ ${AI_PROFILE-} == work ]] && why+=(parent)
  { inside $logical $work_root || inside $physical $work_canon } && why+=(cwd)

  git_out=("${(@f)$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR \
    git -C $physical rev-parse --path-format=absolute --show-toplevel --git-common-dir 2>/dev/null)}")
  if (( ${#git_out} == 2 )); then
    repo_top=${git_out[1]:A}
    local common=${git_out[2]:A}
    # A linked worktree's common dir is the owning repo's .git, wherever the
    # worktree itself was checked out.
    [[ ${common:t} == .git ]] && repo_owner=${common:h} || repo_owner=$common
    { inside "$repo_top" "$work_canon" || inside "$repo_owner" "$work_canon" } && why+=(repo)
  fi

  (( ${#why} )) && profile=work || profile=personal
  reason=${(j:,:)why:-default}

  # Memory identity, recomputed here rather than inherited from fish. Same rules
  # as __memini_namespace_prefix.fish, keyed on the effective memory scope so an
  # inherited Work scope outside the tree still gets Work semantics. A server-side pin
  # still wins over both variables; check_memini below vets the result.
  if [[ $profile == work ]]; then
    if [[ -n $repo_top ]] || inside $logical $work_root || inside $physical $work_canon; then
      memini_prefix=work
    else
      memini_namespace=work/scratch
    fi
  elif inside $logical $dev_root || inside $physical $dev_canon; then
    memini_prefix=homelab
  elif [[ -z $repo_top ]]; then
    memini_namespace=homelab/scratch
  fi
}

# --- environment ----------------------------------------------------------------

# Keep subscription billing and clear enclosing Claude Code runtime markers.
readonly -a scrub_always=(
  ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_OAUTH_TOKEN ANTHROPIC_BASE_URL
  ANTHROPIC_CUSTOM_HEADERS ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL
  ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL
  ANTHROPIC_FEDERATION_RULE_ID ANTHROPIC_IDENTITY_TOKEN_FILE ANTHROPIC_ORGANIZATION_ID
  ANTHROPIC_SERVICE_ACCOUNT_ID ANTHROPIC_WORKSPACE_ID
  CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY
  CLAUDE_SECURESTORAGE_CONFIG_DIR
  OPENAI_API_KEY OPENAI_BASE_URL OPENAI_ORG_ID OPENAI_ORGANIZATION OPENAI_PROJECT
  PI_CODING_AGENT_SESSION_DIR
)
# Launched from somewhere other than fish (cron, another shell), the ai-sync
# cache has not been sourced. Import the shared subscription keys; never
# prompts, since the cache is the whole point of ai-sync.
import_cached_credentials() {
  local cache=${XDG_STATE_HOME:-$HOME/.local/state}/ai/credentials.fish name
  local -a names=(MEMINI_API_KEY LITELLM_API_KEY PI_OPENCODE_API_KEY PI_MINIMAX_API_KEY PI_OPENAI_API_KEY) missing=() pairs
  for name in $names; do [[ -z ${(P)name-} ]] && missing+=($name); done
  local fish=${commands[fish]:-/opt/homebrew/bin/fish}
  (( ${#missing} )) && [[ -r $cache && -x $fish ]] || return 0
  pairs=("${(@0)$($fish --no-config -c 'source $argv[1]; for n in $argv[2..]; set -q $n; and printf "%s=%s\0" $n $$n; end' \
    $cache $missing 2>/dev/null)}")
  local kv
  for kv in $pairs; do [[ $kv == *=* ]] && export "${kv%%=*}=${kv#*=}"; done
}

apply_environment() {
  local v
  for v in $scrub_always; do unset $v; done
  for v in CLAUDECODE CLAUDE_PID ${(k)parameters[(I)CLAUDE_CODE_*]}; do unset $v; done
  import_cached_credentials
  # ai-sync's subscription keys under the names Pi providers read.
  [[ -n ${PI_OPENCODE_API_KEY-} ]] && export OPENCODE_API_KEY=$PI_OPENCODE_API_KEY
  [[ -n ${PI_MINIMAX_API_KEY-} ]] && export MINIMAX_API_KEY=$PI_MINIMAX_API_KEY

  export AI_PROFILE=$profile
  export PI_CODING_AGENT_DIR=$personal_dir
  export CLAUDE_CONFIG_DIR=$personal_dir/claude
  mkdir -p -m 700 $personal_dir $CLAUDE_CONFIG_DIR

  export MEMINI_BASE_URL=${MEMINI_BASE_URL:-https://memini.janpuc.com}
  export MEMINI_HOME=${MEMINI_HOME:-personal/jan}
  unset MEMINI_NAMESPACE MEMINI_NAMESPACE_PREFIX
  [[ -n $memini_prefix ]] && export MEMINI_NAMESPACE_PREFIX=$memini_prefix
  [[ -n $memini_namespace ]] && export MEMINI_NAMESPACE=$memini_namespace
}

# --- memory scope gate ----------------------------------------------------------

# Ask memini which namespace and read set this session would get, with the same
# facts pi-memini sends, before Pi starts and anything is recalled or captured.
# Work must stay inside work/* (plus the personal home overlay, read-only by
# design); Personal must never see work/*. A conflicting pin or link stops the
# launch. Pins are never rewritten here.
typeset -g memini_state=unchecked memini_detail=

memory_off() { # memory_off REASON
  unset MEMINI_API_KEY
  # Unroutable endpoint: pi-memini degrades to no-ops and nothing leaves the host.
  export MEMINI_BASE_URL=http://127.0.0.1:9
  export MEMINI_RECALL=0 MEMINI_CAPTURE=0 MEMINI_CAPTURE_TURNS=0 MEMINI_SESSION_DIGEST=0 \
    MEMINI_AUTO_SAVE=0 MEMINI_INLINE_EXTRACT=0 MEMINI_INJECT_BRIEFING_PINNED=0 \
    MEMINI_INJECT_BRIEFING_FACTS=0 MEMINI_INJECT_BRIEFING_PROCEDURES=0 MEMINI_INJECT_BRIEFING_RECENT=0
  memini_state=off memini_detail=$1
}

check_memini() {
  if [[ ${PI_MEMINI-on} == off ]]; then memory_off "PI_MEMINI=off"; return; fi
  if [[ -z ${MEMINI_API_KEY-} ]]; then
    memory_off "MEMINI_API_KEY unset (run ai-sync)"; return
  fi
  if ! (( $+commands[curl] && $+commands[jq] )); then
    memory_off "curl/jq missing, scope not verified"; return
  fi

  local physical=$(pwd -P) remote= facts resp verdict
  [[ -n $repo_top ]] && remote=$(git -C $physical remote get-url origin 2>/dev/null)
  facts=$(jq -cn --arg cwd "${physical:t}" --arg remote "$remote" --arg top "$repo_top" \
    --arg ns "${MEMINI_NAMESPACE-}" --arg prefix "${MEMINI_NAMESPACE_PREFIX-}" --arg agent "${MEMINI_AGENT-}" '
    {project: ({cwd_basename: $cwd}
      + (if $remote != "" then {remote_url: $remote} else {} end)
      + (if $top != "" then {toplevel_path: $top, toplevel_basename: ($top | split("/") | last)} else {} end)
      + (if $agent != "" then {agent: $agent} else {} end)
      + (if $ns != "" then {env_namespace: $ns} else {} end)
      + (if $prefix != "" then {env_namespace_prefix: $prefix} else {} end)),
     client: {name: "pi-launcher"}}')
  # Header via stdin so the key never appears in the process list.
  resp=$(print -r -- "header = \"Authorization: Bearer $MEMINI_API_KEY\"" |
    curl -fsS -m 3 -K - -H "X-Memini-Home: $MEMINI_HOME" -H 'Content-Type: application/json' \
      --data-binary $facts "$MEMINI_BASE_URL/v1/handshake" 2>&1) || {
    memory_off "handshake failed: ${resp:0:120}"; return
  }
  verdict=$(print -r -- $resp | jq -r --arg profile "$profile" --arg home "$MEMINI_HOME" '
    def work: . == "work" or startswith("work/");
    . as $h
    | [ (if $profile == "work" then
          (if ($h.namespace | work) then empty else "namespace \($h.namespace) is outside work/*" end),
          ($h.read_set[]? | select((.namespace | work | not) and .namespace != $home)
            | "read set includes \(.namespace) (\(.origin))")
        else
          (if ($h.namespace | work) then "namespace \($h.namespace) is a Work namespace" else empty end),
          ($h.read_set[]? | select(.namespace | work) | "read set includes \(.namespace) (\(.origin))")
        end) ] as $bad
    | if ($bad | length) == 0 then "ok\t\($h.namespace) (\($h.namespace_source))"
      else "conflict\t\($bad | join("; ")); source \($h.namespace_source)\(if $h.pin then ", pin \($h.pin.key)" else "" end)" end' 2>/dev/null)
  case ${verdict%%$'\t'*} in
    ok) memini_state=ok memini_detail=${verdict#*$'\t'} ;;
    conflict)
      memini_state=conflict memini_detail=${verdict#*$'\t'} ;;
    *) memory_off "unparseable handshake reply" ;;
  esac
}

# --- Claude account and billing -------------------------------------------------------

# Personal login hint only; no Work account or organisation policy.
check_claude_account() {
  (( $+commands[jq] )) || return 0
  if ! jq -e '.oauthAccount.organizationUuid' $CLAUDE_CONFIG_DIR/.claude.json >/dev/null 2>&1; then
    warn "Claude (pi-claude-bridge) is not logged in; run once: pi-profile login"
  fi
}

# Project Claude settings apply to the bridge's Claude Code like any other session, and
# apiKeyHelper or ANTHROPIC_* there outrank the subscription login, silently switching
# to API billing or another endpoint. Refuse rather than run on someone else's meter.
check_project_claude_settings() {
  (( $+commands[jq] )) || return 0
  local dir f bad
  local -a dirs=("$(pwd -P)")
  [[ -n $repo_top ]] && dirs+=("$repo_top")
  for dir in ${(u)dirs}; do
    for f in $dir/.claude/settings.json $dir/.claude/settings.local.json; do
      [[ -f $f ]] || continue
      bad=$(jq -r '[ (if .apiKeyHelper then "apiKeyHelper" else empty end),
                     (.env // {} | keys[] | select(test("^(ANTHROPIC_|CLAUDE_CODE_USE_|CLAUDE_CODE_OAUTH_TOKEN$)"))) ] | join(", ")' $f 2>/dev/null)
      [[ -n $bad ]] && refuse "$f sets $bad, which would move pi-claude-bridge off the Personal subscription login"
    done
  done
  return 0
}

# --- real binary --------------------------------------------------------------------

find_real_pi() {
  local d f
  for d in $path; do
    f=$d/pi
    [[ -f $f && -x $f && ${f:A} != $self ]] && { print -r -- $f; return }
  done
  return 1
}


# --- main ---------------------------------------------------------------------------

sub=
for a in "$@"; do
  [[ $a == --personal-models ]] && refuse "Pi now uses personal models everywhere; Work only changes memory scope"
done
if [[ $invoked == pi-profile ]]; then
  while (( $# )); do
    case $1 in
      login|auth) sub=$1 ;;
      -h|--help) print "usage: pi-profile [login|auth]"; exit 0 ;;
      *) refuse "pi-profile: unknown argument $1" ;;
    esac
    shift
  done
fi

resolve
apply_environment

if [[ $invoked == pi-profile ]]; then
  case $sub in
    login)
      print -r -- "Logging Claude Code into the Personal account ($CLAUDE_CONFIG_DIR)."
      print -r -- "Pick the PERSONAL subscription on the consent page."
      exec claude auth login --claudeai ;;
    auth)
      print -r -- "== Personal: Claude Code (pi-claude-bridge)"
      claude auth status --json 2>&1 | jq '{loggedIn, authMethod, orgName, subscriptionType, configDirectory}' 2>/dev/null
      if real=$(find_real_pi); then
        print -r -- "== Personal: openai (ChatGPT subscription)"
        $real auth check --provider openai 2>&1
      fi
      exit 0 ;;
  esac
  check_memini
  print -r -- "profile=$profile"
  print -r -- "reason=$reason"
  print -r -- "agent_dir=$PI_CODING_AGENT_DIR"
  print -r -- "session_dir=${PI_CODING_AGENT_SESSION_DIR:-$PI_CODING_AGENT_DIR/sessions}"
  print -r -- "claude_config_dir=$CLAUDE_CONFIG_DIR"
  print -r -- "repo=${repo_top:-none}${repo_owner:+ (owner ${repo_owner})}"
  print -r -- "memini_namespace_prefix=${MEMINI_NAMESPACE_PREFIX-}"
  print -r -- "memini_namespace=${MEMINI_NAMESPACE-}"
  print -r -- "memini_home=$MEMINI_HOME"
  print -r -- "memini=$memini_state${memini_detail:+: $memini_detail}"
  [[ $memini_state == conflict ]] && exit 78
  exit 0
fi

# Subcommands and informational flags never read or capture memory.
case ${1-} in
  install|remove|uninstall|update|list|config|auth|mcp|-h|--help|-v|--version|--list-models|--list-models=*|--export) ;;
  *)
    check_memini
    case $memini_state in
      conflict)
        refuse "memini scope conflict for the $profile profile: $memini_detail.
  Nothing has been read or captured. Fix the pin for this project (in the right
  profile: /memini:namespace, or memini's pins API), or start without memory:
  PI_MEMINI=off $invoked ${(j: :)${(q-)@}}" ;;
      off) warn "memini off: $memini_detail — memory is not being recalled or saved" ;;
    esac
    check_claude_account
    check_project_claude_settings ;;
esac
export PI_MEMINI_STATE="$memini_state${memini_detail:+: $memini_detail}"

real=$(find_real_pi) || refuse "the pi binary is not on PATH
  macOS: brew install pi-coding-agent   elsewhere: npm install -g @earendil-works/pi-coding-agent"
exec $real "$@"
