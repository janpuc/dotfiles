{{ if eq .chezmoi.hostname "sisyphus" -}}
#!/bin/sh
# User-level host setup, safe for chezmoi update over SSH. The sudo steps are in 21-sisyphus-keepawake.
# Backup: {{ include ".system/sisyphus-backup" | sha256sum }}
# Hourly agent: {{ include "Library/LaunchAgents/local.sisyphus-backup.plist.tmpl" | sha256sum }}
# Watchdog: {{ include "Library/LaunchAgents/local.sisyphus-backup-watchdog.plist.tmpl" | sha256sum }}
# Digest: {{ include "Library/LaunchAgents/local.agent-digest.plist.tmpl" | sha256sum }}
# Mise: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
set -eu
umask 077
export PATH="/opt/homebrew/bin:$HOME/.local/share/mise/shims:/usr/bin:/bin:/usr/sbin:/sbin"
src={{ .chezmoi.sourceDir | quote }}
mkdir -p "$HOME/.local/bin" "$HOME/.ssh" "$HOME/.config/sisyphus-backup" "$HOME/.config/restic" \
    "$HOME/.local/state/sisyphus-backup" "$HOME/.local/state/agents"
chmod 700 "$HOME/.ssh" "$HOME/.config/sisyphus-backup" "$HOME/.config/restic" "$HOME/.local/state/sisyphus-backup"
mise install
install -m 755 "$src/.system/sisyphus-backup" "$HOME/.local/bin/sisyphus-backup"
[ -f "$HOME/.ssh/sisyphus-backup" ] || ssh-keygen -q -t ed25519 -N '' -C sisyphus-backup -f "$HOME/.ssh/sisyphus-backup"
[ -f "$HOME/.ssh/work-inbox" ] || ssh-keygen -q -t ed25519 -N '' -C sisyphus-work-inbox -f "$HOME/.ssh/work-inbox"
# Commit signing only. Register it on GitHub under Signing keys, never Authentication keys.
[ -f "$HOME/.ssh/sisyphus-sign" ] || ssh-keygen -q -t ed25519 -N '' -C sisyphus-sign -f "$HOME/.ssh/sisyphus-sign"
for label in local.sisyphus-backup local.sisyphus-backup-watchdog local.agent-digest; do
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/$label.plist"
done
printf '%s\n' 'Backup remains disabled until the NAS handoff, pinned known_hosts and enabled marker exist.'
{{ end -}}
