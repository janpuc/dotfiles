#!/usr/bin/env zsh
# Personal Pi profile (~/.pi/agent, the default agent dir; `pi` outside the
# Work tree). Managed keys only — see .chezmoitemplates/pi-merge-json.
#
# Opus is the stable startup default. Delegated models are chosen explicitly per type;
# usage remains visible but does not replace the collaborator. Packages are pinned;
# managed keys win while unrelated settings and manually added packages survive.
#
# Retries are bounded transient recovery, not permission to downgrade the collaborator.
# BC250 Qwen serves 128K (131072 tokens, up to 16384 output). Its overrides are set explicitly to
# Pi's defaults because the settings merge cannot delete the old 24K-era values from a live file.
set -euo pipefail
# Retired package base names and exact resource paths are removed on every merge.
retired='["pi-optchat", "pi-title-glyphs", "~/.pi/shared/extensions/subagent", "~/.pi/shared/prompts"]'
managed='{
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "enabledModels": ["claude-bridge/claude-opus-5-5", "openai/gpt-6.1-sol"],
  "retry": { "enabled": true, "maxRetries": 4 },
  "compaction": {
    "modelOverrides": {
      "litellm/bc250-local/qwen3.6-35b-a3b": { "reserveTokens": 16384, "keepRecentTokens": 20000 },
      "litellm/bc250/qwen3.6-35b-a3b": { "reserveTokens": 16384, "keepRecentTokens": 20000 }
    }
  },
  "packages": [
    "npm:pi-claude-bridge@0.9.2",
    { "source": "npm:@eleboucher/pi-memini@0.7.34", "extensions": [] },
    "npm:pi-web-access@0.37.0",
    "npm:pi-subagent-manager@0.19.0"
  ],
  "extensions": ["~/.pi/shared/extensions/profile", "~/.pi/shared/extensions/memory"],
  "prompts": [],
  "skills": ["~/.pi/shared/skills"]
}'
{{ template "pi-merge-json" }}
