{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# System files for the aether server: the hourly sync of home-ops' internal DNS names into
# /etc/hosts (the UniFi gateway does not answer DNS from the tailnet). Re-runs when they change.
#   script  {{ include ".system/aether-hosts-sync" | sha256sum }}
#   service {{ include ".system/aether-hosts-sync.service" | sha256sum }}
#   timer   {{ include ".system/aether-hosts-sync.timer" | sha256sum }}
set -eu
src={{ joinPath .chezmoi.sourceDir ".system" | quote }}
sudo install -m 755 "$src/aether-hosts-sync" /usr/local/sbin/aether-hosts-sync
sudo install -m 644 "$src/aether-hosts-sync.service" "$src/aether-hosts-sync.timer" /etc/systemd/system/
sudo systemctl daemon-reload
sudo systemctl enable --now aether-hosts-sync.timer
sudo systemctl start aether-hosts-sync.service
{{- end }}
