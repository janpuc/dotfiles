[Unit]
Description=Mint a GitHub App installation token for the pocket user's gh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pocket
Group=pocket
WorkingDirectory=/home/pocket
# mise's shims, so gh and jq are on PATH; the token goes into gh's own config, not the
# environment, because a running service cannot see new environment values.
Environment=PATH=/home/pocket/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/sbin/pi-pocket-gh-token
