#!/usr/bin/env zsh
#
# Install the packages Pi's settings.json pins (npm: into ~/.pi/agent/npm,
# or any manually retained git: packages into its git dir). Pi has one agent dir; Work
# projects differ only in their memini scope, chosen by the launcher.
# Pi installs missing pinned packages on first launch anyway; doing it here
# keeps that launch fast and surfaces failures at apply time. `pi update
# --extensions` skips pinned versions by design, hence `pi install`, which is
# idempotent. Runs again when the managed settings change:
#   {{ include "dot_pi/private_agent/modify_settings.json.tmpl" | sha256sum }}
#
# Mac only (see .chezmoiignore): Pi comes from Homebrew (packages.yaml).
# auth.json, sessions and other runtime state are never touched.

set -eufo pipefail

real_pi() {
  local d f launcher=${${:-$HOME/.local/bin/pi}:A}
  for d in $path; do
    f=$d/pi
    [[ -f $f && -x $f && ${f:A} != $launcher ]] && { print -r -- $f; return }
  done
  return 1
}

if ! pi_bin=$(real_pi); then
  print "Pi is not installed; skipping package setup (macOS: brew install pi-coding-agent; elsewhere: npm install -g @earendil-works/pi-coding-agent)"
  exit 0
fi

dir=$HOME/.pi/agent
[[ -f $dir/settings.json ]] || exit 0
for src in ${(f)"$(jq -r '.packages[]? | if type == "object" then .source else . end | select(startswith("npm:") or startswith("git:"))' $dir/settings.json)"}; do
  print "pi: $src"
  PI_CODING_AGENT_DIR=$dir $pi_bin install $src
done
