{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# apt packages for the aether server (packages.yaml → packages.linux.apt). Re-runs when the list changes.
# {{ .packages.linux.apt | toJson | sha256sum }}
set -eu
sudo apt-get update -qq
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends {{ .packages.linux.apt | join " " }}
# fish is the login shell, as on the laptop.
user=$(id -un)
[ "$(getent passwd "$user" | cut -d: -f7)" = /usr/bin/fish ] || sudo chsh -s /usr/bin/fish "$user"
{{- end }}
