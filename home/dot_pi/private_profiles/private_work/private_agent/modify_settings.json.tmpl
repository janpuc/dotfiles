#!/usr/bin/env zsh
# Work Pi profile (~/.pi/profiles/work/agent; `pi` under ~/Development/Work,
# or `piw`). Managed keys only — see .chezmoitemplates/pi-merge-json.
#
# Enterprise Claude seat only: every virtual model routes to claude-bridge, and
# the profile extension rejects any other provider for main turns, retries,
# compaction and extension calls. Pi's built-in MCP support is off so a
# trusted project .pi/mcp.json cannot add servers to Work sessions.
set -euo pipefail
managed='{
  "defaultProvider": "work",
  "defaultModel": "daily",
  "defaultThinkingLevel": "medium",
  "enabledModels": ["work/daily", "work/deep", "work/fast"],
  "retry": { "enabled": true, "maxRetries": 4 },
  "packages": ["npm:pi-claude-bridge@0.9.1", "npm:@eleboucher/pi-memini@0.7.34"],
  "extensions": ["~/.pi/shared/extensions/profile", "~/.pi/shared/extensions/subagent", "-builtin:mcp"],
  "prompts": ["~/.pi/shared/prompts"]
}'
{{ template "pi-merge-json" }}
