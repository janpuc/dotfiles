#!/usr/bin/env zsh

set -eufo pipefail

{{ $brews := list
     "awscli"
     "aws-sso-cli"
     "bat"
     "chezmoi"
     "dockutil"
     "eksctl"
     "fish"
     "granted"
     "saml2aws"
     "starship" -}}
{{ $casks := list
     "discord"
     "ghostty"
     "obsidian" -}}

/opt/homebrew/bin/brew bundle --file=/dev/stdin <<EOF
{{ range .packages.darwin.brews -}}
brew {{ . | sortAlpha | uniq | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | sortAlpha | uniq | quote }}
{{ end -}}
EOF
