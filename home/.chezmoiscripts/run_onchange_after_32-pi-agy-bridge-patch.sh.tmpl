{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# pi-agy-bridge 0.1.5 reads Neon's tool calls as JSON written in plain text, so code inside a JSON
# string needs a second layer of escaping that Neon often gets wrong (`\d`, `\$`, a raw newline).
# The patch in .chezmoitemplates repairs those invalid escapes after a failed parse, shows the text
# around a remaining JSON error and tells Neon how to escape code and shell ${...} in JavaScript.
# Pi installs a pinned npm package once and never rewrites it, so the patch holds until the pin
# moves. A new pin prints a warning: check whether upstream fixed this, then rebase or drop it.
# The native patch notes in Neon's answer when it tried agy's own refused tools, since Neon has
# then reported work that never ran.
# The mcp patch gives Neon pi's tools as native function calls: an MCP server "pi" inside the pi process, reached
# by agy over a Unix socket, and the agy turn stays open while pi runs the tool. Google advises against JSON tool
# calls written as text for Neon. The carrier agent allows only read_file (refused) and call_mcp_tool to server pi.
# patch {{ include ".chezmoitemplates/pi-agy-bridge-0.1.5.patch" | sha256sum }}
# native {{ include ".chezmoitemplates/pi-agy-bridge-0.1.5-native.patch" | sha256sum }}
# mcp {{ include ".chezmoitemplates/pi-agy-bridge-0.1.5-mcp.patch" | sha256sum }}
# settings {{ include "dot_pi/private_agent/modify_settings.json.tmpl" | sha256sum }}
set -eu
want=0.1.5
pkg="$HOME/.pi/agent/npm/node_modules/@timmyjl12/pi-agy-bridge"
pin=$(grep -o '"npm:@timmyjl12/pi-agy-bridge@[^"]*"' "$HOME/.pi/agent/settings.json" | sed 's/.*@\([^"]*\)"/\1/')
if [ "$pin" != "$want" ]; then
	echo "pi-agy-bridge: pinned $pin, the JSON repair patch is for $want and was not applied" >&2
	exit 0
fi
if [ ! -f "$pkg/package.json" ]; then
	echo "pi-agy-bridge: not installed yet, start Pi once and run chezmoi apply --force on this script" >&2
	exit 0
fi
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
cat > "$dir/1" <<'AGY_PATCH_EOF'
{{ include ".chezmoitemplates/pi-agy-bridge-0.1.5.patch" -}}
AGY_PATCH_EOF
cat > "$dir/2" <<'AGY_PATCH_EOF'
{{ include ".chezmoitemplates/pi-agy-bridge-0.1.5-native.patch" -}}
AGY_PATCH_EOF
cat > "$dir/3" <<'AGY_PATCH_EOF'
{{ include ".chezmoitemplates/pi-agy-bridge-0.1.5-mcp.patch" -}}
AGY_PATCH_EOF
cd "$pkg"
applied() { patch -p1 -R -f -s --dry-run < "$1" >/dev/null 2>&1; }
# The patches stack: a later one edits lines of an earlier one, whose own check then fails. So the top patch
# decides first, and every patch is tried dry before it touches a file, so a mismatch never leaves half a patch.
if applied "$dir/3"; then
	echo "pi-agy-bridge: all patches already applied"
	exit 0
fi
apply() {
	if applied "$2"; then
		echo "pi-agy-bridge: $1 patch already applied"
		return
	fi
	if ! patch -p1 -f -s --dry-run < "$2" >/dev/null 2>&1; then
		echo "pi-agy-bridge: the $1 patch does not apply to the installed package, nothing changed by it" >&2
		exit 1
	fi
	patch -p1 -f -s --no-backup-if-mismatch < "$2"
	echo "pi-agy-bridge: $1 patch applied, agent restart all loads it"
}
apply "JSON repair" "$dir/1"
apply native "$dir/2"
apply "native tools (MCP)" "$dir/3"
{{- end }}
