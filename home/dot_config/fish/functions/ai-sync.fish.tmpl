function ai-sync --description "Fetch AI credentials from 1Password into a local cache{{ if eq .chezmoi.os "linux" }}, and give Pi Pocket and pr-broker their keys{{ end }}"
    # The servers (aether, sisyphus) read 1Password through a read-only service account; its token
    # lives in ~/.config/op/<host>.env (0600), which is never managed or committed. The laptop
    # has no such file and asks the 1Password app.
    set -l sa_env "$HOME/.config/op/{{ .hostname }}.env"
    if not set -q OP_SERVICE_ACCOUNT_TOKEN; and test -r "$sa_env"
        # The file has comment lines; take the value of the one assignment. Function scope (-f):
        # a -l variable would end with this if block.
        set -fx OP_SERVICE_ACCOUNT_TOKEN (string match -rg '^\s*(?:export\s+)?OP_SERVICE_ACCOUNT_TOKEN=(.*)$' <"$sa_env" | string trim -c '"\'')[1]
    end
{{- if eq .chezmoi.os "darwin" }}

    # gh keeps this token in the macOS keychain, so neither gh nor git's `gh auth git-credential`
    # asks 1Password. Like the keys below, re-run after a rotation. The service account cannot
    # read the Private vault, so a server keeps the gh login it has.
    if set -q OP_SERVICE_ACCOUNT_TOKEN
        echo "  ! the service account cannot read op://Private; gh keeps its old token" >&2
    else if op read "op://Private/GitHub Personal Access Token/token" 2>/dev/null | command gh auth login --with-token 2>/dev/null
        echo "Logged gh into GitHub."
    else
        echo "  ! could not log gh in with op://Private/GitHub Personal Access Token/token; gh keeps its old token" >&2
    end
{{- end }}

    set -q XDG_STATE_HOME; or set -l XDG_STATE_HOME "$HOME/.local/state"
    set -l CRED_FILE "$XDG_STATE_HOME/ai/credentials.fish"
    set -l tmp (mktemp)

    # label -> op reference. Read once here so no 1Password prompt fires on
    # every shell start / agent launch; re-run this after a key rotation.
    #
    # The OpenCode Go and MiniMax subscription keys are cached under PI_* names:
    # their standard names (OPENCODE_API_KEY, MINIMAX_API_KEY) would switch those
    # providers on in every tool that reads them. The pi launcher maps them to the
    # standard names for Personal Pi processes only. PI_OPENAI_API_KEY (scoped to
    # the Decisions API) is read by Pi's auto router only and never mapped.
    # PI_NANOGPT_API_KEY is the NanoGPT subscription, mapped to NANOGPT_API_KEY by `pi-sec` only;
    # `pi-sec` maps PI_MINIMAX_API_KEY as well. PI_CLAUDE_CODE_OAUTH_TOKEN is the one-year
    # `claude setup-token` login, which the pi function gives pi-claude-bridge's Claude Code only,
    # so no machine needs its own Claude login.
    set -l NAMES MEMINI_API_KEY LITELLM_API_KEY PI_OPENCODE_API_KEY PI_MINIMAX_API_KEY PI_NANOGPT_API_KEY PI_OPENAI_API_KEY PI_POCKET_TOKEN PI_CLAUDE_CODE_OAUTH_TOKEN
    set -l PATHS "op://Kubernetes/memini/MEMINI_API_KEY_jan" "op://Kubernetes/litellm/LITELLM_MASTER_KEY" "op://Kubernetes/opencode/OPENCODE_GO_API_KEY" "op://Kubernetes/minimax/MINIMAX_API_KEY" "op://Kubernetes/nanogpt/NANOGPT_API_KEY" "op://Kubernetes/openai/OPENAI_API_KEY" "op://Kubernetes/pi-pocket/LAPTOP_TOKEN" "op://Kubernetes/claude/CLAUDE_CODE_OAUTH_TOKEN"

    echo "# Generated by ai-sync — do not edit, do not commit." >"$tmp"

    for i in (seq (count $NAMES))
        set -l name $NAMES[$i]
        set -l ref $PATHS[$i]
        echo "Fetching $name from 1Password..."
        set -l value (op read "$ref" 2>/dev/null)
        if test -z "$value"
            echo "  ! could not read $ref — skipping" >&2
            continue
        end
        printf 'set -gx %s %s\n' $name (string escape -- "$value") >>"$tmp"
        set -gx $name "$value"
    end

    if test (count (string match -r '^set ' <"$tmp")) -eq 0
        echo "Error: nothing fetched — is `op` signed in?" >&2
        rm -f "$tmp"
        return 1
    end

    mkdir -p (dirname "$CRED_FILE")
    mv "$tmp" "$CRED_FILE"
    chmod 600 "$CRED_FILE"
    echo "Wrote $CRED_FILE (0600) and exported into this shell."
{{- if eq .chezmoi.os "linux" }}

    # The separate merger App never reaches pocket. Missing item is expected before Step 2
    # provisioning: warn and retain existing credentials, without failing the rest of ai-sync.
    if id pr-broker >/dev/null 2>&1
        set -l merger_key (mktemp)
        set -l merger_client (mktemp)
        chmod 600 $merger_key $merger_client
        if op read "op://Kubernetes/janpuc-merger/MERGER_APP_PRIVATE_KEY" >$merger_key 2>/dev/null; and test -s $merger_key; and op read "op://Kubernetes/janpuc-merger/MERGER_APP_CLIENT_ID" >$merger_client 2>/dev/null; and test -s $merger_client
            sudo install -d -o root -g root -m 755 /etc/pr-broker
            sudo install -o root -g pr-broker -m 640 $merger_key /etc/pr-broker/merger.pem
            sudo install -o root -g pr-broker -m 640 $merger_client /etc/pr-broker/client-id
            echo "Gave pr-broker its separate merger App credentials. Merge switches unchanged."
        else
            echo "  ! could not read op://Kubernetes/janpuc-merger MERGER_APP_PRIVATE_KEY / MERGER_APP_CLIENT_ID; broker credentials unchanged" >&2
        end
        rm -f $merger_key $merger_client
    else
        echo "  ! pr-broker not installed; skipping merger App credentials" >&2
    end

    # Pi Pocket's model, memini and Home Assistant keys, for the pocket user only: a 0600 file its mise config loads into
    # the service. The 1Password token itself never reaches pocket.
    id pocket >/dev/null 2>&1; or return 0
    set -l NAMES OPENCODE_API_KEY MINIMAX_API_KEY ANTHROPIC_API_KEY MEMINI_API_KEY HA_TOKEN
    set -l PATHS op://Kubernetes/opencode/OPENCODE_GO_API_KEY op://Kubernetes/minimax/MINIMAX_API_KEY op://Kubernetes/claude/CLAUDE_API_KEY op://Kubernetes/memini/MEMINI_API_KEY_jan op://Kubernetes/hass-mcp/HASS_MCP_TOKEN
    set -l tmp (mktemp)
    chmod 600 $tmp
    for i in (seq (count $NAMES))
        set -l value (op read $PATHS[$i] 2>/dev/null)
        if test -z "$value"
            echo "  ! could not read $PATHS[$i]" >&2
            rm -f $tmp
            return 1
        end
        printf '%s=%s\n' $NAMES[$i] $value >>$tmp
    end
    sudo -u pocket -H sh -c 'umask 077; cat > "$1"; chmod 600 "$1"' sh /home/pocket/.config/pi-pocket/secrets.env <$tmp
    rm -f $tmp

    # The agent's own GitHub App (janpuc-agent, only home-ops, dotfiles and BC250, no admin or
    # workflow rights): its key and client id for pocket. The token helper mints installation
    # tokens from them and writes them into gh's own config.
    set -l key_tmp (mktemp)
    set -l id_tmp (mktemp)
    chmod 600 $key_tmp $id_tmp
    if op read "op://Kubernetes/janpuc-agent/AGENT_APP_PRIVATE_KEY" >$key_tmp 2>/dev/null; and test -s $key_tmp
        sudo -u pocket -H sh -c 'umask 077; cat > "$1"; chmod 600 "$1"' sh /home/pocket/.config/pi-pocket/github-app.pem <$key_tmp
    else
        echo "  ! could not read op://Kubernetes/janpuc-agent/AGENT_APP_PRIVATE_KEY" >&2
    end
    if op read "op://Kubernetes/janpuc-agent/AGENT_APP_CLIENT_ID" >$id_tmp 2>/dev/null; and test -s $id_tmp
        sudo -u pocket -H sh -c 'umask 077; cat > "$1"; chmod 600 "$1"' sh /home/pocket/.config/pi-pocket/github-app-client-id <$id_tmp
    else
        echo "  ! could not read op://Kubernetes/janpuc-agent/AGENT_APP_CLIENT_ID" >&2
    end
    rm -f $key_tmp $id_tmp

    # Mint the first installation token now, so gh works without waiting for the timer.
    if test -x /usr/local/sbin/pi-pocket-gh-token
        sudo -u pocket -H /usr/local/sbin/pi-pocket-gh-token || true
    end

    sudo systemctl try-restart pi-pocket.service
    echo "Gave Pi Pocket its model keys ($NAMES) and the GitHub App key."
{{- end }}
end
