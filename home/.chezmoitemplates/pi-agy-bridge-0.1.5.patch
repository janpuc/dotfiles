+/** The body around the parse error's position, so the model sees where its JSON went wrong, not only how it began. */
+function errorExcerpt(body: string, message: string): string {
+	const match = /position (\d+)/.exec(message);
+	if (!match) return body.slice(0, MAX_ERROR_BODY);
+	const at = Number(match[1]) + (body.length - body.trimStart().length);
+	const from = Math.max(0, at - MAX_ERROR_BODY / 2);
+	const before = body.slice(from, at);
+	const after = body.slice(at, at + MAX_ERROR_BODY / 2);
+	return `${from > 0 ? "[...]" : ""}${before}<<HERE>>${after}`;
+}
