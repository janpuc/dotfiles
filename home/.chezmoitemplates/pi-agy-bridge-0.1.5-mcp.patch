diff --git a/src/acp/mcp-host.ts b/src/acp/mcp-host.ts
new file mode 100644
--- /dev/null
+++ b/src/acp/mcp-host.ts
@@ -0,0 +1,256 @@
+// The MCP server "pi", hosted inside the pi process and reached by agy through mcp-relay.mjs over a Unix socket.
+//
+// Google's Gemini 4 Neon notes say not to make the model write tool calls as JSON text with no declared tools
+// (aistudio.google.com/docs/whats-new-gemini-4-neon). Listing pi's tools here makes them native function calls:
+// agy calls `call_mcp_tool` with ServerName "pi", the call arrives as `tools/call`, and stream.ts hands it to pi as
+// an ordinary tool call. The MCP request stays open while pi runs the tool, so the model's turn continues with the
+// real result. agy reads the tool list once when it starts (a later `tools/list_changed` does not reach new
+// sessions, measured on agy 1.5.14), so the pool restarts agy when a request needs tools it does not list yet.
+//
+// Each agy process gets its own token (PI_AGY_MCP_TOKEN). The relay sends it as the first line, a connection without
+// a known token is closed, and a call reaches a turn only through the token of the process that runs that turn.
+
+import { randomBytes } from "node:crypto";
+import { chmodSync, lstatSync, mkdirSync, rmSync } from "node:fs";
+import net from "node:net";
+import path from "node:path";
+import { safeJson, type ToolDef } from "../tool-protocol.ts";
+
+/** MCP content for a tool result. */
+export type McpContent = { type: "text"; text: string } | { type: "image"; data: string; mimeType: string };
+
+export interface HostedCall {
+	/** agy's conversation id, the same string as the ACP session id. */
+	conversationId: string;
+	name: string;
+	arguments: Record<string, unknown>;
+	/** Answer the MCP request. Only the first answer counts. */
+	respond(content: McpContent[], isError: boolean): void;
+	/** False once agy's relay for this call disconnected: nobody waits for the answer, so pi must not run it. */
+	alive(): boolean;
+}
+
+export const MCP_SERVER_NAME = "pi";
+const CONVERSATION_KEY = "antigravity.google/conversation_id";
+/** Buffered input above this many characters closes the connection, checked before any frame in it is handled.
+ *  Tool calls carry file contents, so it is generous. */
+const MAX_FRAME = 64 * 1024 * 1024;
+
+interface Connection {
+	socket: net.Socket;
+	buffer: string;
+	/** The agy process token, set by the first line. */
+	token: string | undefined;
+	open: boolean;
+}
+
+interface Route {
+	token: string;
+	handler: (call: HostedCall) => void;
+}
+
+export class McpHost {
+	#server: net.Server | undefined;
+	#socketPath: string | undefined;
+	#tools: ToolDef[] = [];
+	#keys = new Map<string, string>();
+	readonly #connections = new Set<Connection>();
+	readonly #routes = new Map<string, Route>();
+	/** Token -> the tool catalogue its agy process listed at start-up. */
+	readonly #tokens = new Map<string, { tools: ToolDef[]; keys: Map<string, string> }>();
+	#exitHook: (() => void) | undefined;
+	readonly #log: ((message: string) => void) | undefined;
+
+	constructor(log?: (message: string) => void) {
+		this.#log = log;
+	}
+
+	/** Listen on `<dir>/<pid>-<random>.sock` once, a fresh path per host so a recycled runtime in the same pi
+	 *  process never shares one. Returns the socket path for PI_AGY_MCP_SOCKET. */
+	async start(dir: string): Promise<string> {
+		if (this.#socketPath) return this.#socketPath;
+		mkdirSync(dir, { recursive: true, mode: 0o700 });
+		if (!lstatSync(dir).isDirectory()) throw new Error(`pi-agy-bridge: ${dir} is not a directory`);
+		chmodSync(dir, 0o700);
+		const socketPath = path.join(dir, `${process.pid}-${randomBytes(4).toString("hex")}.sock`);
+		rmSync(socketPath, { force: true });
+		const server = net.createServer((socket) => this.#accept(socket));
+		await new Promise<void>((resolve, reject) => {
+			server.once("error", reject);
+			server.listen(socketPath, () => {
+				server.off("error", reject);
+				resolve();
+			});
+		});
+		server.unref();
+		this.#exitHook = () => rmSync(socketPath, { force: true });
+		process.once("exit", this.#exitHook);
+		this.#server = server;
+		this.#socketPath = socketPath;
+		return socketPath;
+	}
+
+	/** A new token for one agy process (PI_AGY_MCP_TOKEN). The process lists the catalogue as it is now. */
+	issueToken(): string {
+		const token = randomBytes(24).toString("hex");
+		this.#tokens.set(token, { tools: [...this.#tools], keys: new Map(this.#keys) });
+		return token;
+	}
+
+	/** Forget a token: its process is gone. Its open connections close. */
+	revokeToken(token: string): void {
+		this.#tokens.delete(token);
+		for (const connection of this.#connections) if (connection.token === token) connection.socket.destroy();
+	}
+
+	/** Tools of `tools` whose description differs from what the agy process with `token` listed at start-up. */
+	changedDescriptions(token: string, tools: readonly ToolDef[]): ToolDef[] {
+		const listed = new Map((this.#tokens.get(token)?.tools ?? []).map((tool) => [tool.name, tool.description ?? ""]));
+		return tools.filter((tool) => listed.has(tool.name) && listed.get(tool.name) !== (tool.description ?? ""));
+	}
+
+	/** True when the agy process with `token` lists every tool of `tools` with the same definition. */
+	covers(token: string, tools: readonly ToolDef[]): boolean {
+		const keys = this.#tokens.get(token)?.keys;
+		return keys !== undefined && tools.every((tool) => keys.get(tool.name) === toolKey(tool));
+	}
+
+	/** The tools the next agy process lists. Keeps every tool listed so far, so requests that need fewer tools (a
+	 *  compaction summary, a side call) never force a restart. */
+	advertise(tools: readonly ToolDef[]): void {
+		const merged = new Map(this.#tools.map((tool) => [tool.name, tool]));
+		for (const tool of tools) merged.set(tool.name, tool);
+		this.#tools = [...merged.values()];
+		this.#keys = new Map(this.#tools.map((tool) => [tool.name, toolKey(tool)]));
+	}
+
+	/** Send this ACP session's MCP calls, arriving from the agy process with `token`, to `handler` until the
+	 *  returned function is called. */
+	route(conversationId: string, token: string, handler: (call: HostedCall) => void): () => void {
+		const route = { token, handler };
+		this.#routes.set(conversationId, route);
+		return () => {
+			if (this.#routes.get(conversationId) === route) this.#routes.delete(conversationId);
+		};
+	}
+
+	close(): void {
+		for (const connection of this.#connections) connection.socket.destroy();
+		this.#connections.clear();
+		this.#tokens.clear();
+		this.#routes.clear();
+		this.#server?.close();
+		if (this.#exitHook) process.off("exit", this.#exitHook);
+		this.#exitHook = undefined;
+		if (this.#socketPath) rmSync(this.#socketPath, { force: true });
+		this.#server = undefined;
+		this.#socketPath = undefined;
+	}
+
+	#accept(socket: net.Socket): void {
+		const connection: Connection = { socket, buffer: "", token: undefined, open: true };
+		this.#connections.add(connection);
+		socket.setEncoding("utf8");
+		socket.on("data", (chunk: string) => {
+			connection.buffer += chunk;
+			if (connection.buffer.length > MAX_FRAME) {
+				this.#log?.("mcp: frame above the size limit, connection closed");
+				socket.destroy();
+				return;
+			}
+			let newline: number;
+			while ((newline = connection.buffer.indexOf("\n")) >= 0) {
+				const line = connection.buffer.slice(0, newline).trim();
+				connection.buffer = connection.buffer.slice(newline + 1);
+				if (!line) continue;
+				if (connection.token === undefined) {
+					if (!this.#tokens.has(line)) {
+						this.#log?.("mcp: connection without a known token closed");
+						socket.destroy();
+						return;
+					}
+					connection.token = line;
+					continue;
+				}
+				try {
+					this.#handle(connection, line);
+				} catch (error) {
+					this.#log?.(`mcp: frame failed: ${error instanceof Error ? error.message : String(error)}`);
+				}
+			}
+		});
+		socket.on("error", () => undefined);
+		socket.on("close", () => {
+			connection.open = false;
+			this.#connections.delete(connection);
+		});
+	}
+
+	#send(connection: Connection, message: unknown): void {
+		if (!connection.socket.destroyed) connection.socket.write(`${JSON.stringify(message)}\n`);
+	}
+
+	#handle(connection: Connection, line: string): void {
+		let message: unknown;
+		try {
+			message = JSON.parse(line);
+		} catch {
+			return;
+		}
+		if (!message || typeof message !== "object" || Array.isArray(message)) return;
+		const { id, method, params } = message as { id?: unknown; method?: unknown; params?: any };
+		if (id === undefined || typeof method !== "string") return; // notifications
+		const reply = (result: unknown): void => this.#send(connection, { jsonrpc: "2.0", id, result });
+		switch (method) {
+			case "initialize":
+				reply({
+					protocolVersion: typeof params?.protocolVersion === "string" ? params.protocolVersion : "2025-06-18",
+					capabilities: { tools: {} },
+					serverInfo: { name: MCP_SERVER_NAME, version: "0.1.5-native" },
+				});
+				return;
+			case "tools/list":
+				reply({ tools: (this.#tokens.get(connection.token ?? "")?.tools ?? []).map(mcpTool) });
+				return;
+			case "tools/call":
+				this.#call(connection, params, reply);
+				return;
+			default:
+				reply({});
+		}
+	}
+
+	#call(connection: Connection, params: any, reply: (result: unknown) => void): void {
+		let answered = false;
+		const respond = (content: McpContent[], isError: boolean): void => {
+			if (answered) return;
+			answered = true;
+			reply({ content: content.length > 0 ? content : [{ type: "text", text: "(no output)" }], isError });
+		};
+		if (connection.socket.destroyed) return;
+		const conversationId = params?._meta?.[CONVERSATION_KEY];
+		const name = typeof params?.name === "string" ? params.name : "";
+		const args = params?.arguments && typeof params.arguments === "object" && !Array.isArray(params.arguments) ? params.arguments : {};
+		const route = typeof conversationId === "string" ? this.#routes.get(conversationId) : undefined;
+		const handler = route && route.token === connection.token ? route.handler : undefined;
+		if (!handler) {
+			this.#log?.(`mcp: call ${name} for conversation ${String(conversationId)} has no waiting pi turn`);
+			respond([{ type: "text", text: "pi-agy-bridge: no pi turn is waiting for this call, so it did not run." }], true);
+			return;
+		}
+		handler({ conversationId, name, arguments: args, respond, alive: () => !connection.socket.destroyed && connection.open });
+	}
+}
+
+/** What forces a new agy: a name or schema it does not list. A changed description alone does not, since some pi
+ *  tools (codemode) describe the current tool set and would otherwise restart agy on every change. */
+function toolKey(tool: ToolDef): string {
+	return safeJson(tool.parameters ?? {});
+}
+
+function mcpTool(tool: ToolDef): { name: string; description: string; inputSchema: Record<string, unknown> } {
+	const schema = JSON.parse(safeJson(tool.parameters ?? {})) as Record<string, unknown>;
+	const inputSchema = schema && typeof schema === "object" && !Array.isArray(schema) ? schema : {};
+	if (inputSchema.type === undefined) inputSchema.type = "object";
+	return { name: tool.name, description: tool.description ?? "", inputSchema };
+}
diff --git a/src/acp/mcp-relay.mjs b/src/acp/mcp-relay.mjs
new file mode 100644
--- /dev/null
+++ b/src/acp/mcp-relay.mjs
@@ -0,0 +1,42 @@
+// MCP server "pi" as agy starts it from mcp_config.json: a byte pipe between agy's stdio and the Unix socket of the
+// pi process that started this agy (PI_AGY_MCP_SOCKET), opened with that agy's token (PI_AGY_MCP_TOKEN). The MCP server itself runs inside that pi process
+// (mcp-host.ts), so pi's tools reach the model as native function calls and pi still runs every one of them.
+// Plain JavaScript on purpose: agy runs it with the node that runs pi, outside any type stripping.
+// Without the variable (an agy started by something else) it answers as a server with no tools.
+
+import net from "node:net";
+import { createInterface } from "node:readline";
+
+const socketPath = process.env.PI_AGY_MCP_SOCKET;
+
+if (socketPath) {
+	const socket = net.connect(socketPath);
+	socket.write(`${process.env.PI_AGY_MCP_TOKEN ?? ""}\n`);
+	socket.on("error", () => process.exit(1));
+	socket.on("close", () => process.exit(0));
+	process.stdin.pipe(socket);
+	socket.pipe(process.stdout);
+	process.stdin.on("end", () => socket.end());
+} else {
+	const send = (message) => process.stdout.write(`${JSON.stringify(message)}\n`);
+	createInterface({ input: process.stdin }).on("line", (line) => {
+		let message;
+		try {
+			message = JSON.parse(line);
+		} catch {
+			return;
+		}
+		if (message.id === undefined || typeof message.method !== "string") return;
+		if (message.method === "initialize") {
+			send({
+				jsonrpc: "2.0",
+				id: message.id,
+				result: { protocolVersion: message.params?.protocolVersion ?? "2025-06-18", capabilities: { tools: {} }, serverInfo: { name: "pi", version: "0" } },
+			});
+		} else if (message.method === "tools/list") {
+			send({ jsonrpc: "2.0", id: message.id, result: { tools: [] } });
+		} else {
+			send({ jsonrpc: "2.0", id: message.id, result: {} });
+		}
+	});
+}
