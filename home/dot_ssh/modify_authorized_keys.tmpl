#!/usr/bin/env python3
# Preserve operator keys and manage only the restricted work inbox identity on aether.
import base64
import ipaddress
import json
import re
import sys

text = sys.stdin.read()
{{ if eq .chezmoi.hostname "aether" -}}
key = json.loads({{ .workInbox.publicKey | toJson | toJson }})
address = json.loads({{ .workInbox.sourceAddress | toJson | toJson }})
if key:
    if not re.fullmatch(r"ssh-ed25519 [A-Za-z0-9+/=]+(?: [^\r\n]+)?", key):
        raise ValueError("workInbox.publicKey must be an ed25519 public key")
    blob = base64.b64decode(key.split()[1], validate=True)
    if len(blob) != 51 or blob[:19] != b"\x00\x00\x00\x0bssh-ed25519\x00\x00\x00\x20":
        raise ValueError("workInbox.publicKey must contain a valid ed25519 key blob")
    address = str(ipaddress.IPv4Address(address))
    lines = [line for line in text.splitlines() if not line.endswith(" agents-work-inbox")]
    options = ('command="/home/ubuntu/.local/bin/agent-run --remote-inbox",'
               'no-pty,no-port-forwarding,no-agent-forwarding,no-X11-forwarding,no-user-rc,'
               f'from="{address}"')
    lines.append(options + " " + " ".join(key.split()[:2]) + " agents-work-inbox")
    text = "\n".join(lines) + ("\n" if lines else "")
{{ end -}}
sys.stdout.write(text)
